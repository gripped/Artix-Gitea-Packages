post_install() {
    cat <<'EOF'
>>> KDE Plasma users: NVIDIA 580xx has a known fd leak that can crash
>>> plasmashell. To apply the workaround, run:
>>>
>>>   mkdir -p ~/.config/plasma-workspace/env
>>>   cp /usr/share/doc/nvidia/egl-wayland2.sh.example ~/.config/plasma-workspace/env/egl-wayland2.sh
>>>
>>> Other desktops: no action needed.
>>> Details: https://github.com/NVIDIA/egl-wayland/issues/196
EOF
}

post_upgrade() {
    post_install
}
