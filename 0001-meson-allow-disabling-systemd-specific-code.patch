From 220cbea724d0bd0406ff4e480dea792546bfb5a3 Mon Sep 17 00:00:00 2001
From: Dudemanguy <random342@airmail.cc>
Date: Tue, 23 Sep 2025 10:19:59 -0500
Subject: [PATCH] meson: allow disabling systemd specific code

---
 data/meson.build            | 68 +++++++++++++++++++++----------------
 gnome-session/gsm-manager.c | 26 ++++++++++----
 gnome-session/gsm-system.c  |  2 +-
 gnome-session/meson.build   |  5 ++-
 meson.build                 |  5 +--
 meson_options.txt           |  1 +
 tools/meson.build           |  5 ++-
 7 files changed, 71 insertions(+), 41 deletions(-)

diff --git a/data/meson.build b/data/meson.build
index 76b15e92..2a534202 100644
--- a/data/meson.build
+++ b/data/meson.build
@@ -62,10 +62,12 @@ endif
 
 # Next, let's install the necessary systemd scaffolding
 
-install_data(
-    'gnome.session.conf',
-    install_dir: systemd_userunitdir / 'gnome-session@gnome.target.d',
-)
+if systemd_userunitdir != ''
+  install_data(
+      'gnome.session.conf',
+      install_dir: systemd_userunitdir / 'gnome-session@gnome.target.d',
+  )
+endif
 
 systemd_service = [
   'gnome-session-manager@.service',
@@ -74,17 +76,19 @@ systemd_service = [
   'gnome-session-monitor.service',
 ]
 
-foreach service: systemd_service
-  configure_file(
-    input: service + '.in',
-    output: service,
-    install: true,
-    install_dir: systemd_userunitdir,
-    configuration: {
-      'libexecdir': session_libexecdir,
-    },
-  )
-endforeach
+if systemd_userunitdir != ''
+  foreach service: systemd_service
+    configure_file(
+      input: service + '.in',
+      output: service,
+      install: true,
+      install_dir: systemd_userunitdir,
+      configuration: {
+        'libexecdir': session_libexecdir,
+      },
+    )
+  endforeach
+endif
 
 systemd_target = [
   'gnome-session-wayland@.target',
@@ -106,25 +110,31 @@ if have_x11
   ]
 endif
 
-install_data(
-  systemd_target,
-  install_dir: systemd_userunitdir
-)
+if systemd_userunitdir != ''
+  install_data(
+    systemd_target,
+    install_dir: systemd_userunitdir
+  )
+endif
 
 # Install resource limits that are applied to GNOME-launched apps
 
-install_data(
-  'app-override.scope.conf',
-  rename: 'override.conf',
-  install_dir : join_paths(systemd_userunitdir, 'app-gnome-.scope.d')
-)
+if systemd_userunitdir != ''
+  install_data(
+    'app-override.scope.conf',
+    rename: 'override.conf',
+    install_dir : join_paths(systemd_userunitdir, 'app-gnome-.scope.d')
+  )
+endif
 
 # FIXME: https://github.com/systemd/systemd/issues/37104
-install_data(
-  'app-override.scope.conf',
-  rename: 'override.conf',
-  install_dir : join_paths(systemd_userunitdir, 'app-flatpak-.scope.d')
-)
+if systemd_userunitdir != ''
+  install_data(
+    'app-override.scope.conf',
+    rename: 'override.conf',
+    install_dir : join_paths(systemd_userunitdir, 'app-flatpak-.scope.d')
+  )
+endif
 
 # Install some other misc. configuration files
 
diff --git a/gnome-session/gsm-manager.c b/gnome-session/gsm-manager.c
index b7f1788e..a90f1acc 100644
--- a/gnome-session/gsm-manager.c
+++ b/gnome-session/gsm-manager.c
@@ -40,9 +40,10 @@
 #include "gsm-manager.h"
 #include "org.gnome.SessionManager.h"
 
+#if HAVE_SYSTEMD
 #include <systemd/sd-journal.h>
-
 #include <systemd/sd-daemon.h>
+#endif
 
 #include "gsm-app.h"
 #include "gsm-client.h"
@@ -755,6 +756,15 @@ update_idle (GsmManager *manager)
         }
 }
 
+static void
+sd_notify_wrapper (guint      unset_environment,
+                   const char *state)
+{
+#if HAVE_SYSTEMD
+        sd_notify(unset_environment, state);
+#endif
+}
+
 static void
 start_phase (GsmManager *manager)
 {
@@ -769,19 +779,21 @@ start_phase (GsmManager *manager)
 
         switch (manager->phase) {
         case GSM_MANAGER_PHASE_INITIALIZATION:
-                sd_notify (0, "READY=1\nSTATUS=Waiting for session to start");
+                sd_notify_wrapper (0, "READY=1\nSTATUS=Waiting for session to start");
                 break;
         case GSM_MANAGER_PHASE_APPLICATION:
-                sd_notify (0, "STATUS=Starting applications");
+                sd_notify_wrapper (0, "STATUS=Starting applications");
                 gsm_exported_manager_emit_session_running (manager->skeleton);
                 do_phase_startup (manager);
                 break;
         case GSM_MANAGER_PHASE_RUNNING:
-                sd_notify (0, "STATUS=Running");
+                sd_notify_wrapper (0, "STATUS=Running");
+#if HAVE_SYSTEMD
                 sd_journal_send ("MESSAGE_ID=%s", GSM_MANAGER_STARTUP_SUCCEEDED_MSGID,
                                  "PRIORITY=%d", 5,
                                  "MESSAGE=Entering running state",
                                  NULL);
+#endif
                 if (manager->pending_end_session_tasks != NULL)
                         complete_end_session_tasks (manager);
                 g_object_unref (manager->end_session_cancellable);
@@ -789,16 +801,16 @@ start_phase (GsmManager *manager)
                 update_idle (manager);
                 break;
         case GSM_MANAGER_PHASE_QUERY_END_SESSION:
-                sd_notify (0, "STATUS=Querying end of session");
+                sd_notify_wrapper (0, "STATUS=Querying end of session");
                 do_phase_query_end_session (manager);
                 break;
         case GSM_MANAGER_PHASE_END_SESSION:
-                sd_notify (0, "STOPPING=1\nSTATUS=Logging out");
+                sd_notify_wrapper (0, "STOPPING=1\nSTATUS=Logging out");
                 gsm_exported_manager_emit_session_over (manager->skeleton);
                 do_phase_end_session (manager);
                 break;
         case GSM_MANAGER_PHASE_EXIT:
-                sd_notify (0, "STOPPING=1\nSTATUS=Quitting");
+                sd_notify_wrapper (0, "STOPPING=1\nSTATUS=Quitting");
                 do_phase_exit (manager);
                 break;
         default:
diff --git a/gnome-session/gsm-system.c b/gnome-session/gsm-system.c
index dc49a1af..8cf525d2 100644
--- a/gnome-session/gsm-system.c
+++ b/gnome-session/gsm-system.c
@@ -246,7 +246,7 @@ gsm_get_system (void)
         static GsmSystem *system = NULL;
 
         if (system == NULL) {
-                system = GSM_SYSTEM (gsm_systemd_new ());
+                //system = GSM_SYSTEM (gsm_systemd_new ());
                 if (system != NULL) {
                         g_debug ("Using systemd for session tracking");
                 }
diff --git a/gnome-session/meson.build b/gnome-session/meson.build
index 403d0572..9088a4a0 100644
--- a/gnome-session/meson.build
+++ b/gnome-session/meson.build
@@ -44,11 +44,14 @@ sources = files(
   'gsm-shell.c',
   'gsm-store.c',
   'gsm-system.c',
-  'gsm-systemd.c',
   'gsm-util.c',
   'service-main.c'
 )
 
+if libsystemd_dep.found()
+  sources += 'gsm-systemd.c'
+endif
+
 dbus_ifaces = [
   'org.gnome.SessionManager',
   'org.gnome.SessionManager.ClientPrivate',
diff --git a/meson.build b/meson.build
index b10c9455..1c5d4c5b 100644
--- a/meson.build
+++ b/meson.build
@@ -90,7 +90,8 @@ session_deps = [
   dependency('json-glib-1.0', version: '>= 0.10')
 ]
 
-libsystemd_dep = dependency('libsystemd', version: '>= 209', required: true)
+libsystemd_dep = dependency('libsystemd', version: '>= 209', required: get_option('systemd'))
+config_h.set10('HAVE_SYSTEMD', libsystemd_dep.found())
 config_h.set('SYSTEMD_STRICT_ENV',
               libsystemd_dep.version().version_compare('< 248'))
 
@@ -100,7 +101,7 @@ session_bin_deps = session_deps + [
 ]
 
 systemd_userunitdir = get_option('systemduserunitdir')
-if systemd_userunitdir == ''
+if systemd_userunitdir == '' and libsystemd_dep.found()
   systemd_dep = dependency('systemd', version: '>= 242', required: true)
   systemd_userunitdir = systemd_dep.get_variable(pkgconfig: 'systemduserunitdir',
                                                  pkgconfig_define: ['prefix', session_prefix])
diff --git a/meson_options.txt b/meson_options.txt
index 781d8eea..59a4dc8b 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -1,4 +1,5 @@
 option('deprecation_flags', type: 'boolean', value: false, description: 'use *_DISABLE_DEPRECATED flags')
+option('systemd', type: 'feature', value: 'auto', description: 'systemd integration')
 option('systemduserunitdir', type: 'string', description: 'Directory for systemd user service files')
 option('docbook', type: 'boolean', value: true, description: 'build documentation')
 option('man', type: 'boolean', value: true, description: 'build documentation (requires xmlto)')
diff --git a/tools/meson.build b/tools/meson.build
index c453093e..e4a0df56 100644
--- a/tools/meson.build
+++ b/tools/meson.build
@@ -1,10 +1,13 @@
 programs = [
   # name, deps, install_dir
-  ['gnome-session-ctl', session_bin_deps, session_libexecdir],
   ['gnome-session-inhibit', session_deps, session_bindir],
   ['gnome-session-quit', session_deps, session_bindir],
 ]
 
+if libsystemd_dep.found()
+  programs += ['gnome-session-ctl', session_bin_deps, session_libexecdir]
+endif
+
 foreach program: programs
   executable(
     program[0],
-- 
2.51.0

