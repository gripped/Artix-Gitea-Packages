            'SKIP'
            '7e6edbcd65048e029720e4fc0f0b8a1bf7fb742e007492046f5c478d21e9687571014731626915717030702cb85fbab6ec277608c73ad01323a9c4b01fcc5571')
sha512sums_x86_64=('45c11c2188be84a58b14bdde6ea57618ec23748ef25b51720c01bb1977db316263887a6138de5023ffa7ef7818f4754d9674413f3a0b9c72999db0806127b0d1')
b2sums=('56ad5161e34e8bf974d4c4e5bef10df67b618aa5f8e324f2a7f26722c022ebbf10c62d078c70692356a78e73577410e0334a1544109a72489626918df8493357'
