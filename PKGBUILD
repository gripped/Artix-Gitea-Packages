# Contributor: Jonas Witschel <diabonas@archlinux.org>
# Contributor: Bruno Pagani <archange@archlinux.org>

pkgname=tpm2-abrmd
pkgver=3.1.0
pkgrel=1
pkgdesc='Trusted Platform Module 2.0 Access Broker and Resource Management Daemon'
arch=('x86_64')
url='https://github.com/tpm2-software/tpm2-abrmd'
license=('BSD-2-Clause')
depends=(
  'glib2'
  'glibc'
  'libtss2-mu.so'
  'libtss2-rc.so'
  'libtss2-sys.so'
  'libtss2-tctildr.so'
  'tpm2-tss'
)
makedepends=(
  'autoconf-archive'
  'glib2-devel'
)
checkdepends=(
  'cmocka'
  'iproute2'
  'swtpm'
)
options=('!lto')
source=("$url/archive/$pkgver/$pkgname-$pkgver.tar.gz")
b2sums=('91c32f5c22d032e05578dcff9d2da938cec37a9600225d6f0b2f1e96444245fe9f0cb00b6115627bd33c427858ed27409bd7feabcbc7f0b1c636cec7a1399a45')

prepare() {
  cd "$pkgname-$pkgver"
  # Normally generated by ./bootstrap using git describe
  echo "$pkgver" > VERSION
  autoreconf -fiv
}

build() {
  cd "$pkgname-$pkgver"
  # shellcheck disable=SC2046
  ./configure \
    --prefix=/usr \
    --sbindir=/usr/bin \
    --with-dbuspolicydir=/usr/share/dbus-1/system.d \
    $( ((CHECKFUNC)) && echo --enable-unit --enable-integration)
  make
}

check() {
  cd "$pkgname-$pkgver"
  make check
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" install
  rm -vr "$pkgdir/usr/lib/systemd/system-preset"
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
