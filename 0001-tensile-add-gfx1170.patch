             gfx1151 = 1151,
             gfx1152 = 1152,
             gfx1153 = 1153,
+            gfx1170 = 1170,
             gfx1200 = 1200,
             gfx1201 = 1201,
             gfx1250 = 1250,
@@ -148,6 +149,8 @@ namespace Tensile
                 return "gfx1152";
             case AMDGPU::Processor::gfx1153:
                 return "gfx1153";
+            case AMDGPU::Processor::gfx1170:
+                return "gfx1170";
             case AMDGPU::Processor::gfx1200:
                 return "gfx1200";
             case AMDGPU::Processor::gfx1201:
@@ -276,6 +279,10 @@ namespace Tensile
             {
                 return AMDGPU::Processor::gfx1153;
             }
+            else if(deviceString.find("gfx11700") != std::string::npos)
+            {
+                return AMDGPU::Processor::gfx1170;
+            }
             else if(deviceString.find("gfx1200") != std::string::npos)
             {
                 return AMDGPU::Processor::gfx1200;
diff --git a/shared/tensile/Tensile/Source/lib/include/Tensile/PlaceholderLibrary.hpp b/shared/tensile/Tensile/Source/lib/include/Tensile/PlaceholderLibrary.hpp
