pkgname=cinnamon-translations
pkgver=5.2.1
pkgrel=1
pkgdesc="Translations for Cinnamon and Nemo"
arch=(any)
url="https://github.com/linuxmint/${pkgname}"
license=(GPL2)
options=(!emptydirs)
source=(${url}/archive/${pkgver}/${pkgname}-${pkgver}.tar.gz)
sha512sums=('e9f36ed889ac32e43a3edba80e53a708616a6edc2cff9d823ccc45747b7c5561dec02fc65c92775924c35a291fe0053aeef3efcce2c352d02843250987d119bd')
b2sums=('daf09a1d9175d61d4be547a25c71afd50147fa7b759324a8866b32761cabb30baebf4135c7f7e9104ca08a789aa0f8747aabaf9b9fc833962858ae1eb6d88595')

build() {
  cd ${pkgname}-${pkgver}
  make
}

package() {
  cd ${pkgname}-${pkgver}
  cp -r usr/ "${pkgdir}"
}
