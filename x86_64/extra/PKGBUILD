package() {
  for _srv in prometheus-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/prometheus-srv/${_srv/prometheus-srv./}
  done
  
  for _log in prometheus-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/prometheus-log/${_log/prometheus-log./}
  done
}
