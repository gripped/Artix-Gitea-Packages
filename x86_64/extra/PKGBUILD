package() {
  for _srv in darkhttpd-srv.{type,run,producer-for,conf}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/darkhttpd-srv/${_srv/darkhttpd-srv./}
  done
  
  for _log in darkhttpd-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/darkhttpd-log/${_log/darkhttpd-log./}
  done
}
