package() {
  for _srv in brltty-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/brltty-srv/${_srv/brltty-srv./}
  done
  
  for _log in brltty-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/brltty-log/${_log/brltty-log./}
  done
}
