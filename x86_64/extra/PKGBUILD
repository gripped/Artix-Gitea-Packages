# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=sddm-s6
pkgver=20210114
pkgrel=1
pkgdesc="s6 service scripts for sddm"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-s6"
groups=('s6-world')
provides=('sddm-runscripts')
conflicts=('sddm-runscripts')
depends=('sddm' 'elogind-s6' 's6')
install=sddm.install
source=("sddm.dependencies" "sddm.run" "sddm.type")
sha256sums=('40c2658b1781fa7250f55d7daec005ac0d43dc04c500a634cdd056e276146413'
            '5ac43a5c1d0971f2d6d1036882ef468467328b946b53c882f20c8a028bf24f63'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in dependencies run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'sddm'
}
