pkgname=konversation
pkgver=1.7.5
pkgrel=3
pkgdesc="A user-friendly and fully-featured IRC client"
arch=(x86_64)
url="https://konversation.kde.org"
depends=(knotifyconfig kemoticons kparts kidletime phonon-qt5 qca-qt5 hicolor-icon-theme perl)
optdepends=('python: python scripting support' 'keditbookmarks: for managing bookmarks')
makedepends=(extra-cmake-modules kdoctools)
license=(GPL2 FDL)
source=("https://download.kde.org/stable/$pkgname/$pkgver/src/$pkgname-$pkgver.tar.xz"
         qt5.13.patch gcc.patch qt5.15.patch kwindows.patch missing.patch)
validpgpkeys=(DA6B31C4B98A877DBB2EF9A292220328C632316E) # Eike Hein <hein@kde.org>

prepare() {
  mkdir -p build

  cd $pkgname-$pkgver
  patch -p1 -i ../qt5.13.patch # Fix build with Qt 5.13
  patch -p1 -i ../kwindows.patch
  patch -p1 -i ../missing.patch
  patch -p1 -i ../gcc.patch
}

build() {
  cd build
 export CFLAGS+=" -Wno-error"
  cmake ../$pkgname-$pkgver \
    -DBUILD_TESTING=OFF
  make
}

package() {
  cd build
  make DESTDIR="$pkgdir" install
}
