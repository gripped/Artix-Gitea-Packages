pkgrel=1
pkgdesc="s6-rc service scripts for lightdm"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-s6"
groups=('s6-world')
provides=('init-lightdm')
conflicts=('init-lightdm')
depends=('lightdm' 'elogind-s6' 's6-base')
install=lightdm.install
backup=('etc/s6/sv/lightdm-log/conf')
source=("lightdm-log.conf"
        "lightdm-log.consumer-for"
        "lightdm-log.notification-fd"
        "lightdm-log.pipeline-name"
        "lightdm-log.run"
        "lightdm-log.type"
        "lightdm-srv.dependencies"
        "lightdm-srv.producer-for"
        "lightdm-srv.run"
        "lightdm-srv.type")
