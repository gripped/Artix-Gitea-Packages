package() {
  for _srv in saslauthd-srv.{type,run,producer-for,conf}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/saslauthd-srv/${_srv/saslauthd-srv./}
  done
  
  for _log in saslauthd-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/saslauthd-log/${_log/saslauthd-log./}
  done
}
