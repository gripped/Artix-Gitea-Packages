# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=apparmor-s6
pkgver=20210506
pkgrel=1
pkgdesc="s6-rc service scripts for apparmor"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-s6"
groups=('s6-world')
provides=('init-apparmor')
conflicts=('init-apparmor')
depends=('apparmor' 's6-base')
install=apparmor.install
source=("apparmor.dependencies"
        "apparmor.type"
        "apparmor.up")
sha256sums=('953bc981527e6a08efdd7de8c5db0916ca58c52765b6e4ae599290e0486607a8'
            'aab38fd7998987a22d44fda7822afcfa69d039d3ba02b1f707f064df64352217'
            'b8785d592e331e51a99fbd3a2e4e54ba026025cc8b044b829fe22135a5bff03f')

_inst_sv(){
    for file in dependencies type up; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'apparmor'
}
