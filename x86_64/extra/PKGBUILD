# Maintainer: Artoo <artoo@artixlinux.org>

pkgname=blocaled
pkgver=0.2
pkgrel=1
pkgdesc='Provides a stand-alone implementation of the localed D-Bus service.'
arch=('x86_64')
url='https://github.com/pierre-labastie/blocaled'
license=('BSD')
depends=('polkit' 'libdaemon')
makedepends=('gtk-doc')
conflicts=('openrc-settingsd')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/v${pkgver}.tar.gz")
sha256sums=('96562abd23d70eccedcebad8f09a79cf436f801cf3d257169583f281da0357ba')

build(){
    cd ${pkgname}-${pkgver}
    ./autogen.sh
    ./configure \
        --sysconfdir=/etc \
        --prefix=/usr \
        --libexecdir=/usr/lib/blocaled \
        --with-keyboardconfig=/etc/vconsole.conf \
        --with-localeconfig=/etc/locale.conf
    make
}

check(){
    cd ${pkgname}-${pkgver}
    make -k check
}

package() {
	cd ${pkgname}-${pkgver}
	make DESTDIR="${pkgdir}" install
}
