# Maintainer: artoo <artoo@artixlinux.org>

pkgname=gdm-openrc
pkgver=20210207
pkgrel=1
pkgdesc="OpenRC gdm init script"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-openrc"
license=('GPL2')
groups=('openrc-world')
provides=('init-displaymanager')
depends=('gdm' 'openrc')
conflicts=('init-displaymanager')
source=("gdm.initd")
sha256sums=('e6dcb0e95e647b615439b1f21840d64dde483a2efc84449e00b26dbe81a2bf83')

package() {
    install -Dm755 "$srcdir/gdm.initd" "$pkgdir/etc/init.d/gdm"
}
