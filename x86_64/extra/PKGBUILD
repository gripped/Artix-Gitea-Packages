# Maintainer: artoo <artoo@artixlinux.org>

pkgname=sane-openrc
pkgver=20210505
pkgrel=1
pkgdesc="OpenRC sane init script"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-openrc"
license=('GPL2')
groups=('openrc-world')
depends=('openrc' 'sane')
provides=('init-sane')
conflicts=('systemd-sysvcompat' 'init-sane')
backup=('etc/conf.d/saned')
source=("saned.confd"
        "saned.initd")
sha256sums=('197e44ba1f438a18f5f7d9f5858feb19c1ece4286d82a5e63caf9be5b964aa76'
            '2409a98d34e4af4cb234b680744cdab5f5ccdc4f00303ba36e9b6cedf1e59391')

package() {
	install -Dm755 "$srcdir/saned.initd" "$pkgdir/etc/init.d/saned"
	install -Dm644 "$srcdir/saned.confd" "$pkgdir/etc/conf.d/saned"
}
