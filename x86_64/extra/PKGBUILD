package() {
  for _srv in mariadb-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/mariadb-srv/${_srv/mariadb-srv./}
  done
  
  for _log in mariadb-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/mariadb-log/${_log/mariadb-log./}
  done
}
