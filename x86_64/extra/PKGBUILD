pkgname=bftpd-dinit
pkgver=20211030
pkgrel=1
pkgdesc="dinit service scripts for bftpd"
arch=('any')
url="https://artixlinux.org"
license=('BSD')
groups=('dinit-world')
depends=('bftpd' 'dinit')
conflicts=('init-bftpd')
provides=('init-bftpd')
source=("bftpd")
sha256sums=('c604db0ec753343cf4111c71a5e1a8b8f1c26d298bf34c708a2df2773bdf009c')

package() {
    install -Dm644 bftpd "$pkgdir/etc/dinit.d/bftpd"
}
