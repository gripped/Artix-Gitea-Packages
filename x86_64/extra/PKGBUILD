# Maintainer: Dudemanguy <dudemanguy@artixlinux.org

pkgname=artix-checkupdates
pkgver=0.1
pkgrel=1
pkgdesc="Tool to check on updates between Artix and Arch"
arch=(x86_64)
url="https://gitea.artixlinux.org/artix/artix-checkupdates"
license=('GPL')
groups=('artools')
depends=(
    'brotli'
    'curl'
    'acl'
    'openssl'
    'glibc'
    'libunistring'
    'keyutils'
    'pacman'
)
makedepends=('git')
backup=('etc/artix-checkupdates/config')
source=("https://gitea.artixlinux.org/artix/${pkgname}/archive/${pkgver}.tar.gz")
b2sums=('ba87bc39996eb491c02a5eb135fdb28a9ebdc99aa561ed59bd6e3a53b8a76dd7e65f9d037e9bedac71315b74503d5309704d5723ca8d10bdc3fe848d51645df7')

build() {
  cd "${pkgname}-${pkgver}"
  make
}

package() {
  make -C "${_pkgbase}" DESTDIR="${pkgdir}" install
}
