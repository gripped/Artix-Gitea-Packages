pkgname=postgresql-s6
pkgver=20210201
pkgrel=1
pkgdesc="s6 service scripts for postgresql"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-s6"
groups=('s6-world')
provides=('postgresql-runscripts')
conflicts=('postgresql-runscripts')
depends=('postgresql' 's6')
install=postgresql.install
backup=('etc/s6/sv/postgresql-log/conf'
        'etc/s6/sv/postgresql-srv/conf')
source=("postgresql-log.conf"
        "postgresql-log.consumer-for"
        "postgresql-log.notification-fd"
        "postgresql-log.pipeline-name"
        "postgresql-log.run"
        "postgresql-log.type"
        "postgresql-srv.conf"
        "postgresql-srv.producer-for"
        "postgresql-srv.run"
        "postgresql-srv.type")
sha256sums=('8a3d2abcc40d355ca913f39871d24f6c770dd216fe075d2548e729b2ae952135'
            '7746e3e6f664c456babc4cded04e6d1e3c4da9db2666ca30a265a3a3fdff6af4'
