package() {
  for _srv in lircd-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/lircd-srv/${_srv/lircd-srv./}
  done
  
  for _log in lircd-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/lircd-log/${_log/lircd-log./}
  done
}
