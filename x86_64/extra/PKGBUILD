package() {
  for _srv in rsyncd-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/rsyncd-srv/${_srv/rsyncd-srv./}
  done
  
  for _log in rsyncd-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/rsyncd-log/${_log/rsyncd-log./}
  done
}
