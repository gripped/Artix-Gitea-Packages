pkgname=rsync-dinit
pkgver=20211030
pkgrel=1
pkgdesc="dinit service scripts for rsync"
arch=('any')
url="https://artixlinux.org"
license=('BSD')
groups=('dinit-world')
depends=('rsync' 'dinit')
conflicts=('init-rsync')
provides=('init-rsync')
source=("rsync")
sha256sums=('e82240eae9cac9fde50dbad6220b2c3199784fb812e332a05b606c18ee8cf11a')

package() {
    install -Dm644 rsync "$pkgdir/etc/dinit.d/rsync"
}
