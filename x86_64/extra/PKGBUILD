# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=ntp-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for ntp"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('ntp-runscripts')
conflicts=('ntp-runscripts')
depends=('ntp' 's6')
install=ntpd.install
source=("ntpd.run" "ntpd.type")
sha256sums=('e7e2491c91b483889b58901764b127aa686658c6b442ae83159887122e8c1adc'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'ntpd'
}
