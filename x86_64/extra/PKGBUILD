package() {
  for _srv in php-fpm-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/php-fpm-srv/${_srv/php-fpm-srv./}
  done
  
  for _log in php-fpm-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/php-fpm-log/${_log/php-fpm-log./}
  done
}
