pkgver=20200611
pkgrel=1
pkgdesc="s6 service scripts for networkmanager"
arch=('any')
url="https://gitea.artixlinux.org/"
groups=('s6-world')
provides=('networkmanager-runscripts')
conflicts=('networkmanager-runscripts')
depends=('networkmanager' 'dbus-s6' 's6')
install=NetworkManager.install
backup=('etc/s6/sv/NetworkManager-log/conf')
source=("NetworkManager-log.conf"
        "NetworkManager-log.consumer-for"
        "NetworkManager-log.notification-fd"
        "NetworkManager-log.pipeline-name"
        "NetworkManager-log.run"
        "NetworkManager-log.type"
        "NetworkManager-srv.dependencies"
        "NetworkManager-srv.producer-for"
        "NetworkManager-srv.run"
        "NetworkManager-srv.type")
