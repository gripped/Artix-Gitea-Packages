# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=fuse-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for fuse"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('fuse-runscripts')
conflicts=('fuse-runscripts')
depends=('fuse' 's6')
install=fuse.install
source=("fuse.down" "fuse.type" "fuse.up")
sha256sums=('bb6795df788580f573a8fb0800f53cbd83406a53a92b6a56c50a8f6f2d14401c'
            'aab38fd7998987a22d44fda7822afcfa69d039d3ba02b1f707f064df64352217'
            '4909550fe00251e1118a1094b955af5257e8ca2d7ac2aee5afb2fe01daa28c0d')

_inst_sv(){
    for file in down type up; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'fuse'
}
