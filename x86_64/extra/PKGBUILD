# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=sddm-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for sddm"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('sddm-runscripts')
conflicts=('sddm-runscripts')
depends=('sddm' 'elogind-s6' 's6')
install=sddm.install
source=("sddm.dependencies" "sddm.run" "sddm.type")
sha256sums=('d150375e1adf4cab68cb3978b5222f4ea2af46919a55c4e3c8533f80fbaaff43'
            '0e3086b193a93281ab63e76887215047c3db247589f32f103c98eed4d36d4b2e'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in dependencies run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'sddm'
}
