# Maintainer: Nathan Owens <ndowens@artixlinux.org>

pkgname=mpd-openrc
pkgver=20200716
pkgrel=1
pkgdesc="${pkgname/-openrc/} OpenRC init"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-openrc"
license=('GPL2')
groups=('openrc-world')
depends=('openrc' 'mpd')
conflicts=('systemd-sysvcompat')
backup=("etc/conf.d/${pkgname/-openrc/}")
source=("${pkgname/-openrc/}.confd"
	"${pkgname/-openrc/}.initd")
md5sums=('4815a523cb9ee5e3350341b91e3ee712'
         '1c9cda806edeed7eb7ded8f44afaee52')

package() {
	install -Dm755 "$srcdir/mpd.initd" "$pkgdir/etc/init.d/mpd"
	install -Dm644 "$srcdir/mpd.confd" "$pkgdir/etc/conf.d/mpd"
}
