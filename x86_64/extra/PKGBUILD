package() {
  for _srv in lighttpd-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/lighttpd-srv/${_srv/lighttpd-srv./}
  done
  
  for _log in lighttpd-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/lighttpd-log/${_log/lighttpd-log./}
  done
}
