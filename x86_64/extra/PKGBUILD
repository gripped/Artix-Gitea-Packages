pkgname=apache-s6
pkgver=20200902
pkgrel=1
pkgdesc="s6 service scripts for apache"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-s6"
groups=('s6-world')
provides=('apache-runscripts')
conflicts=('apache-runscripts')
depends=('apache' 's6')
install=apache.install
source=("apache-log.conf"
        "apache-log.consumer-for"
        "apache-log.notification-fd"
        "apache-log.pipeline-name"
        "apache-log.run"
        "apache-log.type"
        "apache-srv.producer-for"
        "apache-srv.run"
        "apache-srv.type")
sha256sums=('8a3d2abcc40d355ca913f39871d24f6c770dd216fe075d2548e729b2ae952135'
