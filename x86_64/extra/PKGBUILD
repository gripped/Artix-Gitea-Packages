package() {
  for _srv in ntpd-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/ntpd-srv/${_srv/ntpd-srv./}
  done
  
  for _log in ntpd-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/ntpd-log/${_log/ntpd-log./}
  done
}
