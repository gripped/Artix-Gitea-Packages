# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=metalog-s6
pkgver=20210506
pkgrel=1
pkgdesc="s6-rc service scripts for metalog"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-s6"
groups=('s6-world')
provides=('init-metalog')
conflicts=('init-metalog')
depends=('metalog' 's6-base')
install=metalog.install
source=("metalog.run"
        "metalog.type")
sha256sums=('674ba1c655fd3d28f1978a047ca98295197ec4f8d40492e96ce4937c3189aac0'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'metalog'
}
