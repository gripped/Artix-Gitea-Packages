# Maintainer: Nathan Owens <ndowen@artixlinux.org> 
pkgname=wireguard-openrc
pkgver=20200530
pkgrel=1.2
pkgdesc="OpenRC wireguard init script"
arch=('any')
url="https://gitea.artixlinux.org/PackagesW/wireguard-openrc"
license=('GPL2')
groups=('openrc-world')
depends=('openrc' 'wireguard-tools')
conflicts=('systemd-sysvcompat')
backup=(etc/conf.d/wireguard)
source=("wireguard.initd" "wireguard.confd")
sha256sums=('a1313ae573580b4b681e20956c410dd6f6cb7682a564ccff7f2b218ec5a9ca80'
            'ef2a35db4aeb29a1f2533fedc3b3208ca17cd6c32315a453df55d46e4927b61a')

_inst_initd(){
    install -Dm755 ${srcdir}/$1.initd ${pkgdir}/etc/init.d/$1
} 

_inst_confd() {
  install -Dm644 ${srcdir}/$1.confd ${pkgdir}/etc/conf.d/$1
}

package() {
    _inst_initd 'wireguard'
    _inst_confd 'wireguard'
}
