pkgname=lightdm-s6
pkgver=20210918
pkgrel=1
pkgdesc="s6-rc service scripts for lightdm"
arch=('any')
url="https://gitea.artixlinux.org/artix/s6-services"
groups=('s6-world')
provides=('init-lightdm')
conflicts=('init-lightdm')
depends=('lightdm' 'init-logind' 's6-base')
makedepends=('git')
install=lightdm-s6.install
backup=('etc/s6/config/lightdm.conf')
_commit=4e024337a13def263e1b81e64edb0ff821fecceb
source=("git+https://gitea.artixlinux.org/artix/s6-services.git#commit=$_commit")
sha256sums=('SKIP')

package() {
    cd "${srcdir}"/s6-services
    sh install.sh "lightdm" "${pkgdir}"
}
