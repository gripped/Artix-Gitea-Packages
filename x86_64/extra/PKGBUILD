package() {
  for _srv in saned-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/saned-srv/${_srv/saned-srv./}
  done
  
  for _log in saned-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/saned-log/${_log/saned-log./}
  done
}
