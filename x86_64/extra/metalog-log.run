#!/usr/bin/execlineb -P
foreground { if -n -t { test -d /var/log/metalog } install -d -m 0755 -o s6log -g s6log /var/log/metalog }
foreground { chown -R metalog:metalog /var/log/metalog }
envfile /etc/s6/sv/metalog-log/conf
importas -sCiu DIRECTIVES DIRECTIVES
s6-setuidgid s6log exec -c s6-log -d3 -b -- ${DIRECTIVES} /var/log/metalog
