#!/usr/bin/execlineb -P
envfile /etc/s6/sv/lightdm-log/conf
importas -iu DIRECTIVES DIRECTIVES
foreground { if -n -t { test -d /var/log/lightdm } install -d -m 0755 -o s6log -g s6log /var/log/lightdm }
foreground { chown -R s6log:s6log /var/log/lightdm }
s6-setuidgid s6log exec -c sh -c "s6-log -d3 -b ${DIRECTIVES} /var/log/lightdm"
