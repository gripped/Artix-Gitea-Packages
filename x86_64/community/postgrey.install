post_install() {
  # Add postgrey before postfix
  if [ -f /etc/s6/sv/postfix/run ]; then
  echo "postgrey" >> /etc/s6/sv/postfix/dependencies
  fi
}

post_upgrade() {
  post_install
}

pre_remove() {
  if [ -e /run/service/postgrey-srv ]; then
    s6-rc -d change postgrey
  fi
}

post_remove() {
  rm -rf /etc/s6/sv/postgrey-srv
  rm -rf /etc/s6/sv/postgrey-log
}
