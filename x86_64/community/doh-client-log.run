#!/usr/bin/execlineb -P
envfile /etc/s6/sv/doh-client-log/conf
importas -iu DIRECTIVES DIRECTIVES
foreground { if -n -t { test -d /var/log/doh-client } install -d -m 0755 -o s6log -g s6log /var/log/doh-client }
foreground { chmod -R 755 /var/log/doh-client }
s6-setuidgid s6log exec -c sh -c "s6-log -d3 -b ${DIRECTIVES} /var/log/doh-client"
