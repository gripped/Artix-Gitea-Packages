# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=cpupower-s6
pkgver=20210506
pkgrel=1
pkgdesc="s6-rc service scripts for cpupower"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-s6"
groups=('s6-galaxy')
provides=('init-cpupower')
conflicts=('init-cpupower')
depends=('cpupower' 's6-base')
install=cpupower.install
source=("cpupower.dependencies"
        "cpupower.type"
        "cpupower.up")
sha256sums=('953bc981527e6a08efdd7de8c5db0916ca58c52765b6e4ae599290e0486607a8'
            'aab38fd7998987a22d44fda7822afcfa69d039d3ba02b1f707f064df64352217'
            '218e067be60d0b3e68fbe2bf762b13606bf984df29fa1e6da50d783c398301a0')

_inst_sv(){
    for file in dependencies down type up; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'cpupower'
}
