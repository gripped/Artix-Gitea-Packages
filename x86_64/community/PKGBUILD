package() {
  for _srv in fwknopd-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/fwknopd-srv/${_srv/fwknopd-srv./}
  done
  
  for _log in fwknopd-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/fwknopd-log/${_log/fwknopd-log./}
  done
}
