package() {
  for _srv in docker-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/docker-srv/${_srv/docker-srv./}
  done
  
  for _log in docker-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/docker-log/${_log/docker-log./}
  done
}
