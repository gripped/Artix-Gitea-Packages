provides=('init-earlyoom')
conflicts=('init-earlyoom')
depends=('earlyoom' 's6-base')
install=earlyoom.install
backup=('etc/s6/sv/earlyoom-log/conf'
        'etc/s6/sv/earlyoom-srv/conf')
source=("earlyoom-log.conf"
        "earlyoom-log.consumer-for"
        "earlyoom-log.notification-fd"
        "earlyoom-log.pipeline-name"
        "earlyoom-log.run"
        "earlyoom-log.type"
        "earlyoom-srv.conf"
        "earlyoom-srv.producer-for"
        "earlyoom-srv.run"
        "earlyoom-srv.type")
