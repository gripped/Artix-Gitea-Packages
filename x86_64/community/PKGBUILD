package() {
  for _srv in hostapd-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/hostapd-srv/${_srv/hostapd-srv./}
  done
  
  for _log in hostapd-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/hostapd-log/${_log/hostapd-log./}
  done
}
