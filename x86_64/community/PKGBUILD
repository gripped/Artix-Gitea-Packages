package() {
  for _srv in stubby-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/stubby-srv/${_srv/stubby-srv./}
  done
  
  for _log in stubby-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/stubby-log/${_log/stubby-log./}
  done
}
