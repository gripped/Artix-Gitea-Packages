package() {
  for _srv in apcupsd-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/apcupsd-srv/${_srv/apcupsd-srv./}
  done
  
  for _log in apcupsd-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/apcupsd-log/${_log/apcupsd-log./}
  done
}
