# Maintainer: Dudemanguy <dudemanguy@artixlinux.org> 
pkgname=sslh-s6
pkgver=20210506
pkgrel=1
pkgdesc="s6-rc service scripts for sslh"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-s6"
groups=('s6-galaxy')
provides=('init-sslh')
conflicts=('init-sslh')
depends=('sslh' 's6-base')
install=sslh.install
source=("sslh.run" "sslh.type")
sha256sums=('dd58fbe9cc095120d188051e89228a8ac50fff911a165de614750e6d28428a31'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'sslh'
}
