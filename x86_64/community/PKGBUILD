# Maintainer: Brett Cornwall <ainola@archlinux.org>
# Contributor: Lennard Hofmann

pkgname=wf-recorder
pkgver=0.2.1
pkgrel=3.1
pkgdesc="Screen recorder for wlroots-based compositors such as sway"
arch=("x86_64")
url="https://github.com/ammen99/wf-recorder"
license=('MIT')
depends=(
	'libavcodec.so'
	'libavdevice.so'
	'libavformat.so'
	'libavutil.so'
	'libswresample.so'
	'libswscale.so'
	'ocl-icd'
	'wayland'
)
makedepends=(
	'meson'
	'opencl-headers'
	'scdoc'
	'wayland-protocols'
  'git'
)
optdepends=(
	'slurp: Select a region to record'
)
_commit=47a3905f670fe12ecbdfe4719df654df1cd183e2
source=("$pkgname-$pkgver::git+https://github.com/ammen99/wf-recorder.git#commit=$_commit")
sha256sums=('SKIP')

build() {
	meson "$pkgname-$pkgver" build \
		--prefix=/usr \
		--buildtype=plain
	ninja -C build
}

package() {
	DESTDIR="$pkgdir/" ninja -C build install
	install -Dm644 "$pkgname-$pkgver/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"
}
