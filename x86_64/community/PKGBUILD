pkgname=aws-cli
pkgver=1.22.74
pkgrel=1
pkgdesc='Universal Command Line Interface for Amazon Web Services'
arch=('any')
url="https://github.com/aws/aws-cli"
license=('Apache')
depends=('python-botocore' 'python-dateutil' 'python-jmespath'
         'python-colorama' 'python-docutils' 'python-rsa'
         'python-s3transfer' 'python-yaml')
makedepends=('python-setuptools')
checkdepends=('python-pytest')
source=($pkgname-$pkgver.tar.gz::$url/archive/$pkgver.tar.gz)
b2sums=('bab52f3a46033c0f6b36419a612ef01ed79ac8f361bdb90ad2e07aede8b6244e0d0cca20dd4eae6b664f24ae9564e4ad548fc1eb55526242d2cbdd1771ba329c')

build() {
  cd $pkgname-$pkgver
  python setup.py build
}

# Artix addition
check() {
  cd $pkgname-$pkgver
  PATH="$PATH:$PWD/bin" PYTHONPATH="$PWD/build/lib/" python scripts/ci/run-tests
}

package() {
  cd $pkgname-$pkgver

  python setup.py install --root="$pkgdir" --optimize=1

  install -Dm644 LICENSE.txt "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
  install -Dm644 bin/aws_bash_completer "$pkgdir"/usr/share/bash-completion/completions/aws

  rm -f "$pkgdir"/usr/bin/{aws.cmd,aws_bash_completer}
}
