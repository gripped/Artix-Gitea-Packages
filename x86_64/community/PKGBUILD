_inst_sv(){
    for file in conf consumer-for dependencies notification-fd \
        pipeline-name producer-for run type up; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'intel-undervolt'
    _inst_sv 'intel-undervolt-loop-log'
    _inst_sv 'intel-undervolt-loop-srv'
}
