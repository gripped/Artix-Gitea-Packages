package() {
  for _srv in coturn-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/coturn-srv/${_srv/coturn-srv./}
  done
  
  for _log in coturn-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/coturn-log/${_log/coturn-log./}
  done
}
