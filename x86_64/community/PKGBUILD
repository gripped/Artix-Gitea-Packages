provides=('init-bolt')
conflicts=('init-bolt')
depends=('bolt' 's6-base')
install=boltd.install
backup=('etc/s6/sv/bolt-log/conf')
source=("boltd-log.conf"
        "boltd-log.consumer-for"
        "boltd-log.notification-fd"
        "boltd-log.pipeline-name"
        "boltd-log.run"
        "boltd-log.type"
        "boltd-srv.producer-for"
        "boltd-srv.run"
        "boltd-srv.type")
