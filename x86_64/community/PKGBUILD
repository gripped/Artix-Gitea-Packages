package() {
  for _srv in opensips-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/opensips-srv/${_srv/opensips-srv./}
  done
  
  for _log in opensips-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/opensips-log/${_log/opensips-log./}
  done
}
