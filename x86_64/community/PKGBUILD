# Maintainer: Nathan Owens <ndowens@artixlinux.org>

pkgname=chrony-openrc
pkgver=20210504
pkgrel=2
pkgdesc="OpenRC chrony init"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-openrc"
license=('GPL2')
groups=('openrc-galaxy')
depends=('openrc' 'chrony')
provides=('init-chrony')
conflicts=('systemd-sysvcompat' 'init-chrony')
backup=('etc/conf.d/chrony')
source=("chrony.confd"
	"chrony.initd")
md5sums=('9a5fd0cd6dd6ec7d77a0681f20c6e2c8'
         'f2a45826f968f7efdd9d242c07e944d9')

package() {
	install -Dm755 "$srcdir/chrony.initd" "$pkgdir/etc/init.d/chrony"
	install -Dm644 "$srcdir/chrony.confd" "$pkgdir/etc/conf.d/chrony"
}
