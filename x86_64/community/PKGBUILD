# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=syncthing-relaysrv-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for syncthing-relaysrv"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('syncthing-relaysrv-runscripts')
conflicts=('syncthing-relaysrv-runscripts')
depends=('syncthing-relaysrv' 's6')
install=syncthing-relaysrv.install
source=("relaysrv.run" "relaysrv.type")
sha256sums=('1ac1f77588849a283023fe5e2bbfbfdadb03666f10b9e991bf157961a7888468'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'relaysrv'
}
