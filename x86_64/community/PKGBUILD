pkgver=20210506
pkgrel=1
pkgdesc="s6-rc service scripts for mopidy"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-s6"
groups=('s6-galaxy')
provides=('init-mopidy')
conflicts=('init-mopidy')
depends=('mopidy' 's6-base')
backup=('etc/s6/sv/mopidy-log/conf')
install=mopidy.install
source=("mopidy-log.conf"
        "mopidy-log.consumer-for"
        "mopidy-log.notification-fd"
        "mopidy-log.pipeline-name"
        "mopidy-log.run"
        "mopidy-log.type"
        "mopidy-srv.producer-for"
        "mopidy-srv.run" 
        "mopidy-srv.type")
sha256sums=('8a3d2abcc40d355ca913f39871d24f6c770dd216fe075d2548e729b2ae952135'
            '218d40dac97369e1810bb255fadf431f5de110da101c1f9fbb48a531817b74e4'
