sha512sums_x86_64=('1d1aef3b579c7327ff913513e8d3d5e1fdf652373605044465f4a026717c9a19c11015033b08330ae5841faf4988621533a63d3f493e43047ba7ccac3b8a680b')
sha512sums_aarch64=('2d4d556ae97bffc284c6d5053ed710576d97ec8374af298ec450bbbba8182dc7bfa5fed3b089f44f49da7c43c02a0d30bf663028c2c656c6d115524a74e29120')
