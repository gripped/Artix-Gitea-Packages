package() {
  for _srv in atftpd-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/atftpd-srv/${_srv/atftpd-srv./}
  done
  
  for _log in atftpd-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/atftpd-log/${_log/atftpd-log./}
  done
}
