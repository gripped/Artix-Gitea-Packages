sha512sums_x86_64=('a1e0e857a81748b1fec624b8626bdad494020c00091c02a46cd1839cddfdb7a5b8e59d4958d4aa6f08158242cb3436d940a25cbd761d1269a95d3ba919985cbb')
sha512sums_aarch64=('beba28765cabd47d86aa7e58f242004b1ffb01293058bfd3cfc1eb883ccf32fc76399a8fab1c9562f671a1e6c4ca2a764b17b451b4372319ed24b957473b31d9')
