package() {
  for _srv in bumblebeed-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/bumblebeed-srv/${_srv/bumblebeed-srv./}
  done
  
  for _log in bumblebeed-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/bumblebeed-log/${_log/bumblebeed-log./}
  done
}
