pkgname=pdnsd-openrc
pkgver=20200620
pkgrel=1
pkgdesc="OpenRC pdnsd init script"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-openrc"
license=('GPL2')
groups=('openrc-galaxy')
depends=('openrc' 'pdnsd')
conflicts=('systemd-sysvcompat')
source=("pdnsd.initd")
sha256sums=('e2c121b80dbe189eb45f0b0e500740b8219633125ac9b283aed76f0e8243ad01')

package() {
    install -Dm755 "$srcdir/pdnsd.initd" "$pkgdir/etc/init.d/pdnsd"
}
