package() {
  for _srv in thermald-srv.{type,run,producer-for,dependencies}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/thermald-srv/${_srv/thermald-srv./}
  done
  
  for _log in thermald-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/thermald-log/${_log/thermald-log./}
  done
}
