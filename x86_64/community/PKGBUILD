conflicts=('init-postgrey')
depends=('postgrey' 's6-base')
backup=('etc/s6/sv/postgrey-log/conf')
install=postgrey.install
source=("postgrey-log.conf"
        "postgrey-log.consumer-for"
        "postgrey-log.notification-fd"
        "postgrey-log.pipeline-name"
        "postgrey-log.run"
        "postgrey-log.type"
        "postgrey-srv.producer-for"
        "postgrey-srv.run" 
        "postgrey-srv.type")
