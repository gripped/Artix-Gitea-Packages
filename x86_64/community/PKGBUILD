package() {
  for _srv in jenkins-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/jenkins-srv/${_srv/jenkins-srv./}
  done
  
  for _log in jenkins-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/jenkins-log/${_log/jenkins-log./}
  done
}
