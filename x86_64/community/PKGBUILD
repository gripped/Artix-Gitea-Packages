package() {
  for _srv in smtpd-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/smtpd-srv/${_srv/smtpd-srv./}
  done
  
  for _log in smtpd-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/smtpd-log/${_log/smtpd-log./}
  done
}
