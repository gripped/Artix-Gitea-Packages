provides=('intel-undervolt-runscripts')
conflicts=('intel-undervolt-runscripts')
depends=('intel-undervolt' 'elogind-s6' 's6')
install=intel-undervolt.install
backup=('etc/s6/sv/intel-undervolt-loop-log/conf')
source=("intel-undervolt."{type,up,dependencies}
        "intel-undervolt-loop-srv."{type,run,dependencies,producer-for}
        "intel-undervolt-loop-log."{type,run,conf,pipeline-name,consumer-for,notification-fd})
