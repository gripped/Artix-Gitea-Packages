package() {
  for _srv in fcron-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/fcron-srv/${_srv/fcron-srv./}
  done
  
  for _log in fcron-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/fcron-log/${_log/fcron-log./}
  done
}
