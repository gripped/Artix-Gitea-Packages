groups=('s6-galaxy')
provides=('init-minio')
conflicts=('init-minio')
depends=('minio' 's6-base')
backup=('etc/s6/sv/minio-log/conf')
install=minio.install
source=("minio-log.conf"
        "minio-log.consumer-for"
        "minio-log.notification-fd"
        "minio-log.pipeline-name"
        "minio-log.run"
        "minio-log.type"
        "minio-srv.producer-for"
        "minio-srv.run" 
        "minio-srv.type")
