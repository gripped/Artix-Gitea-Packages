pkgname=pdnsd-dinit
pkgver=20211102
pkgrel=1
pkgdesc="dinit service scripts for pdnsd"
arch=('any')
url="https://artixlinux.org"
license=('BSD')
groups=('dinit-galaxy')
depends=('pdnsd' 'dinit')
conflicts=('init-pdnsd')
provides=('init-pdnsd')
source=("pdnsd")
sha256sums=('407b10895328a4d73bf9d285f8eae3392eb6b34745ff097f3e8112186e9057f8')

package() {
    install -Dm644 pdnsd "$pkgdir/etc/dinit.d/pdnsd"
}
