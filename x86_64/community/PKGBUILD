        "spice-vdagentd-log.consumer-for"
        "spice-vdagentd-log.notification-fd"
        "spice-vdagentd-log.pipeline-name"
        "spice-vdagentd-log.run"
        "spice-vdagentd-log.type"
        "spice-vdagentd-srv.producer-for"
        "spice-vdagentd-srv.run" 
        "spice-vdagentd-srv.type")
