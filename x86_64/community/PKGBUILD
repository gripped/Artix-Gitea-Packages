# Maintainer: Tim Meusel <tim@bastelfreak.de>

pkgname="ruby-${_gemname}"
pkgver=2.0.1
pkgrel=1
pkgdesc='About Faraday adapter for Patron'
arch=('any')
url="https://github.com/lostisland/faraday-patron"
license=('MIT')
depends=('ruby')
makedepends=('ruby-rspec')
options=('!emptydirs')
source=("$pkgname-$pkgver.tar.gz::https://github.com/lostisland/faraday-patron/archive/refs/tags/v$pkgver.tar.gz")
sha512sums=('dd6736c74b1dab42894abee7f830a23ba4773c0bf97af060b738e9b404015d4ae15998e60463c219814cf5abbaaa57a550824b4b78d4fc06b35f1041a91db5e3')

prepare() {
  cd "${srcdir}/faraday-patron-$pkgver"

  # drop broken/cirular dependencies
  sed --in-place '/add_development_dependency/d' "faraday-patron.gemspec"
}

build() {
  cd "${srcdir}/faraday-patron-$pkgver"
  gem build "faraday-patron.gemspec"
}

package() {
cd "${srcdir}/faraday-patron-$pkgver"
  local _gemdir="$(gem env gemdir)"
  gem install --verbose --ignore-dependencies --no-user-install --install-dir "${pkgdir}/faraday-patron" --bindir "${pkgdir}/usr/bin" "faraday-patron-${pkgver}.gem"

  install -Dm 644 LICENSE.md -t "${pkgdir}/usr/share/licenses/${pkgname}/"

  install -Dm 644 README.md -t "${pkgdir}/usr/share/doc/${pkgname}"

  rm -rf "${pkgdir}/faraday-patron/cache"
}
