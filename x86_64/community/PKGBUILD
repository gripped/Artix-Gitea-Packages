pkgname=i2pd-s6
pkgver=20210506
pkgrel=1
pkgdesc="s6-rc service scripts for i2pd"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-s6"
groups=('s6-galaxy')
provides=('init-i2pd')
conflicts=('init-i2pd')
depends=('i2pd' 's6-base')
install=i2pd.install
backup=('etc/s6/sv/i2pd-log/conf')
source=("i2pd-log.conf"
        "i2pd-log.consumer-for"
        "i2pd-log.notification-fd"
        "i2pd-log.pipeline-name"
        "i2pd-log.run"
        "i2pd-log.type"
        "i2pd-srv.producer-for"
        "i2pd-srv.run"
        "i2pd-srv.type")
sha256sums=('8a3d2abcc40d355ca913f39871d24f6c770dd216fe075d2548e729b2ae952135'
            'd20a6c378c91f21b642bdfde21fb78a718d864db06ca5895b2c413d770281991'
            '1121cfccd5913f0a63fec40a6ffd44ea64f9dc135c66634ba001d10bcf4302a2'
