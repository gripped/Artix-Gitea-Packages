package() {
  for _srv in privoxy-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/privoxy-srv/${_srv/privoxy-srv./}
  done
  
  for _log in privoxy-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/privoxy-log/${_log/privoxy-log./}
  done
}
