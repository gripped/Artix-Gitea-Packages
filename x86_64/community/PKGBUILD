groups=('s6-galaxy')
provides=('init-shairplay')
conflicts=('init-shairplay')
depends=('shairplay' 's6-base')
backup=('etc/s6/sv/shairplay-log/conf'
        'etc/s6/sv/shairplay-srv/conf')
install=shairplay.install
source=("shairplay-log.conf"
        "shairplay-log.consumer-for"
        "shairplay-log.notification-fd"
        "shairplay-log.pipeline-name"
        "shairplay-log.run"
        "shairplay-log.type"
        "shairplay-srv.conf"
        "shairplay-srv.producer-for"
        "shairplay-srv.run" 
        "shairplay-srv.type")
