# Contributor: Bruno Gola <brunogola at gmail dot com>

pkgname=libfreexl
pkgver=1.0.6
pkgrel=1
pkgdesc="Library to extract valid data from within an Excel (.xls) spreadsheet"
arch=('x86_64')
url="https://www.gaia-gis.it/fossil/freexl/‎"
license=('MPL' 'GPL' 'LGPL')
depends=('glibc')
source=(http://www.gaia-gis.it/gaia-sins/freexl-sources/freexl-$pkgver.zip)
sha256sums=('9bd148ae81356bc65dc14b7e70c1c2227dee20693abd83f2c2d22ba80855598f')

build() {
  cd "${srcdir}"/${pkgname/lib/}-$pkgver

  ./configure --prefix=/usr
  make
}

package() {
  cd "${srcdir}"/${pkgname/lib/}-$pkgver

  make DESTDIR="${pkgdir}" install
}
