package() {
  for _srv in at-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/at-srv/${_srv/at-srv./}
  done
  
  for _log in at-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/at-log/${_log/at-log./}
  done
}
