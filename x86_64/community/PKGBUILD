# Maintainer: Dudemanguy <dudemanguy@artixlinux.org> 
pkgname=sshguard-s6
pkgver=20210506
pkgrel=1
pkgdesc="s6-rc service scripts for sshguard"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-s6"
groups=('s6-galaxy')
provides=('init-sshguard')
conflicts=('init-sshguard')
depends=('sshguard' 's6-base')
install=sshguard.install
source=("sshguard.run" "sshguard.type")
sha256sums=('77f2a12830a204b7751e2c48f5084580511b3a26a0134476f3eaaa1ccdf4563a'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'sshguard'
}
