package() {
  for _srv in dovecot-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/dovecot-srv/${_srv/dovecot-srv./}
  done
  
  for _log in dovecot-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/dovecot-log/${_log/dovecot-log./}
  done
}
