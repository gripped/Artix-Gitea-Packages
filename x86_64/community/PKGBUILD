package() {
  for _srv in prosody-srv.{type,run,producer-for,finish}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/prosody-srv/${_srv/prosody-srv./}
  done
  
  for _log in prosody-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/prosody-log/${_log/prosody-log./}
  done
}
