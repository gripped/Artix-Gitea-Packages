package() {
  for _srv in gitea-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/gitea-srv/${_srv/gitea-srv./}
  done
  
  for _log in gitea-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/gitea-log/${_log/gitea-log./}
  done
}
