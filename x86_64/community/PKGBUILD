package() {
  for _srv in pcscd-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/pcscd-srv/${_srv/pcscd-srv./}
  done
  
  for _log in pcscd-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/pcscd-log/${_log/pcscd-log./}
  done
}
