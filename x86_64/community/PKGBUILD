package() {
  for _srv in tor-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/tor-srv/${_srv/tor-srv./}
  done
  
  for _log in tor-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/tor-log/${_log/tor-log./}
  done
}
