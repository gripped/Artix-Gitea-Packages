package() {
  for _srv in chronyd-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/chronyd-srv/${_srv/chronyd-srv./}
  done
  
  for _log in chronyd-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/chronyd-log/${_log/chronyd-log./}
  done
}
