package() {
  for _srv in openfire-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/openfire-srv/${_srv/openfire-srv./}
  done
  
  for _log in openfire-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/openfire-log/${_log/openfire-log./}
  done
}
