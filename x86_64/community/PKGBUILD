pkgname=sslh-dinit
pkgver=20211103
pkgrel=1
pkgdesc="dinit service scripts for sslh"
arch=('any')
url="https://artixlinux.org"
license=('BSD')
groups=('dinit-galaxy')
depends=('sslh' 'dinit')
conflicts=('init-sslh')
provides=('init-sslh')
source=("sslh")
sha256sums=('24ab97816ce68c9f0449238129b06b5c079510978ea996232ced32a4e00d35cb')

package() {
    install -Dm644 sslh "$pkgdir/etc/dinit.d/sslh"
}
