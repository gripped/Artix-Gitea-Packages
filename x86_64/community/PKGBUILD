# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>

pkgname=chrony-s6
pkgver=20200104
pkgrel=1
pkgdesc="s6 service scripts for chrony"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('chrony-runscripts')
conflicts=('chrony-runscripts')
depends=('chrony' 's6')
install=chrony.install
source=("chronyd.run" "chronyd.type")
sha256sums=('08b338db7e6427b4ac5cbc6b86ceb6acad9f8f3864c318f1f5336e601ca35e09'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'chronyd'
}
