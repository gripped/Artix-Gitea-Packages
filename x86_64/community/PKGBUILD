pkgname=znc-dinit
pkgver=20211103
pkgrel=1
pkgdesc="dinit service scripts for znc"
arch=('any')
url="https://artixlinux.org"
license=('BSD')
groups=('dinit-galaxy')
depends=('znc' 'dinit')
conflicts=('init-znc')
provides=('init-znc')
source=("znc")
sha256sums=('a7f363dd684bf71c32ba83b64e3542fd1222dbbc2d443c73978837512defe0f9')

package() {
    install -Dm644 znc "$pkgdir/etc/dinit.d/znc"
}
