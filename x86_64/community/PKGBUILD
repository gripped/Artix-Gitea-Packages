# Maintainer: Chris Cromer <cromer@artixlinux.org>

pkgname=micro
pkgver=2.0.8
pkgrel=1
pkgdesc="A modern and intuitive terminal-based text editor"
arch=("i686" "x86_64")
url="https://${pkgname}-editor.github.io/"
license=("MIT")
depends=("glibc")
makedepends=("git" "go")
optdepends=(
  "xclip: Required for copying/pasting text"
  "wl-clipboard"
)
source=(
  "${pkgname}-${pkgver}::https://github.com/zyedidia/${pkgname}/archive/v${pkgver}.tar.gz"
)
sha256sums=('3e1b7483aa2afffa8afc2c710e22541961ac3de5e026efb4bdddc8ade00d4de0')

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  install -Dm755 "${pkgname}" "${pkgdir}/usr/bin/${pkgname}"
  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  for _file in *.md
  do
    install -Dm644 "${_file}" "${pkgdir}/usr/share/doc/${pkgname}/$(basename ${_file})"
  done
}
