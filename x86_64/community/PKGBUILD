groups=('s6-galaxy')
provides=('init-nsd')
conflicts=('init-nsd')
depends=('nsd' 's6-base')
backup=('etc/s6/sv/nsd-log/conf')
install=nsd.install
source=("nsd-log.conf"
        "nsd-log.consumer-for"
        "nsd-log.notification-fd"
        "nsd-log.pipeline-name"
        "nsd-log.run"
        "nsd-log.type"
        "nsd-srv.producer-for"
        "nsd-srv.run" 
        "nsd-srv.type")
