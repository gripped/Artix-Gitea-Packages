groups=('s6-galaxy')
provides=('init-grafana')
conflicts=('init-grafana')
depends=('grafana' 's6-base')
install=grafana.install
backup=('etc/s6/sv/grafana-log/conf')
source=("grafana-log.conf"
        "grafana-log.consumer-for"
        "grafana-log.notification-fd"
        "grafana-log.pipeline-name"
        "grafana-log.run"
        "grafana-log.type"
        "grafana-srv.producer-for"
        "grafana-srv.run" 
        "grafana-srv.type")
