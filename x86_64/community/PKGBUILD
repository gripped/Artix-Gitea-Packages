# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=fcgiwrap-s6
pkgver=20200628
pkgrel=1
pkgdesc="s6 service scripts for fcgiwrap"
arch=('any')
url="https://gitea.artixlinux.org"
groups=('s6-galaxy')
provides=('fcgiwrap-runscripts')
conflicts=('fcgiwrap-runscripts')
depends=('fcgiwrap' 's6')
install=fcgiwrap.install
source=("fcgiwrap.finish"
        "fcgiwrap.run"
        "fcgiwrap.type")
sha256sums=('5591cf3bf3b909a90cda40184a24cc03c517252d7114c373f5777fa849c11074'
            '93ae1773eb434ba99200c7ea626ea28ed89a8c814bbf2c9e913e56ba3bce75f5'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in finish run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'fcgiwrap'
}
