package() {
  for _srv in backuppc-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/backuppc-srv/${_srv/backuppc-srv./}
  done
  
  for _log in backuppc-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/backuppc-log/${_log/backuppc-log./}
  done
}
