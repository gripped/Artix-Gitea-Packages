pkgname=tor-dinit
pkgver=20211103
pkgrel=1
pkgdesc="dinit service scripts for tor"
arch=('any')
url="https://artixlinux.org"
license=('BSD')
groups=('dinit-galaxy')
depends=('tor' 'dinit')
conflicts=('init-tor')
provides=('init-tor')
source=("tor")
sha256sums=('ac0fa17ba936e9aa21edf15af2e6b6d5ddfbbcba479ed9dba21725881bee382b')

package() {
    install -Dm644 tor "$pkgdir/etc/dinit.d/tor"
}
