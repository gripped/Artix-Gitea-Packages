From c54843ba508a4c1f55e9ff99bd53ca2dd574b95f Mon Sep 17 00:00:00 2001
From: Nathan <ndowens@artixlinux.org>
Date: Mon, 24 Jan 2022 23:11:41 -0600
Subject: [PATCH] ffmpeg

---
 channels/tsmf/client/ffmpeg/tsmf_ffmpeg.c | 1 -
 libfreerdp/codec/dsp_ffmpeg.c             | 1 -
 libfreerdp/codec/h264_ffmpeg.c            | 3 ---
 3 files changed, 5 deletions(-)

diff --git a/channels/tsmf/client/ffmpeg/tsmf_ffmpeg.c b/channels/tsmf/client/ffmpeg/tsmf_ffmpeg.c
index 0444ad0..760f492 100644
--- a/channels/tsmf/client/ffmpeg/tsmf_ffmpeg.c
+++ b/channels/tsmf/client/ffmpeg/tsmf_ffmpeg.c
@@ -615,7 +615,6 @@ static void tsmf_ffmpeg_free(ITSMFDecoder* decoder)
 static INIT_ONCE g_Initialized = INIT_ONCE_STATIC_INIT;
 static BOOL CALLBACK InitializeAvCodecs(PINIT_ONCE once, PVOID param, PVOID* context)
 {
-	avcodec_register_all();
 	return TRUE;
 }
 
diff --git a/libfreerdp/codec/dsp_ffmpeg.c b/libfreerdp/codec/dsp_ffmpeg.c
index 0af3cf4..88724fc 100644
--- a/libfreerdp/codec/dsp_ffmpeg.c
+++ b/libfreerdp/codec/dsp_ffmpeg.c
@@ -571,7 +571,6 @@ BOOL freerdp_dsp_ffmpeg_supports_format(const AUDIO_FORMAT* format, BOOL encode)
 FREERDP_DSP_CONTEXT* freerdp_dsp_ffmpeg_context_new(BOOL encode)
 {
 	FREERDP_DSP_CONTEXT* context;
-	avcodec_register_all();
 	context = calloc(1, sizeof(FREERDP_DSP_CONTEXT));
 
 	if (!context)
diff --git a/libfreerdp/codec/h264_ffmpeg.c b/libfreerdp/codec/h264_ffmpeg.c
index 4e3ba8f..03eb7db 100644
--- a/libfreerdp/codec/h264_ffmpeg.c
+++ b/libfreerdp/codec/h264_ffmpeg.c
@@ -507,9 +507,6 @@ static BOOL libavcodec_init(H264_CONTEXT* h264)
 
 	h264->pSystemData = (void*)sys;
 
-#if LIBAVCODEC_VERSION_INT < AV_VERSION_INT(58, 137, 100)
-	avcodec_register_all();
-#endif
 
 	if (!h264->Compressor)
 	{
-- 
2.35.0

