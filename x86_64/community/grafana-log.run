#!/usr/bin/execlineb -P
envfile /etc/s6/sv/grafana-log/conf
importas -iu DIRECTIVES DIRECTIVES
foreground { if -n -t { test -d /var/log/grafana } install -d -m 0755 -o s6log -g s6log /var/log/grafana }
foreground { touch /var/log/grafana/grafana.log }
foreground { chown grafana:grafana /var/log/grafana/grafana.log }
s6-setuidgid s6log exec -c sh -c "s6-log -d3 -b ${DIRECTIVES} /var/log/grafana"
