#!/usr/bin/execlineb -P
envfile /etc/s6/sv/jenkins-log/conf
importas -iu DIRECTIVES DIRECTIVES
foreground { if -n -t { test -d /var/log/jenkins } install -d -m 0755 -o s6log -g s6log /var/log/jenkins }
foreground { chmod -R 755 /var/log/jenkins }
s6-setuidgid s6log exec -c sh -c "s6-log -d3 -b ${DIRECTIVES} /var/log/jenkins"
