pkgname=wpa_supplicant-s6
pkgver=20210506
pkgrel=1
pkgdesc="s6-rc service scripts for wpa_supplicant"
arch=('any')
url="https://gitea.artixlinux.org/artix/s6-services"
groups=('s6-system')
provides=('init-wpa_supplicant')
conflicts=('init-wpa_supplicant')
depends=('wpa_supplicant' 's6-base')
makedepends=('git')
optdepends=('dhcpcd-s6: dhcpcd integration')
install=wpa_supplicant.install
backup=('etc/s6/config/wpa_supplicant.conf')
source=("git+https://gitea.artixlinux.org/artix/s6-services.git")
sha256sums=('SKIP')

package() {
    cd $srcdir/s6-services
    sh install.sh wpa_supplicant $pkgdir
}
