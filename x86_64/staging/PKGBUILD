pkgname=postgresql-s6
pkgver=20210512
pkgrel=1
pkgdesc="s6-rc service scripts for postgresql"
arch=('any')
url="https://gitea.artixlinux.org/artix/s6-services"
groups=('s6-world')
provides=('init-postgresql')
conflicts=('init-postgresql')
depends=('postgresql' 's6-base')
makedepends=('git')
_commit=3cb52daad8645d2afb14e9cd026fc46c5e55fe87
backup=('etc/s6/config/postgresql.conf')
source=("git+https://gitea.artixlinux.org/artix/s6-services.git#commit=$_commit")
sha256sums=('SKIP')

package() {
    cd "${srcdir}"/s6-services
    sh install.sh "postgresql" "${pkgdir}"
}
