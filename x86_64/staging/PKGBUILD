pkgname=fuse-s6
pkgver=20210511
pkgrel=1
pkgdesc="s6-rc service scripts for fuse"
arch=('any')
url="https://gitea.artixlinux.org/artix/s6-services"
groups=('s6-world')
provides=('init-fuse')
conflicts=('init-fuse')
depends=('fuse' 's6-base')
makedepends=('git')
source=("git+https://gitea.artixlinux.org/artix/s6-services.git")
sha256sums=('SKIP')

package() {
    cd "${srcdir}"/s6-services
    sh install.sh "fuse" "${pkgdir}"
}
