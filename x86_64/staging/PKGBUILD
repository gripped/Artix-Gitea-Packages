pkgname=colord-s6
pkgver=20210511
pkgrel=1
pkgdesc="s6-rc service scripts for colord"
arch=('any')
url="https://gitea.artixlinux.org/artix/s6-services"
groups=('s6-world')
provides=('init-colord')
conflicts=('init-colord')
depends=('colord' 'dbus-s6' 's6-base')
source=("git+https://gitea.artixlinux.org/artix/s6-services.git")
sha256sums=('SKIP')

package() {
    cd "${srcdir}"/s6-services
    sh install.sh "colord" "${pkgdir}"
}
