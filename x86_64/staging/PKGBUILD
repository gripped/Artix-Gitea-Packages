pkgname=elogind-s6
pkgver=20210511
pkgrel=1
pkgdesc="s6-rc service scripts for elogind"
arch=('any')
url="https://gitea.artixlinux.org/artix/s6-services"
depends=('elogind' 'dbus-s6' 's6-base')
makedepends=('git')
provides=('init-logind' 'init-elogind')
conflicts=('init-logind' 'init-elogind')
source=("git+https://gitea.artixlinux.org/artix/s6-services.git")
sha256sums=('SKIP')

package() {
    cd "${srcdir}"/s6-services
    sh install.sh "elogind" "${pkgdir}"
}
