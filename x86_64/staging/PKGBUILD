# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
# Contributor: artoo <artoo@artixlinux.org> 
pkgname=s6-base
pkgver=1.2
pkgrel=1
pkgdesc='Packages, hooks, and scripts to define a basic s6 init system implementation for Artix Linux.'
url='https://gitea.artixlinux.org/artix/alpm-hooks'
arch=('any')
license=('GPL')
depends=('s6' 's6-scripts' 's6-linux-init')
makedepends=('git')
provides=('svc-manager' 'init-rc')
conflicts=('svc-manager' 'init-rc')
source=('git+https://gitea.artixlinux.org/artix/alpm-hooks.git')
sha256sums=('SKIP')

package() {
    # s6-rc hooks
    install -d ${pkgdir}/usr/bin
    install -d ${pkgdir}/usr/share/libalpm/{scripts,hooks}

    install -m644 ${srcdir}/alpm-hooks/s6/hooks/* ${pkgdir}/usr/share/libalpm/hooks
    install -m755 ${srcdir}/alpm-hooks/s6/scripts/* ${pkgdir}/usr/share/libalpm/scripts
    install -m755 ${srcdir}/alpm-hooks/s6/s6-rc-bundle-update ${pkgdir}/usr/bin
}
