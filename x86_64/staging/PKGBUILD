pkgname=subversion-s6
pkgver=20210511
pkgrel=1
pkgdesc="s6-rc service scripts for subversion"
arch=('any')
url="https://gitea.artixlinux.org/artix/s6-services"
groups=('s6-world')
provides=('init-subversion')
conflicts=('init-subversion')
depends=('subversion' 's6-base')
makedepends=('git')
backup=('etc/s6/config/subversion.conf')
source=("git+https://gitea.artixlinux.org/artix/s6-services.git")
sha256sums=('SKIP')

package() {
    cd "${srcdir}"/s6-services
    sh install.sh "subversion" "${pkgdir}"
}
