pkgname=bluez-s6
pkgver=20210511
pkgrel=1
pkgdesc="s6-rc service scripts for bluez"
arch=('any')
url="https://gitea.artixlinux.org/artix/s6-services"
groups=('s6-world')
provides=('init-bluez')
conflicts=('init-bluez')
depends=('bluez' 'dbus-s6' 's6-base')
makedepends=('git')
backup=('etc/s6/config/bluez.conf')
source=("git+https://gitea.artixlinux.org/artix/s6-services.git")
sha256sums=('SKIP')

package() {
    cd "${srcdir}"/s6-services
    sh install.sh "bluez" "${pkgdir}"
}
