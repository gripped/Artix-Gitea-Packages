pre_upgrade() {
    echo "Warning: this update will kill and restart your tty1 service."
    echo "This may kill your current session. Save your work before proceeding."
    echo "Press 'ctrl+\' to quit the update. Press 'ctrl+c' to continue."
    echo "If you quit, you need to manually remove the /var/lib/pacman/db.lck file."
    while true; do
        trap "sh /usr/share/libalpm/scripts/s6-rc-db-update-hook; break" 2
    done
}

post_install() {
    cryptsetup=$(pacman -Qi cryptsetup-s6 2> /dev/null)
    if [[ "$?" == "0" ]]; then
        echo "cryptsetup" >> /etc/s6/sv/mount-filesystems/dependencies
    fi
    lvm2=$(pacman -Qi lvm2-s6 2> /dev/null)
    if [[ "$?" == "0" ]]; then
        echo "lvm2" >> /etc/s6/sv/mount-filesystems/dependencies
    fi
}

post_upgrade() {
    post_install
    s6-rc -u change agetty-tty1
}

post_remove() {
    rm -rf /etc/s6/sv/dmesg
    rm -rf /etc/s6/sv/mount-net
    rm -rf /etc/s6/sv/rc-local
    rm -rf /etc/s6/sv/udevd-log
}
