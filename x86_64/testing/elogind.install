pre_remove() {
    if [ -e "/run/service/elogind-srv" ]; then
        s6-rc -d change elogind
    fi
    sed -i '/elogind/d' /etc/s6/sv/misc/contents
}

post_install() {
    echo "elogind" >> /etc/s6/sv/misc/contents
}

post_upgrade() {
    if ! grep -q elogind /etc/s6/sv/misc/contents; then
        post_install
    fi
}

post_remove() {
    rm -rf /etc/s6/sv/elogind-log
}
