pkgname=transmission-openrc
pkgver=20210505
pkgrel=1
pkgdesc="${pkgname/-openrc/} OpenRC init"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-openrc"
license=('GPL2')
groups=('openrc-world')
depends=('openrc' 'transmission-cli')
provides=('init-transmission')
conflicts=('systemd-sysvcompat' 'init-transmission')
backup=("etc/conf.d/${pkgname/-openrc/}")
source=("${pkgname/-openrc/}.initd"
	    "${pkgname/-openrc/}.confd")
b2sums=('34ebb53495aa4339832fbf75f3ff515e15bd93329d0b6d88172589c9024b3b9a16a1c2436dabebb700687ca8d0f7115cd198a665bc51e7ca0b965bc2c929b999'
        '52cd64646a30ab09926c406022c819f75deb182b04006082d9aa49c91c129f31dd9c9e49456ddb23d746b87c7e157cb859eb09ef9dcd0a798d097469fcb5beba')

package() {
  install -Dm755 "$srcdir/transmission.initd" "$pkgdir/etc/init.d/transmission"
  install -Dm644 "$srcdir/transmission.confd" "$pkgdir/etc/conf.d/transmission"
}
