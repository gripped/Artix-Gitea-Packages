# Maintainer: Muhammad Herdiansyah <koni@artixlinux.org>

pkgname=lm_sensors-dinit
pkgver=20211030
pkgrel=1
pkgdesc="dinit service scripts for lm_sensors"
arch=('any')
url="https://artixlinux.org"
license=('BSD')
groups=('dinit-world')
depends=('lm_sensors' 'dinit')
conflicts=('init-lm_sensors')
provides=('init-lm_sensors')
source=("fancontrol"
        "lm_sensors"
        "lm_sensors.script")
sha256sums=('0b16782d0ee64bf0be5f924dc04e4d36f0e43be01665bd4e18f9c2ddd5d79d15'
            'f3b6c54a15e5aa9995e51a48e6683446eb27e64a3ce41fab260185a00ef6b839'
            'c5da0837a079f713fdde921031a168ab9c421d206b0c92a3f4af6e05fe79e437')

package() {
    install -Dm644 fancontrol        "$pkgdir/etc/dinit.d/fancontrol"
    install -Dm644 lm_sensors        "$pkgdir/etc/dinit.d/lm_sensors"
    install -Dm755 lm_sensors.script "$pkgdir/etc/dinit.d/lm_sensors.script"
}
