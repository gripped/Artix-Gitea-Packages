pkgname=nginx-dinit
pkgver=20211030
pkgrel=1
pkgdesc="dinit service scripts for nginx"
arch=('any')
url="https://artixlinux.org"
license=('BSD')
groups=('dinit-world')
depends=('nginx' 'dinit')
conflicts=('init-nginx')
provides=('init-nginx')
source=("nginx")
sha256sums=('bbd21920d568a7d32e644bb247596abfa9ca60254c2c531d7a758bc575b1db7a')

package() {
    install -Dm644 nginx "$pkgdir/etc/dinit.d/nginx"
}
