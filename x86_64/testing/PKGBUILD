# Maintainer: artoo <artoo@artixlinux.org>
# Contributor: williamh <williamh@gentoo.org>

_net_url="https://github.com/gentoo/netifrc/archive"
_func_url="https://github.com/gentoo/gentoo-functions/archive"

_func_ver=0.13

pkgname=netifrc
pkgver=0.7.2
pkgrel=1
pkgdesc="Gentoo Network Interface Management Scripts"
arch=('x86_64')
url="http://www.gentoo.org/proj/en/base/openrc/"
license=('BSD2')
depends=('udev')
backup=('etc/conf.d/net')
source=("${pkgname}-${pkgver}.tar.gz::${_net_url}/${pkgver}.tar.gz"
        "gentoo-functions-${_func_ver}.tar.gz::${_func_url}/${_func_ver}.tar.gz")
sha256sums=('5641a7e3ea8918849de668d795f932ebbd0358ee5fda48b22e5cbe04c1b20c75'
            '6b8c90adf7f90a1b2f4a8343f93c518fcdcad12511a7d77578a1d6044f0073b3')

_net_args=(
    SYSCONFDIR=/etc
    PREFIX=/usr
    SBINDIR=/usr/bin
    LIBEXECDIR=/usr/lib/${pkgname}
    )
_func_args=(
    ROOTPREFIX=/usr
    ROOTSBINDIR=/usr/bin
    ROOTLIBEXECDIR=/usr/lib/artix
    )

build(){
    # make netifrc
    cd "${srcdir}/${pkgname}-${pkgver}"
    make "${_net_args[@]}"
    cd ${srcdir}/gentoo-functions-${_func_ver}
    make "${_func_args[@]}"
}

package() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    make DESTDIR="${pkgdir}" "${_net_args[@]}" install

    install -Dm 644 "${srcdir}/${pkgname}-${pkgver}/doc/net.example" "${pkgdir}/etc/conf.d/net"

    install -d "${pkgdir}/etc/runlevels/boot"
    ln -sf "/etc/init.d/net.lo" "${pkgdir}/etc/runlevels/boot/net.lo"

    cd ${srcdir}/gentoo-functions-${_func_ver}
    make DESTDIR="${pkgdir}" "${_func_args[@]}" install

    sed -e "s|/lib/gentoo/functions.sh|/usr/lib/$_id/functions.sh|g" \
        -i "${pkgdir}/usr/lib/${pkgname}/sh/functions.sh"

    install -Dm644 ${srcdir}/${pkgname}-${pkgver}/LICENSE "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"

    # rm systemd wrapper
    rm -fv ${pkgdir}/usr/lib/netifrc/sh/systemd-wrapper.sh
}
