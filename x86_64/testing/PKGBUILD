# Maintainer: artoo <artoo@artixlinux.org>

pkgname=xdm-openrc
pkgver=20210413
pkgrel=1
pkgdesc="OpenRC xdm init script"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-openrc"
license=('GPL2')
groups=('openrc-world')
provides=('init-displaymanager')
depends=('xorg-xdm' 'openrc')
conflicts=('init-displaymanager')
source=("xdm.initd")
sha256sums=('feab7864d5dd89833b991760dbf27b195addd587aab1c7aafa9371f20165758d')

package() {
    install -Dm755 "$srcdir/xdm.initd" "$pkgdir/etc/init.d/xdm"
}
