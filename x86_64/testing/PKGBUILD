pkgname=lirc-dinit
pkgver=20211030
pkgrel=1
pkgdesc="dinit service scripts for lirc"
arch=('any')
url="https://artixlinux.org"
license=('BSD')
groups=('dinit-world')
depends=('lirc' 'dinit')
conflicts=('init-lirc')
provides=('init-lirc')
source=("lircd")
sha256sums=('bb7cd99b1848ba0b7903a043bcf38def83dc5f4834915256c5a21a989038b6cb')

package() {
    install -Dm644 lircd "$pkgdir/etc/dinit.d/lircd"
}
