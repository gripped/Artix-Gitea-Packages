#!/usr/bin/openrc-run

supervisor=supervise-daemon
command="/usr/bin/gdm"
command_background=true

depend() {
    need localmount

    after bootmisc consolefont modules netmount
    after readahead-list ypbind autofs openvpn gpm lircmd
    after quota keymaps
    before alsasound
    want logind
    use xfs

    provide xdm
}
