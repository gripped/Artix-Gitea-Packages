pkgname=lib32-libproxy
pkgver=0.4.17
pkgrel=1
pkgdesc='A library that provides automatic proxy configuration management'
arch=(x86_64)
url=https://libproxy.github.io/libproxy/
license=(LGPL)
depends=(
  lib32-dbus
  lib32-gcc-libs
  lib32-zlib
  libproxy
)
makedepends=(
  cmake
  git
  ninja
)
source=("https://github.com/libproxy/libproxy/archive/${pkgver}.tar.gz")
b2sums=('70b78c90aebb0ea308d105ec6d2c61bb54dea36df2d99db835f29c6ffa91168c15e73e01823b799a37fa89a9cb6fca51013ea057006b608fa2a79f4056a5d3c5')

build() {
  export CC='gcc -m32'
  export CXX='g++ -m32'
  export PKG_CONFIG_PATH=/usr/lib32/pkgconfig

  cmake -S libproxy-$pkgver -B build -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_C_FLAGS="${CFLAGS}" \
    -DCMAKE_CXX_FLAGS="$CXXFLAGS" \
    -DCMAKE_SKIP_RPATH=ON \
    -DLIB_SUFFIX=32 \
    -DWITH_{DOTNET,GNOME3,KDE,MOZJS,NM,PERL,VALA,WEBKIT,WEBKIT3}=OFF
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install
  rm -rf "${pkgdir}"/usr/{bin,include,share}
}

