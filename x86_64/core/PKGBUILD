        "auditd-log.consumer-for"
        "auditd-log.notification-fd"
        "auditd-log.pipeline-name"
        "auditd-log.run"
        "auditd-log.type"
        "auditd-srv.producer-for"
        "auditd-srv.run"
        "auditd-srv.type")
