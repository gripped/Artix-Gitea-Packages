# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=s6-scripts
pkgver=20210721
pkgrel=1
pkgdesc='A collection of essential s6-rc oneshots and longruns for startup/shutdown.'
arch=('any')
url='https://gitea.artixlinux.org/artix/s6-scripts'
provides=('init-udev' 'eudev-s6')
depends=('execline' 'pam' 's6-rc' 'udev')
replaces=('eudev-s6')
optdepends=('cryptsetup-s6: cryptsetup boot script support'
            'lvm2-s6: lvm2 boot script support')
backup=('etc/s6/rc.local'
        'etc/s6/config/agetty-serial.conf'
        'etc/s6/config/agetty-tty1.conf'
        'etc/s6/config/agetty-tty2.conf'
        'etc/s6/config/agetty-tty3.conf'
        'etc/s6/config/agetty-tty4.conf'
        'etc/s6/config/agetty-tty5.conf'
        'etc/s6/config/agetty-tty6.conf'
        'etc/s6/config/dmesg.conf'
        'etc/s6/config/hwclock.conf'
        'etc/s6/config/mount-cgroups.conf'
        'etc/s6/config/udevd.conf'
        'etc/s6/sv/mount-net/dependencies'
        'etc/s6/sv/rc-local/dependencies'
        'usr/lib/sysctl.d/50-default.conf')
install=s6-scripts.install
makedepends=('git')
_commit=98b24e23c1aba55ea5d8072cf007b795ca950030
source=("git+https://gitea.artixlinux.org/artix/s6-scripts.git#commit=$_commit")
sha256sums=('SKIP')

package() {
    cd "${pkgname}"
    make DESTDIR="${pkgdir}" install

    # ugly hack for sddm; will be removed later
    mv $srcdir/$pkgname/early-getty-down $pkgdir/etc/s6/sv/
}
