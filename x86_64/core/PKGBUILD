# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=elogind-s6
pkgver=20210114
pkgrel=1
pkgdesc="s6 service scripts for elogind"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-s6"
depends=('elogind' 'dbus-s6' 's6')
provides=('init-elogind')
conflicts=('init-elogind')
install=elogind.install
source=("elogind-log.conf"
        "elogind-log.notification-fd"
        "elogind-log.run"
        "elogind-log.type"
        "elogind-srv.dependencies"
        "elogind-srv.run"
        "elogind-srv.type")
sha256sums=('8a3d2abcc40d355ca913f39871d24f6c770dd216fe075d2548e729b2ae952135'
            '1121cfccd5913f0a63fec40a6ffd44ea64f9dc135c66634ba001d10bcf4302a2'
            '73435f7761cb7261ff6eab5b9282c744831cd091aeb99ae91de67c5a8bb41d19'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006'
            '9291726828590f8d9d158572c381e2cefc24adf21055036cba07585acc1abb62'
            'ecadf94f8850cb3f27f22bb14ac670957690584d1a0c9e3ba4ffda6608977596'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in conf dependencies notification-fd run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'elogind-log'
    _inst_sv 'elogind-srv'
    cp -r $pkgdir/etc/s6/sv/elogind-srv $pkgdir/etc/s6/sv/elogind
}
