pkgname=cronie-s6
pkgver=20200611
pkgrel=1
pkgdesc="s6 service scripts for cronie"
arch=('any')
url="https://gitea.artixlinux.org/"
groups=('s6-system')
provides=('init-cronie')
conflicts=('init-cronie')
depends=('cronie' 's6')
install=cronie.install
backup=('etc/s6/sv/cronie-log/conf')
source=("cronie-log.conf"
        "cronie-log.consumer-for"
        "cronie-log.notification-fd"
        "cronie-log.pipeline-name"
        "cronie-log.run"
        "cronie-log.type"
        "cronie-srv.producer-for"
        "cronie-srv.run"
        "cronie-srv.type")
sha256sums=('8a3d2abcc40d355ca913f39871d24f6c770dd216fe075d2548e729b2ae952135'
            '918dd304cc582a9b8a3ded8ab054d1e4f1123621a12927aeb72d818b32200cc3'
