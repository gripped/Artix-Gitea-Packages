pkgname=wpa_supplicant-s6
pkgver=20200610
pkgrel=1
pkgdesc="s6 service scripts for wpa_supplicant"
arch=('any')
url="https://gitea.artixlinux.org"
groups=('s6-system')
provides=('init-wpa_supplicant')
conflicts=('init-wpa_supplicant')
depends=('wpa_supplicant' 'dhcpcd-s6' 's6')
install=wpa_supplicant.install
backup=('etc/s6/sv/wpa_supplicant-log/conf'
        'etc/s6/sv/wpa_supplicant-srv/conf')
source=("wpa_supplicant-log.conf"
        "wpa_supplicant-log.consumer-for"
        "wpa_supplicant-log.notification-fd"
        "wpa_supplicant-log.pipeline-name"
        "wpa_supplicant-log.run"
        "wpa_supplicant-log.type"
        "wpa_supplicant-srv.conf"
        "wpa_supplicant-srv.dependencies"
        "wpa_supplicant-srv.producer-for"
        "wpa_supplicant-srv.run"
        "wpa_supplicant-srv.type")
