# Maintainer: Nathan <ndowens@artixlinux.org>
pkgname=bolt-s6
pkgver=20210511
pkgrel=1
pkgdesc="s6-rc service scripts for bolt"
arch=('any')
url="https://gitea.artixlinux.org/artix/s6-services"
groups=('s6-galaxy')
provides=('init-bolt')
conflicts=('init-bolt')
depends=('bolt' 's6-base')
makedepends=('git')
backup=('etc/s6/config/bolt.conf')
source=("git+https://gitea.artixlinux.org/artix/s6-services.git")
sha256sums=('SKIP')

package() {
    cd "${srcdir}"/s6-services
    sh install.sh "bolt" "${pkgdir}"
}
