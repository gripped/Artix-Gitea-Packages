pkgname=pcsclite-s6
pkgver=20210511
pkgrel=1
pkgdesc="s6-rc service scripts for pcsclite"
arch=('any')
url="https://gitea.artixlinux.org/artix/s6-services"
groups=('s6-galaxy')
provides=('init-pcsclite')
conflicts=('init-pcsclite')
depends=('pcsclite' 's6-base')
makedepends=('git')
backup=('etc/s6/config/pcsclite.conf')
source=("git+https://gitea.artixlinux.org/artix/s6-services.git")
sha256sums=('SKIP')

package() {
    cd "${srcdir}"/s6-services
    sh install.sh "pcsclite" "${pkgdir}"
}
