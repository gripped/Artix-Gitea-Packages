# Maintainer: Nathan <ndownes@artixlinux.org>
pkgname=minio-s6
pkgver=20210511
pkgrel=1
pkgdesc="s6-rc service scripts for minio"
arch=('any')
url="https://gitea.artixlinux.org/artix/s6-services"
groups=('s6-galaxy')
provides=('init-minio')
conflicts=('init-minio')
depends=('minio' 's6-base')
makedepends=('git')
backup=('etc/s6/config/minio.conf')
source=("git+https://gitea.artixlinux.org/artix/s6-services.git")
sha256sums=('SKIP')

package() {
    cd "${srcdir}"/s6-services
    sh install.sh "minio" "${pkgdir}"
}
