pkgname=sshguard-s6
pkgver=20210511
pkgrel=1
pkgdesc="s6-rc service scripts for sshguard"
arch=('any')
url="https://gitea.artixlinux.org/artix/s6-services"
groups=('s6-galaxy')
provides=('init-sshguard')
conflicts=('init-sshguard')
depends=('sshguard' 's6-base')
makedepends=('git')
source=("git+https://gitea.artixlinux.org/artix/s6-services.git")
sha256sums=('SKIP')

package() {
    cd "${srcdir}"/s6-services
    sh install.sh "sshguard" "${pkgdir}"
}
