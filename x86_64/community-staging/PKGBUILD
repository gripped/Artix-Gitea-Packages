pkgname=tlp-s6
pkgver=20210511
pkgrel=1
pkgdesc="s6-rc service scripts for tlp"
arch=('any')
url="https://gitea.artixlinux.org/artix/s6-services"
groups=('s6-galaxy')
provides=('init-tlp')
conflicts=('init-tlp')
depends=('tlp' 's6-base')
