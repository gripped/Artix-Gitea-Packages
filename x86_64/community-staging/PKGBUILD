# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=fcgiwrap-s6
pkgver=20210511
pkgrel=1
pkgdesc="s6-rc service scripts for fcgiwrap"
arch=('any')
url="https://gitea.artixlinux.org/artix/s6-services"
groups=('s6-galaxy')
provides=('init-fcgiwrap')
conflicts=('init-fcgiwrap')
depends=('fcgiwrap' 's6-base')
makedepends=('git')
backup=('etc/s6/config/fcgiwrap.conf')
source=("git+https://gitea.artixlinux.org/artix/s6-services.git")
sha256sums=('SKIP')

package() {
    cd "${srcdir}"/s6-services
    sh install.sh "fcgiwrap" "${pkgdir}"
}
