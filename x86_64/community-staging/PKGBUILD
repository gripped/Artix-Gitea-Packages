pkgname=unrealircd-s6
pkgver=20210511
pkgrel=1
pkgdesc="s6-rc service scripts for unrealircd"
arch=('any')
url="https://gitea.artixlinux.org/artix/s6-services"
groups=('s6-galaxy')
provides=('init-unrealircd')
conflicts=('init-unrealircd')
depends=('unrealircd' 's6-base')
makedepends=('git')
backup=('etc/s6/config/unrealircd.conf')
source=("git+https://gitea.artixlinux.org/artix/s6-services.git")
sha256sums=('SKIP')

package() {
    cd "${srcdir}"/s6-services
    sh install.sh "unrealircd" "${pkgdir}"
}
