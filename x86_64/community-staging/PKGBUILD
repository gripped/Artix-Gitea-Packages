pkgname=ddclient-s6
pkgver=20210511
pkgrel=1
pkgdesc="s6-rc service scripts for ddclient"
arch=('any')
url="https://gitea.artixlinux.org/artix/s6-services"
groups=('s6-galaxy')
provides=('init-ddclient')
conflicts=('init-ddclient')
depends=('ddclient' 's6-base')
makedepends=('git')
source=("git+https://gitea.artixlinux.org/artix/s6-services.git")
sha256sums=('SKIP')

package() {
    cd "${srcdir}"/s6-services
    sh install.sh "ddclient" "${pkgdir}"
}
