pkgname=ejabberd-s6
pkgver=20210511
pkgrel=1
pkgdesc="s6-rc service scripts for ejabberd"
arch=('any')
url="https://gitea.artixlinux.org/artix/s6-services"
groups=('s6-galaxy')
provides=('init-ejabberd')
conflicts=('init-ejabberd')
depends=('ejabberd' 's6-rc')
makedepends=('git')
backup=('etc/s6/config/ejabberd.conf')
source=("git+https://gitea.artixlinux.org/artix/s6-services.git")
sha256sums=('SKIP')

package() {
    cd "${srcdir}"/s6-services
    sh install.sh "ejabberd" "${pkgdir}"
}
