#!/bin/sh

blacklist_kvm() {
	cat <<-EOM
	 > Current version of VirtulBox crashes the system if 'kvm*' modules
	 > are loaded. Unloading and blacklisting for now...
	EOM

	for MOD in $(lsmod | grep '^kvm' | cut -d' ' -f1); do
		rmmod "${MOD}"
	done
}

post_install() {
	blacklist_kvm
}

post_upgrade() {
	blacklist_kvm
}
