From 7f18ae7d2f0d7bd1940164802d6c6c1c8163ee53 Mon Sep 17 00:00:00 2001
From: artoo <artoo@artixlinux.org>
Date: Wed, 28 Oct 2026 21:04:52 +0100
Subject: [PATCH] esys-utils standalone install

---
 factory/templates/meson.build |  2 ++
 meson.build                   | 12 +++++++++++-
 src/core/meson.build          |  8 ++++----
 src/shutdown/meson.build      |  4 +++-
 src/sysusers/meson.build      |  4 +++-
 src/tmpfiles/meson.build      |  4 +++-
 sysusers.d/meson.build        |  4 ++--
 test/meson.build              | 12 ++++++------
 tmpfiles.d/meson.build        | 10 +++-------
 9 files changed, 37 insertions(+), 23 deletions(-)

diff --git a/factory/templates/meson.build b/factory/templates/meson.build
index 0f53217a48..071cfc9547 100644
--- a/factory/templates/meson.build
+++ b/factory/templates/meson.build
@@ -7,6 +7,7 @@ custom_target(
         output : 'locale.conf',
         command : [jinja2_cmdline, '@INPUT@', '@OUTPUT@'],
         install : true,
+        install_tag : 'etmpfiles',
         install_dir : factory_etc_dir)
 
 custom_target(
@@ -14,6 +15,7 @@ custom_target(
         output : 'vconsole.conf',
         command : [jinja2_cmdline, '@INPUT@', '@OUTPUT@'],
         install : true,
+        install_tag : 'etmpfiles',
         install_dir : factory_etc_dir)
 
 if conf.get('ENABLE_NSS') == 1
diff --git a/meson.build b/meson.build
index 25276e494e..734b76199e 100644
--- a/meson.build
+++ b/meson.build
@@ -2054,7 +2054,7 @@ generator_template = executable_template + {
 }
 
 libexec_template = executable_template + {
-        'install_dir' : libexecdir,
+        'install_dir' : bindir,
 }
 
 executable_additional_kwargs = {
@@ -2744,6 +2744,16 @@ install_data('LICENSE.GPL2',
 install_subdir('LICENSES',
                install_dir : docdir)
 
+install_data('LICENSE.GPL2',
+        'LICENSE.LGPL2.1',
+        install_tag : 'etmpfiles',
+        install_dir : datadir / 'doc/etmpfiles')
+
+install_data('LICENSE.GPL2',
+        'LICENSE.LGPL2.1',
+        install_tag : 'esysusers',
+        install_dir : datadir / 'doc/esysusers')
+
 #####################################################################
 
 # Ensure that changes to the docs/ directory do not break the
diff --git a/src/core/meson.build b/src/core/meson.build
index 80418bfe57..4c0ea3aebd 100644
--- a/src/core/meson.build
+++ b/src/core/meson.build
@@ -345,10 +345,10 @@ if install_sysconfdir
                         install_dir : sysconfdir / 'xdg/systemd')
 endif
 
-assert(fs.parent(sbindir) / 'lib/systemd' == libexecdir)
-install_symlink('init',
-                pointing_to : '../lib/systemd/systemd',
-                install_dir : sbindir)
+# assert(fs.parent(sbindir) / 'lib/systemd' == libexecdir)
+# install_symlink('init',
+#                 pointing_to : '../lib/systemd/systemd',
+#                 install_dir : sbindir)
 
 ############################################################
 
diff --git a/src/shutdown/meson.build b/src/shutdown/meson.build
index 397c67098f..9823bb4ecf 100644
--- a/src/shutdown/meson.build
+++ b/src/shutdown/meson.build
@@ -11,7 +11,7 @@ shutdown_detach_sources = files(
 
 executables += [
         libexec_template + {
-                'name' : 'systemd-shutdown',
+                'name' : 'eshutdown',
                 'public' : true,
                 'export' : files(
                         'detach-dm.c',
@@ -20,6 +20,8 @@ executables += [
                         'shutdown.c',
                 ) + shutdown_detach_sources,
                 'dependencies' : libmount_cflags,
+                'install' : 'static',
+                'install_tag' : 'eshutdown',
         },
         test_template + {
                 'sources' : files('test-umount.c') +
diff --git a/src/sysusers/meson.build b/src/sysusers/meson.build
index a8eff21bdc..02883aab05 100644
--- a/src/sysusers/meson.build
+++ b/src/sysusers/meson.build
@@ -6,9 +6,11 @@ endif
 
 executables += [
         executable_template + {
-                'name' : 'systemd-sysusers',
+                'name' : 'esysusers',
                 'public' : true,
                 'export' : files('sysusers.c'),
                 'dependencies' : libaudit_cflags,
+                'install' : 'static',
+                'install_tag' : 'esysusers',
         },
 ]
diff --git a/src/tmpfiles/meson.build b/src/tmpfiles/meson.build
index c6f22f56ff..e48a0eb222 100644
--- a/src/tmpfiles/meson.build
+++ b/src/tmpfiles/meson.build
@@ -8,7 +8,7 @@ offline_passwd_c = files('offline-passwd.c')
 
 executables += [
         executable_template + {
-                'name' : 'systemd-tmpfiles',
+                'name' : 'etmpfiles',
                 'public' : true,
                 'export' : files('tmpfiles.c') +
                             offline_passwd_c,
@@ -16,6 +16,8 @@ executables += [
                         libacl_cflags,
                         libselinux_cflags,
                 ],
+                'install' : 'static',
+                'install_tag' : 'etmpfiles',
         },
         test_template + {
                 'sources' : files('test-offline-passwd.c') +
diff --git a/sysusers.d/meson.build b/sysusers.d/meson.build
index 3c2e450a18..bc97bfd6d1 100644
--- a/sysusers.d/meson.build
+++ b/sysusers.d/meson.build
@@ -7,12 +7,11 @@ files = [['README',                true],
 
 foreach tuple : files
         if enable_sysusers and tuple[1]
-                install_data(tuple[0], install_dir : sysusersdir)
+                install_data(tuple[0], install_dir : sysusersdir, install_tag : 'esysusers')
         endif
 endforeach
 
 in_files = [['basic.conf',            true],
-            ['systemd-journal.conf',  true],
             ['systemd-network.conf',  conf.get('ENABLE_NETWORKD') == 1],
             ['systemd-resolve.conf',  conf.get('ENABLE_RESOLVE') == 1],
             ['systemd-timesync.conf', conf.get('ENABLE_TIMESYNCD') == 1],
@@ -25,5 +24,6 @@ foreach tuple : in_files
                 output: file,
                 command : [jinja2_cmdline, '@INPUT@', '@OUTPUT@'],
                 install : enable_sysusers and tuple[1],
+                install_tag : 'esysusers',
                 install_dir : sysusersdir)
 endforeach
diff --git a/test/meson.build b/test/meson.build
index d58ff3a637..6614fe1981 100644
--- a/test/meson.build
+++ b/test/meson.build
@@ -7,7 +7,7 @@ if conf.get('ENABLE_SYSUSERS') == 1
                 configuration : conf)
 
         if want_tests != 'false'
-                exe = executables_by_name.get('systemd-sysusers')
+                exe = executables_by_name.get('esysusers')
                 test('test-sysusers',
                      test_sysusers_sh,
                      # https://github.com/mesonbuild/meson/issues/2681
@@ -16,8 +16,8 @@ if conf.get('ENABLE_SYSUSERS') == 1
                      env : test_env,
                      suite : 'sysusers')
 
-                if 'systemd-sysusers.standalone' in executables_by_name
-                        exe = executables_by_name.get('systemd-sysusers.standalone')
+                if 'esysusers.standalone' in executables_by_name
+                        exe = executables_by_name.get('esysusers.standalone')
                         test('test-sysusers.standalone',
                              test_sysusers_sh,
                              # https://github.com/mesonbuild/meson/issues/2681
@@ -78,15 +78,15 @@ endif
 
 if want_tests != 'false' and conf.get('ENABLE_TMPFILES') == 1
         test_systemd_tmpfiles_py = files('test-systemd-tmpfiles.py')
-        exe = executables_by_name.get('systemd-tmpfiles')
+        exe = executables_by_name.get('etmpfiles')
         test('test-systemd-tmpfiles',
              test_systemd_tmpfiles_py,
              args : exe.full_path(),
              depends : exe,
              suite : 'tmpfiles')
 
-        if 'systemd-tmpfiles.standalone' in executables_by_name
-                exe = executables_by_name.get('systemd-tmpfiles.standalone')
+        if 'etmpfiles.standalone' in executables_by_name
+                exe = executables_by_name.get('etmpfiles.standalone')
                 test('test-systemd-tmpfiles.standalone',
                      test_systemd_tmpfiles_py,
                      args : exe.full_path(),
diff --git a/tmpfiles.d/meson.build b/tmpfiles.d/meson.build
index 83839dd627..53a27d474a 100644
--- a/tmpfiles.d/meson.build
+++ b/tmpfiles.d/meson.build
@@ -7,15 +7,12 @@ endif
 files = [['README'                                  ],
          ['home.conf'                               ],
          ['root.conf'                               ],
-         ['journal-nocow.conf'                      ],
          ['portables.conf',       'ENABLE_PORTABLED'],
          ['systemd-network.conf', 'ENABLE_NETWORKD' ],
          ['systemd-nologin.conf', 'HAVE_PAM'        ],
          ['systemd-nspawn.conf',  'ENABLE_MACHINED' ],
          ['systemd-pstore.conf',  'ENABLE_PSTORE'   ],
          ['systemd-resolve.conf', 'ENABLE_RESOLVE'  ],
-         ['20-systemd-varlink.conf'                 ],
-         ['systemd-tmp.conf'                        ],
          ['tmp.conf'                                ],
          ['x11.conf'                                ],
          ['provision.conf'                          ],
@@ -24,7 +21,7 @@ files = [['README'                                  ],
 
 foreach f : files
         if f.length() == 1 or conf.get(f[1]) == 1
-                install_data(f[0], install_dir : tmpfilesdir)
+                install_data(f[0], install_dir : tmpfilesdir, install_tag : 'etmpfiles')
         else
                 message('Not installing tmpfiles.d/@0@ because @1@ is @2@'
                         .format(f[0], f[1], conf.get(f[1], 0)))
@@ -35,12 +32,10 @@ in_files = [
         ['20-systemd-shell-extra.conf',   'LINK_SHELL_EXTRA_DROPIN'      ],
         ['20-systemd-osc-context.conf',   'LINK_OSC_CONTEXT_DROPIN'      ],
         ['20-systemd-ssh-generator.conf', 'ENABLE_SSH_PROXY_CONFIG'      ],
-        ['20-systemd-stub.conf',          'ENABLE_EFI'                   ],
         ['20-systemd-userdb.conf',        'ENABLE_SSH_USERDB_CONFIG'     ],
         ['etc.conf'                                                      ],
         ['legacy.conf',                   'ENABLE_COMPAT_SYSV_INTERFACES'],
         ['static-nodes-permissions.conf'                                 ],
-        ['systemd.conf'                                                  ],
         ['var.conf'                                                      ],
 ]
 
@@ -51,6 +46,7 @@ foreach f : in_files
                         output: f[0],
                         command : [jinja2_cmdline, '@INPUT@', '@OUTPUT@'],
                         install : true,
+                        install_tag : 'etmpfiles',
                         install_dir : tmpfilesdir)
         else
                 message('Not installing tmpfiles.d/@0@ because @1@ is @2@'
@@ -59,7 +55,7 @@ foreach f : in_files
 endforeach
 
 if install_sysconfdir
-        install_emptydir(sysconfdir / 'tmpfiles.d')
+        install_emptydir(sysconfdir / 'tmpfiles.d', install_tag : 'etmpfiles')
 endif
 
 subdir('user')
-- 
2.56.0

