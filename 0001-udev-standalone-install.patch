+++ b/src/core/meson.build
@@ -135,12 +135,6 @@ load_fragment_gperf_nulstr_c = custom_target(
         command : [awk, '-f', '@INPUT0@', '@INPUT1@'],
         capture : true)
 
-generate_builtin_units = files('generate-builtin-units.py')
