-    if not os.path.exists(exe):
-        logger.fatal("The path {} (from --python={}) does not exist".format(exe, orig_exe))
-        raise SystemExit(3)
-    if not is_executable(exe):
-        logger.fatal("The path {} (from --python={}) is not an executable file".format(exe, orig_exe))
-        raise SystemExit(3)
-    return exe
