#!/usr/bin/execlineb -P
envfile /etc/s6/sv/avahi-daemon-log/conf
importas -iu DIRECTIVES DIRECTIVES
foreground { if -n -t { test -d /var/log/avahi-daemon } install -d -m 0755 -o s6log -g s6log /var/log/avahi-daemon }
s6-setuidgid s6log exec -c sh -c "s6-log -d3 -b ${DIRECTIVES} /var/log/avahi-daemon"
