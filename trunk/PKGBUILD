conflicts=('init-exim')
depends=('exim' 's6-base')
backup=('etc/s6/sv/exim-log/conf')
install=exim.install
source=("exim-log.conf"
        "exim-log.consumer-for"
        "exim-log.notification-fd"
        "exim-log.pipeline-name"
        "exim-log.run"
        "exim-log.type"
        "exim-srv.producer-for"
        "exim-srv.run" 
        "exim-srv.type")
