# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=metalog-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for metalog"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('metalog-runscripts')
conflicts=('metalog-runscripts')
depends=('metalog' 's6')
install=metalog.install
source=("metalog.run" "metalog.type")
sha256sums=('2066699af173743213bd6fc5a89b9bac326a492b308fef41fbc67d55a9b4cab6'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'metalog'
}
