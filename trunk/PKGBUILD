# Maintainer: Dudemanguy <dudemanguy@artixlinux.org> 
pkgname=spice-vdagent-s6
pkgver=20210309
pkgrel=1
pkgdesc="s6-rc service scripts for spice-vdagent"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-s6"
groups=('s6-galaxy')
provides=('init-spice-vdagent')
conflicts=('init-spice-vdagent')
depends=('spice-vdagent' 's6-rc')
install=spice-vdagent.install
source=("spice-vdagentd.run" "spice-vdagentd.type")
sha256sums=('45719ac7cc80d0eade7eca935484ade3b474840b68691e3a5c5989b6af5d0fab'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'spice-vdagentd'
}
