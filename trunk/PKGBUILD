# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=s6-rc
pkgver=0.5.1.0
pkgrel=2
pkgdesc='A complete service manager for s6 systems.'
arch=('x86_64')
url='https://skarnet.org/software/s6-rc/'
license=('ISC')
provides=('init-kmod' 'init-opentmpfiles' 'init-opensysusers' 'kmod-s6')
conflicts=('init-kmod' 'init-opentmpfiles' 'init-opensysusers')
depends=('s6-linux-init' 'opentmpfiles' 'pam')
makedepends=('s6')
source=("https://skarnet.org/software/${pkgname}/${pkgname}-${pkgver}.tar.gz"
        "s6-rc-db-update-hook"
        "s6-rc-db-update.hook")
sha256sums=('93c02d0b505c036c332e13769154d82c9e31e4dd99f3ba80aa97d377ca9ac11c'
            'd85c10a6a5e61016887c20c77b4fa5d907703889f3f93595ee772b368f32b57d'
            '5b81cbdb739d11a12affa18e9637c9278780bc416cf6aa16489483d0f979d26d')

build() {
    cd ${pkgname}-${pkgver}
    ./configure --prefix=/usr \
                --datadir=/etc \
                --libexecdir=/usr/lib
    make
}

package() {
    cd ${pkgname}-${pkgver}
    mkdir -p "${pkgdir}"/etc/s6-rc
    mkdir -p "${pkgdir}"/etc/s6/sv
    make DESTDIR="${pkgdir}" install

    # pacman hooks
    mkdir -p "${pkgdir}"/usr/share/libalpm/scripts
    mkdir -p "${pkgdir}"/usr/share/libalpm/hooks
    install -Dm755 -t "${pkgdir}"/usr/share/libalpm/scripts ${srcdir}/*-hook
    install -Dm755 -t "${pkgdir}"/usr/share/libalpm/hooks ${srcdir}/*.hook
}
