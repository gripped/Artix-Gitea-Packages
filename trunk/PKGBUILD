pkgname=gitea-dinit
pkgver=20211101
pkgrel=1
pkgdesc="dinit service scripts for gitea"
arch=('any')
url="https://artixlinux.org"
license=('BSD')
groups=('dinit-galaxy')
depends=('gitea' 'dinit')
conflicts=('init-gitea')
provides=('init-gitea')
source=("gitea")
sha256sums=('7bb9e4caa6d7fbc791afe94509f4a91f4d80e4b341f03eec96c57c09b4b7454e')

package() {
    install -Dm644 gitea "$pkgdir/etc/dinit.d/gitea"
}
