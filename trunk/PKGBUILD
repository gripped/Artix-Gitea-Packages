package() {
  for _srv in haveged-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/haveged-srv/${_srv/haveged-srv./}
  done
  
  for _log in haveged-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/haveged-log/${_log/haveged-log./}
  done
}
