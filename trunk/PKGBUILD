# Maintainer: artoo <artoo@artixlinux.org>

pkgname=sddm-openrc
pkgver=20210106
pkgrel=2
pkgdesc="OpenRC sddm init script"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-openrc"
license=('GPL2')
groups=('openrc-world')
provides=('init-displaymanager')
depends=('sddm' 'openrc')
conflicts=('init-displaymanager')
source=("sddm.initd")
sha256sums=('b9b2099f52d948d47b48840276d5ac6b22180c79261d61412c091f9350004e37')

package() {
    install -Dm755 "$srcdir/sddm.initd" "$pkgdir/etc/init.d/sddm"
}
