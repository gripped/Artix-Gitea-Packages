package() {
  for _srv in nginx-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/nginx-srv/${_srv/nginx-srv./}
  done
  
  for _log in nginx-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/nginx-log/${_log/nginx-log./}
  done
}
