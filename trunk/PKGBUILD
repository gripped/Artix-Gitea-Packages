# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>

pkgname=xl2tpd-s6
pkgver=20191114
pkgrel=1
pkgdesc="s6 service scripts for xl2tpd"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('xl2tpd-runscripts')
conflicts=('xl2tpd-runscripts')
depends=('xl2tpd' 's6')
install=xl2tpd.install
source=("xl2tpd.run" "xl2tpd.type")
sha256sums=('190f7568fa71194d9d445e9c3616ab219e544b84ad2ded340fa0792293447ca0'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm755 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'xl2tpd'
}
