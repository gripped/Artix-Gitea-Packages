pkgname=bftpd-s6
pkgver=20210511
pkgrel=1
pkgdesc="s6-rc service scripts for bftpd"
arch=('any')
url="https://gitea.artixlinux.org/artix/s6-services"
groups=('s6-world')
provides=('init-bftpd')
conflicts=('init-bftpd')
depends=('bftpd' 's6-rc')
makedepends=('git')
source=("git+https://gitea.artixlinux.org/artix/s6-services.git")
sha256sums=('SKIP')

package() {
    cd "${srcdir}"/s6-services
    sh install.sh "bftpd" "${pkgdir}"
}
