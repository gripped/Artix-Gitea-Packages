pkgname=tlp-s6
pkgver=20200909
pkgrel=1
pkgdesc="s6 service scripts for tlp"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-s6"
groups=('s6-galaxy')
provides=('tlp-runscripts')
conflicts=('tlp-runscripts')
depends=('tlp' 's6')
source=("tlp.down" "tlp.type" "tlp.up")
sha256sums=('f87c38f58f4dbbfc1029d6d5d84c61f49286a6b83a064153e60bca7072e9eaef'
            'aab38fd7998987a22d44fda7822afcfa69d039d3ba02b1f707f064df64352217'
            '7524927461dd4492295d2afb80e5843a93aa1eb62d2b3945fae4d0e5b5f90934')

package() {
  for i in ${source[@]} ; do
    install -Dm644 "$i" "$pkgdir"/etc/s6/sv/tlp/${i/tlp./}
  done
}
