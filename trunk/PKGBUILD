package() {
  for _srv in vnstatd-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/vnstatd-srv/${_srv/vnstatd-srv./}
  done
  
  for _log in vnstatd-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/vnstatd-log/${_log/vnstatd-log./}
  done
}
