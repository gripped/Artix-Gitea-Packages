# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=freeradius-s6
pkgver=20210506
pkgrel=1
pkgdesc="s6-rc service scripts for freeradius"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-s6"
groups=('s6-galaxy')
provides=('init-freeradius')
conflicts=('init-freeradius')
depends=('freeradius' 's6-base')
install=freeradius.install
source=("radiusd.run" "radiusd.type")
sha256sums=('7e497671f2227993bbffc507174784f1b7934595cbd0686114992cc77a7b2b0d'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'radiusd'
}
