# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=dbus-s6
pkgver=20191027
pkgrel=1
pkgdesc="s6 service scripts for dbus"
arch=('any')
url="https://github.com/artix-linux"
depends=('dbus' 's6')
provides=('init-dbus')
conflicts=('init-dbus')
install=dbus.install
source=("dbus.run" "dbus.type")
sha256sums=('294c90e0aa0fd1b5291698a8cff0ec16fd8fa4d7a405ed252b92f5f570c01a37'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm755 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'dbus'
}
