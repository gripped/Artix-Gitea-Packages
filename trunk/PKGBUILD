depends=('spamassassin' 's6-base')
install=spamassassin.install
backup=('etc/s6/sv/spamassassin-log/conf')
source=("spamassassin-log.conf"
        "spamassassin-log.consumer-for"
        "spamassassin-log.notification-fd"
        "spamassassin-log.pipeline-name"
        "spamassassin-log.run"
        "spamassassin-log.type"
        "spamassassin-srv.producer-for"
        "spamassassin-srv.run"
        "spamassassin-srv.type")
