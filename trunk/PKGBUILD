# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>

pkgname=dovecot-s6
pkgver=20191103
pkgrel=1
pkgdesc="s6 service scripts for dovecot"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('dovecot-runscripts')
conflicts=('dovecot-runscripts')
depends=('dovecot' 's6')
install=dovecot.install
source=("dovecot.run" "dovecot.type")
sha256sums=('e45e58128139090f2cab0690d27c763f9ebdf3c58b1855f4a0cb9b68a20e7c2e'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm755 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'dovecot'
}
