# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=gdm-s6
pkgver=20210506
pkgrel=2
pkgdesc="s6-rc service scripts for gdm"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-s6"
groups=('s6-world')
provides=('init-gdm')
conflicts=('init-gdm')
depends=('gdm' 'elogind-s6' 's6-base')
install=gdm.install
source=("gdm.dependencies" "gdm.run" "gdm.type")
sha256sums=('ce701dc7ae4a337f063bbc8968585b5ae3c973b00b3283816d1f476c7b2f5b3b'
            '54ef74a6d6a0272b4c023f2bfb63f3b9194512226eb35fdacae8066c92f00e9d'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in dependencies run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'gdm'
}
