pkgname=tor-openrc
pkgver=20200529
pkgrel=1
pkgdesc="OpenRC tor init script"
arch=('any')
url="https://github.com/artix-linux/packages-galaxy"
license=('GPL2')
groups=('openrc-galaxy')
depends=('openrc' 'tor')
conflicts=('systemd-sysvcompat')
backup=('etc/conf.d/tor')
source=("tor.confd"
        "tor.initd")
sha256sums=('864d7ff6c8a6b06734c3f314365304c6ba8b3b893e8f29ed5f6fb9869e647b4b'
            '3b533a699f887102364fd222fdac9f626a18bd81b6913949c0a021e2e8246ef8')

_inst_initd(){
    install -Dm755 ${srcdir}/$1.initd ${pkgdir}/etc/init.d/$1
}

_inst_confd(){
    install -Dm755 ${srcdir}/$1.confd ${pkgdir}/etc/conf.d/$1
}

package() {
    _inst_confd 'tor'
    _inst_initd 'tor'
}
