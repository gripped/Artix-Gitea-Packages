# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=bluez-s6
pkgver=20191214
pkgrel=1
pkgdesc="s6 service scripts for bluez"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('bluez-runscripts')
conflicts=('bluez-runscripts')
depends=('bluez' 'dbus-s6' 's6')
install=bluetoothd.install
source=("bluetoothd.dependencies" "bluetoothd.run" "bluetoothd.type")
sha256sums=('9291726828590f8d9d158572c381e2cefc24adf21055036cba07585acc1abb62'
            'f863c2a58262a8a3676cfc8bb1c0efd2ccd1d47dfe08a8817a85d63e30217865'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in dependencies run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm755 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'bluetoothd'
}
