sha512sums_x86_64=('0b20327ac530cbcd00d27b84e8c2bce98977e1eaea378e4325e780a7285de998c33117470b23f96d917d04c0aed85f2387734408c52efa00a8b6bec7541b8927')
sha512sums_aarch64=('0b20327ac530cbcd00d27b84e8c2bce98977e1eaea378e4325e780a7285de998c33117470b23f96d917d04c0aed85f2387734408c52efa00a8b6bec7541b8927')
