# Maintainer: Nathan Owens <ndowens@artixlinux.org>
# Contributor: Patrick Ziegler <p.ziegler96@gmail.com>
pkgname=polybar
pkgver=3.6.1
pkgrel=1
pkgdesc="Fast and easy-to-use status bar"
arch=("x86_64")
url="https://github.com/polybar/polybar"
license=("MIT")
depends=("cairo" "xcb-util-image" "xcb-util-wm" "xcb-util-xrm" "xcb-util-cursor"
         "alsa-lib" "libpulse" "libmpdclient" "libnl" "jsoncpp" "curl" "libuv")
optdepends=("i3-wm: i3 module support"
            "ttf-unifont: Font used in example config"
            "siji-git: Font used in example config"
            "xorg-fonts-misc: Font used in example config")
makedepends=("cmake" "python" "pkg-config" "python-sphinx" "i3-wm" "git")
conflicts=("polybar-git")
install="${pkgname}.install"
source=("https://github.com/polybar/polybar/releases/download/${pkgver}/polybar-${pkgver}.tar.gz")
b2sums=('87cd05b235128834daacd5e48b7bba4d610c1018bbdc6280996d23314b4398a2c7322a425a047b55ad952c7a0e6a73c3076f57df6b4f7ab8fcdffcc0e40ef165')

prepare() {
  cd ${pkgname}-${pkgver}/lib
  rm -rf xpp i3ipcpp
  git init .
  git submodule add https://github.com/polybar/xpp.git
  git submodule add https://github.com/polybar/i3ipcpp.git
  git submodule update --init --recursive
}

build() {
  cd ${pkgname}-${pkgver}
  
  mkdir build
  
  cmake -B build \
	  -DCMAKE_INSTALL_PREFIX=/usr
  make -C build
}

package() {
  cd ${pkgname}-${pkgver}
  
  make -C build DESTDIR="${pkgdir}" install
  
  install -Dm644 LICENSE \
	  -t "${pkgdir}/usr/share/licenses/${pkgname}"
  
  mv "$pkgdir"/usr/share/doc/${pkgname}/{_sources/man/*.txt,man/polybar.1.html} \
	  "${pkgdir}/usr/share/doc/${pkgname}"
  
  rm -rf "${pkgdir}"/usr/share/doc/${pkgname}/man \
    "${pkgdir}"/usr/share/doc/${pkgname}/_sources/man
}
