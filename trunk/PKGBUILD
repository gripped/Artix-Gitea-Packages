# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>

pkgname=dropbear-s6
pkgver=20191211
pkgrel=1
pkgdesc="s6 service scripts for dropbear"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('dropbear-runscripts')
conflicts=('dropbear-runscripts')
depends=('dropbear' 's6')
install=dropbear.install
source=("dropbear.run" "dropbear.type")
sha256sums=('ae17ebff02594857265e281d4b640affe2de0662b746b03f46fbc1022f92a6c6'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm755 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'dropbear'
}
