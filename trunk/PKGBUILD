package() {
  for _srv in knotd-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/knotd-srv/${_srv/knotd-srv./}
  done
  
  for _log in knotd-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/knotd-log/${_log/knotd-log./}
  done
}
