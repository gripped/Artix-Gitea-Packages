# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=privoxy-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for privoxy"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('privoxy-runscripts')
conflicts=('privoxy-runscripts')
depends=('privoxy' 's6')
install=privoxy.install
source=("privoxy.run" "privoxy.type")
sha256sums=('023d1451e320bef0f5cbe6da271c2261a7c702132542974d4d5d9380e166a269'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'privoxy'
}
