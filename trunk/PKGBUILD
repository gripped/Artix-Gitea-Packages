# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=tor-s6
pkgver=20200727
pkgrel=1
pkgdesc="s6 service scripts for tor"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-s6"
groups=('s6-galaxy')
provides=('tor-runscripts')
conflicts=('tor-runscripts')
depends=('tor' 's6')
install=tor.install
source=("tor.run" "tor.type")
sha256sums=('119785eab093a3b2961e92549d7e50a49cd5d9d8ded4a4f1037650647011ae3c'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'tor'
}
