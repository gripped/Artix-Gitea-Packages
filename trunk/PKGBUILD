        "relaysrv-log.consumer-for"
        "relaysrv-log.notification-fd"
        "relaysrv-log.pipeline-name"
        "relaysrv-log.run"
        "relaysrv-log.type"
        "relaysrv-srv.producer-for"
        "relaysrv-srv.run"
        "relaysrv-srv.type")
