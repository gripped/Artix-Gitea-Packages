package() {
  for _srv in boinc-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/boinc-srv/${_srv/boinc-srv./}
  done
  
  for _log in boinc-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/boinc-log/${_log/boinc-log./}
  done
}
