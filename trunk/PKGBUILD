# Contributor: Chocobo1 <chocobo1 AT archlinux DOT net>

pkgname=mac
pkgver=6.61
_pkgver=661
pkgrel=0.2
pkgdesc='APE codec and decompressor'
arch=('x86_64')
url='https://www.monkeysaudio.com/index.html'
license=('custom')
depends=('gcc-libs')
makedepends=('curl')
source=("https://monkeysaudio.com/files/MAC_SDK_${_pkgver}.zip"
        "0001-Fix-CXXFLAGS.patch")
sha256sums=('62892fc25fafc7b72201c9502680bbabcaeb0ba5d5cde4b386b84e3077a60979'
            'd1856a5a9a693efa3c5d888a367f246fce0f65f25784455ba76717f7ee91cda4')

prepare() {
  cd "${srcdir}"
  patch -Np1 -i 0001-Fix-CXXFLAGS.patch
  curl --remote-name "https://www.monkeysaudio.com/license.html"
  ln -s "${srcdir}/Source/Projects/NonWindows/Makefile" "Makefile"
}

build() {
  cd "${srcdir}"
  make
}

package() {
  cd "${srcdir}"
  make DESTDIR="${pkgdir}" prefix="/usr" install
  install -Dm644 license.html \
      "${pkgdir}"/usr/share/licenses/${pkgname}/license.htm
}
