# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=iwd-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for iwd"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('iwd-runscripts')
conflicts=('iwd-runscripts')
depends=('iwd' 's6')
install=iwd.install
source=("iwd.run" "iwd.type")
sha256sums=('9054a2cbbca9ff05fcb41dd25dd98eedf5b958253ba7705694b8d8b27069d5f8'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'iwd'
}
