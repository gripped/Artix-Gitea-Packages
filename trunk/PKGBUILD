package() {
  for _srv in redis-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/redis-srv/${_srv/redis-srv./}
  done
  
  for _log in redis-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/redis-log/${_log/redis-log./}
  done
}
