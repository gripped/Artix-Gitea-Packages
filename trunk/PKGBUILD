# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=samba-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for samba"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('samba-runscripts')
conflicts=('samba-runscripts')
depends=('samba' 's6')
install=samba.install
source=("nmbd.run"
        "nmbd.type"
        "smbd.run"
        "smbd.type")
sha256sums=('317e6b722854d857a24bb859c461a89b1f25f8130fa86c67381c2f511f022a9e'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006'
            'c2bc1a6019d0791ab712e76c7c7478cd9307fbb117237d5c622dc79dac062ac0'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm755 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'nmbd'
    _inst_sv 'smbd'
}
