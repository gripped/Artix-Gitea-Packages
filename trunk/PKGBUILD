# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>

pkgname=tlp-s6
pkgver=20191114
pkgrel=1
pkgdesc="s6 service scripts for tlp"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('tlp-runscripts')
conflicts=('tlp-runscripts')
depends=('tlp' 's6')
source=("tlp.type" "tlp.up")
sha256sums=('aab38fd7998987a22d44fda7822afcfa69d039d3ba02b1f707f064df64352217'
            'cb88aee109c95f4dd010916357f4b8f03b0be6231dd7b85ab14c8ec8c5963458')

_inst_sv(){
    for file in type up; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm755 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'tlp'
}
