pkgname=metalog-s6
pkgver=20200611
pkgrel=1
pkgdesc="s6 service scripts for metalog"
arch=('any')
url="https://gitea.artixlinux.org/"
groups=('s6-world')
provides=('metalog-runscripts')
conflicts=('metalog-runscripts')
depends=('metalog' 's6')
install=metalog.install
backup=('etc/s6/sv/metalog-log/conf')
source=("metalog-log.conf"
        "metalog-log.consumer-for"
        "metalog-log.notification-fd"
        "metalog-log.pipeline-name"
        "metalog-log.run"
        "metalog-log.type"
        "metalog-srv.producer-for"
        "metalog-srv.run"
        "metalog-srv.type")
sha256sums=('8a3d2abcc40d355ca913f39871d24f6c770dd216fe075d2548e729b2ae952135'
