package() {
  for _srv in xl2tpd-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/xl2tpd-srv/${_srv/xl2tpd-srv./}
  done
  
  for _log in xl2tpd-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/xl2tpd-log/${_log/xl2tpd-log./}
  done
}
