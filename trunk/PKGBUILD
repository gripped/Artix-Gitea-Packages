package() {
  for _srv in fail2ban-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/fail2ban-srv/${_srv/fail2ban-srv./}
  done
  
  for _log in fail2ban-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/fail2ban-log/${_log/fail2ban-log./}
  done
}
