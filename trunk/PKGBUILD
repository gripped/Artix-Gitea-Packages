groups=('s6-galaxy')
provides=('init-distcc')
conflicts=('init-distcc')
depends=('distcc' 's6-rc')
backup=('etc/s6/sv/distcc-log/conf'
        'etc/s6/sv/distcc-srv/conf')
install=distcc.install
source=("distcc-log.conf"
        "distcc-log.consumer-for"
        "distcc-log.notification-fd"
        "distcc-log.pipeline-name"
        "distcc-log.run"
        "distcc-srv.conf"
        "distcc-log.type"
        "distcc-srv.producer-for"
        "distcc-srv.run" 
        "distcc-srv.type")
