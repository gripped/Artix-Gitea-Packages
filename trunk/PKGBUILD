# Maintainer: Nathan Owens <ndowens@artixlinux.org>
pkgname=nsd-openrc
pkgver=20200715
pkgrel=1
pkgdesc="${pkgname/-openrc/} OpenRC init"
arch=('any')
url="https://git.alpinelinux.org/aports/tree/main/nsd?h=master"
license=('GPL2')
groups=('openrc-galaxy')
depends=('openrc' 'nsd')
conflicts=('systemd-sysvcompat')
source=("${pkgname/-openrc/}.initd")
md5sums=('01d7ecb02aa0f677f8bcae3286f23ec8')

package() {
	install -Dm755 "$srcdir/nsd.initd" "$pkgdir/etc/init.d/nsd"
}
