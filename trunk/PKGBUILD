package() {
  for _srv in squid-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/squid-srv/${_srv/squid-srv./}
  done
  
  for _log in squid-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/squid-log/${_log/squid-log./}
  done
}
