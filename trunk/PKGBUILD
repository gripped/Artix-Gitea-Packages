# Maintainer: Dudemanguy <dudemanguy@artixlinux.org> 
# Contributer: Nathan Owens <ndowens@artixlinux.org> 
pkgname=bftpd-s6
pkgver=20200424
pkgrel=1
pkgdesc="s6 service scripts for bftpd"
arch=('any')
url="https://gitea.artixlinux.org"
groups=('s6-world')
provides=('bftpd-runscripts')
conflicts=('bftpd-runscripts')
depends=('bftpd' 's6')
install=bftpd.install
source=("bftpd.run" "bftpd.type")
sha256sums=('89eada7dffb470ff7c6eed56dab422757ca04437d001fdffbe0c8efaac609891'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'bftpd'
}
