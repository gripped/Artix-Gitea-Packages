package() {
  for _srv in svnserve-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/svnserve-srv/${_srv/svnserve-srv./}
  done
  
  for _log in svnserve-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/svnserve-log/${_log/svnserve-log./}
  done
}
