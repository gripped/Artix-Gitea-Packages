        "bluetoothd-log.consumer-for"
        "bluetoothd-log.notification-fd"
        "bluetoothd-log.pipeline-name"
        "bluetoothd-log.run"
        "bluetoothd-log.type"
        "bluetoothd-srv.dependencies"
        "bluetoothd-srv.producer-for"
        "bluetoothd-srv.run"
        "bluetoothd-srv.type")
