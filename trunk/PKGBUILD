# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgname=accounts-qml-module
pkgver=0.7
pkgrel=2.1
pkgdesc="Expose the Online Accounts API to QML applications"
url="https://gitlab.com/accounts-sso/accounts-qml-module"
arch=(x86_64)
license=(LGPL)
depends=(signond libaccounts-qt qt5-declarative)
makedepends=(qt5-tools)
source=("https://gitlab.com/accounts-sso/$pkgname/repository/archive.tar.gz?ref=VERSION_$pkgver"
        Build-add-qmltypes-file-to-repository.patch 
        Fix-compilation-with-Qt-5.13.patch)

prepare() {

  mkdir -p build
  cd accounts-qml-module-VERSION_0.7-cfadea7ba8ba4011ae20d771696eb74deb87201e
  patch -Np1 -i ../Fix-compilation-with-Qt-5.13.patch
  patch -Np1 -i ../Build-add-qmltypes-file-to-repository.patch 
}

build() {
  cd build 
  qmake-qt5 ../$pkgname-*/$pkgname.pro PREFIX=/usr
  make
}

package() {
  cd build
  make INSTALL_ROOT="$pkgdir" install_subtargets # skip docs
}

