pkgrel=1
pkgdesc="s6-rc service scripts for postfix"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-s6"
groups=('s6-world')
provides=('init-postfix')
conflicts=('init-postfix')
depends=('postfix' 's6-base')
backup=('etc/s6/sv/postfix-log/conf')
install=postfix.install
source=("postfix-log.conf"
        "postfix-log.consumer-for"
        "postfix-log.notification-fd"
        "postfix-log.pipeline-name"
        "postfix-log.run"
        "postfix-log.type"
        "postfix-srv.producer-for"
        "postfix-srv.run" 
        "postfix-srv.type")
sha256sums=('8a3d2abcc40d355ca913f39871d24f6c770dd216fe075d2548e729b2ae952135'
