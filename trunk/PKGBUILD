        "openntpd-log.consumer-for"
        "openntpd-log.notification-fd"
        "openntpd-log.pipeline-name"
        "openntpd-log.run"
        "openntpd-log.type"
        "openntpd-srv.producer-for"
        "openntpd-srv.run"
        "openntpd-srv.type")
