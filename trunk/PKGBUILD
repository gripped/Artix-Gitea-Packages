# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=git-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for git"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('git-runscripts')
conflicts=('git-runscripts')
depends=('git' 's6')
install=git-daemon.install
source=("git-daemon.run" "git-daemon.type")
sha256sums=('c7dd2100e3e5dffe9f4aebb0fc93e5f84dffadc96b67fbeedca0cc4363c919d2'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'git-daemon'
}
