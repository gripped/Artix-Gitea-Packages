pkgname=lxd-s6
pkgver=20200629
pkgrel=1
pkgdesc="s6 service scripts for lxd"
arch=('any')
url="https://gitea.artixlinux.org/"
groups=('s6-galaxy')
provides=('lxd-runscripts')
conflicts=('lxd-runscripts')
depends=('lxd' 'dbus-s6' 's6')
install=lxd.install
backup=('etc/s6/sv/lxd-log/conf')
source=("lxd-log.conf"
        "lxd-log.consumer-for"
        "lxd-log.notification-fd"
        "lxd-log.pipeline-name"
        "lxd-log.run"
        "lxd-log.type"
        "lxd-srv.producer-for"
        "lxd-srv.run"
        "lxd-srv.type")
sha256sums=('8a3d2abcc40d355ca913f39871d24f6c770dd216fe075d2548e729b2ae952135'
            'dff73a609599a0cc52ae0b76235364a8b81dea4f33bcb48c8220a55dbeede215'
            '1121cfccd5913f0a63fec40a6ffd44ea64f9dc135c66634ba001d10bcf4302a2'
            '5e81ec853b02bfb95e658766e7acd52fbd47165129ce4bfb543480b468ab4713'
            'd6206e93e363ec0400dce1dd53072291e54127e5ceed09dc790a9d5564515179'
