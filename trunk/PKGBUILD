# Maintainer: artoo <artoo@artixlinux.org>
# Contributor: williamh <williamh@gentoo.org>

pkgname=openrc-settingsd
pkgver=1.0.1
pkgrel=5
pkgdesc="System settings D-Bus service for OpenRC"
arch=('i686' 'x86_64')
url="http://www.gentoo.org/proj/en/base/openrc/"
license=('GPL')
groups=('openrc-world')
depends=('libdaemon' 'openrc' 'polkit' 'nss-myhostname')
makedepends=('python' 'automake')
conflicts=('systemd-sysvcompat')
backup=('etc/conf.d/openrc-settingsd')
source=("https://gitweb.gentoo.org/proj/openrc-settingsd.git/snapshot/${pkgname}-${pkgver}.tar.gz")
sha256sums=('671b3c4f450a3ed6ee47aa2da77bbf52369ed936f06197104832c3fca4b67452')

prepare() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    autoreconf -fi
}

build(){
    cd "${srcdir}/${pkgname}-${pkgver}"
    ./configure \
        --sysconfdir=/etc \
        --prefix=/usr \
        --libdir=/usr/lib \
        --libexecdir=/usr/lib \
        --datarootdir=/usr/share \
        --localstatedir=/var \
        --sbindir=/usr/bin \
        --with-pidfile=/run/openrc-settingsd.pid
    make
}

package() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    make DESTDIR="${pkgdir}" install

    sed -e 's|#!/sbin/runscript|#!/usr/bin/openrc-run|g' \
        -i ${pkgdir}/etc/init.d/openrc-settingsd

    install -Dm644 ${srcdir}/${pkgname}-${pkgver}/COPYING "$pkgdir/usr/share/licenses/${pkgname}/COPYING"
}
