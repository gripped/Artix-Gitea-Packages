pkgname=pptpd-dinit
pkgver=20211105
pkgrel=1
pkgdesc="dinit service scripts for pptpd"
arch=('any')
url="https://artixlinux.org"
license=('BSD')
groups=('dinit-galaxy')
depends=('pptpd' 'dinit')
conflicts=('init-pptpd')
provides=('init-pptpd')
source=("pptpd")
sha256sums=('e09f613f578542f5013a4d00bcc325b626ebe5af78c592cb3443b29a2caeb800')

package() {
    install -Dm644 pptpd "$pkgdir/etc/dinit.d/pptpd"
}
