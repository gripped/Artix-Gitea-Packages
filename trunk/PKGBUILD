pkgdesc="s6-rc service scripts for docker"
arch=('any')
url="https://gitea.artixlinux.org/artix/s6-services"
groups=('s6-galaxy')
provides=('init-docker')
conflicts=('init-docker')
depends=('docker' 's6-base')
