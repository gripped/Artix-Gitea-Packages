package() {
  for _srv in dnsmasq-srv.{type,run,producer-for,dependencies}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/dnsmasq-srv/${_srv/dnsmasq-srv./}
  done
  
  for _log in dnsmasq-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/dnsmasq-log/${_log/dnsmasq-log./}
  done
}
