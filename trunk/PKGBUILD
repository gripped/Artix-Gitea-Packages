groups=('s6-world')
provides=('init-modemmanager')
conflicts=('init-modemmanager')
depends=('modemmanager' 'dbus-s6' 's6-base')
install=ModemManager.install
backup=('etc/s6/sv/ModemManager-log/conf')
source=("ModemManager-log.conf"
        "ModemManager-log.consumer-for"
        "ModemManager-log.notification-fd"
        "ModemManager-log.pipeline-name"
        "ModemManager-log.run"
        "ModemManager-log.type"
        "ModemManager-srv.conf"
        "ModemManager-srv.dependencies"
        "ModemManager-srv.producer-for"
        "ModemManager-srv.run"
        "ModemManager-srv.type")
