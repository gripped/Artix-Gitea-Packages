pkgname=webhook-s6
pkgver=20210506
pkgrel=1
pkgdesc="s6-rc service scripts for webhook"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-s6"
groups=('s6-galaxy')
provides=('init-webhook')
conflicts=('init-webhook')
depends=('webhook' 's6-base')
install=webhook.install
backup=('etc/s6/sv/webhook-log/conf')
source=("webhook-log.conf"
        "webhook-log.consumer-for"
        "webhook-log.notification-fd"
        "webhook-log.pipeline-name"
        "webhook-log.run"
        "webhook-log.type"
        "webhook-srv.producer-for"
        "webhook-srv.run"
        "webhook-srv.type")
