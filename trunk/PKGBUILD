# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=clamav-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for clamav"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('clamav-runscripts')
conflicts=('clamav-runscripts')
depends=('clamav' 's6')
install=clamd.install
source=("clamd.run" "clamd.type")
sha256sums=('c05ba660d64f36649547263939e55595bfb06ea081675423cec7c7b93d050acc'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'clamd'
}
