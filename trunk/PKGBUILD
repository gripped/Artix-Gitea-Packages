package() {
  for _srv in dropbear-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/dropbear-srv/${_srv/dropbear-srv./}
  done
  
  for _log in dropbear-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/dropbear-log/${_log/dropbear-log./}
  done
}
