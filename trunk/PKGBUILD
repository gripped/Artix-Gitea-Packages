# Contributor: Adrián Pérez de Castro <aperez@igalia.com>

pkgname=lowdown
pkgdesc='Markdown translator producing HTML5 and roff documents in the ms and man formats'
pkgver=0.8.5
pkgrel=1
license=(ISC)
url=https://kristaps.bsd.lv/lowdown/
arch=(x86_64)
depends=(glibc libmd)
source=("https://kristaps.bsd.lv/lowdown/snapshots/${pkgname}-${pkgver}.tar.gz"
	      "add-strip-target.patch")
sha512sums=('5951175bfd7b0508d1a87e9a8156a22da9920025db5689f0d21427accf45e333cd1f9950f3f917868cfc8ecbb189364e88e8f5792936e2bb97daef8fbbcbbc1f'
            'd7c6c45fdc1e1a99f8a614343b255b404156959e8888b5c0eb40823ec7033bc9db3556bcd48bc7eb22855a90cea824967255f84a5bfdb8c6b7fa6513f9ae0cc9')

prepare() {
  cd "${pkgname}-${pkgver}"
  patch -Np1 -i ../add-strip-target.patch
}

build () {
  cd "${pkgname}-${pkgver}"
  ./configure PREFIX=/usr MANDIR=/usr/share/man
  
cat <<EOF >> Makefile.configure
CFLAGS += ${CFLAGS}
LDFLAGS += ${LDFLAGS}
EOF
  make
}

package () {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
  install -Dm644 LICENSE.md "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
