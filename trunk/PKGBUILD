# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=nvidia-utils-s6
pkgver=20210506
pkgrel=1
pkgdesc="s6-rc service scripts for nvidia-utils"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-s6"
groups=('s6-world')
provides=('init-nvidia-utils')
conflicts=('init-nvidia-utils')
depends=('nvidia-utils' 's6-base')
install=nvidia-utils.install
backup=('etc/s6/sv/nvidia-persistenced/conf')
source=("nvidia-persistenced.conf" "nvidia-persistenced.run" "nvidia-persistenced.type")
sha256sums=('65f66df5660c7496dbcb10b241d1bb2b6c3fbfa57364169bba88a6cb7067e3eb'
            '7cd4e9524e50562bfc3fee88345a5fc3a19a0ae30f4098725c92948714054319'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in conf run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'nvidia-persistenced'
}
