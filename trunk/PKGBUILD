# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=minidlna-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for minidlna"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('minidlna-runscripts')
conflicts=('minidlna-runscripts')
depends=('minidlna' 's6')
install=minidlnad.install
source=("minidlnad.run" "minidlnad.type")
sha256sums=('97ea3c96439f7ac398d55aaad92404b715b27f1f34208dfc324d0f9dd8c3e1c4'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'minidlnad'
}
