install=acpid.install
source=("acpid-log.conf"
        "acpid-log.consumer-for"
        "acpid-log.notification-fd"
        "acpid-log.pipeline-name"
        "acpid-log.run"
        "acpid-log.type"
        "acpid-srv.producer-for"
        "acpid-srv.run" 
        "acpid-srv.type")
