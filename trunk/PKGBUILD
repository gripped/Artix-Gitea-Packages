pkgname=spotifyd-s6
pkgver=20210506
pkgrel=1
pkgdesc="s6-rc service scripts for spotifyd"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-s6"
groups=('s6-galaxy')
provides=('init-spotifyd')
conflicts=('init-spotifyd')
depends=('spotifyd' 's6-base')
install=spotifyd.install
backup=('etc/s6/sv/spotifyd-log/conf')
source=("spotifyd-log.conf"
        "spotifyd-log.consumer-for"
        "spotifyd-log.notification-fd"
        "spotifyd-log.pipeline-name"
        "spotifyd-log.run"
        "spotifyd-log.type"
        "spotifyd-srv.producer-for"
        "spotifyd-srv.run"
        "spotifyd-srv.type")
sha256sums=('8a3d2abcc40d355ca913f39871d24f6c770dd216fe075d2548e729b2ae952135'
            '5fd65351fea96b61a875b3705aec0361abdfdc95a2151ec950ca9f3526276b95'
            '1121cfccd5913f0a63fec40a6ffd44ea64f9dc135c66634ba001d10bcf4302a2'
            '91e8d03e59740e278b763dede90daaf132eb19167fef6d577293b5abf047b514'
            '216385589065050a284e69b06582f6ee8ab6ec7d7f1563e61a922d03fd22ec0c'
