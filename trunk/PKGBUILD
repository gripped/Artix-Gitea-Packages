# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
# Contributor: artoo <artoo@artixlinux.org> 
pkgname=s6-base
pkgver=2.2
pkgrel=2
pkgdesc='Packages, hooks, and scripts to define a basic s6 init system implementation for Artix Linux.'
url='https://gitea.artixlinux.org/artix/alpm-hooks'
arch=('any')
license=('GPL')
depends=('s6' 's6-scripts' 's6-linux-init')
makedepends=('git')
install=s6-base.install
provides=('svc-manager' 'init-rc')
conflicts=('svc-manager' 'init-rc')
backup=('etc/s6/config/s6-rc-db-update.conf')
_commit=0d93c640ecd7724de8d5c4cfc60f644809117437
source=("git+https://gitea.artixlinux.org/artix/alpm-hooks.git#commit=$_commit")
sha256sums=('SKIP')

package() {
    cd "${srcdir}"/alpm-hooks
    DESTDIR="${pkgdir}" make install_s6

    # Default config for the s6-rc-db-update hook
    install -Dm644 /dev/stdin "${pkgdir}"/etc/s6/config/s6-rc-db-update.conf <<END
true
END
    install -v -d "${pkgdir}"/etc/s6/rc
    ln -sfv /usr/share/libalpm/scripts/s6-rc-db-update-hook "${pkgdir}"/usr/bin/s6-db-reload
}
