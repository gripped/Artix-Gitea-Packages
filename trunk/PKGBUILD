pkgdesc="s6 service scripts for syncthing"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-s6"
groups=('s6-galaxy')
provides=('syncthing-runscripts')
conflicts=('syncthing-runscripts')
depends=('syncthing' 's6')
backup=('etc/s6/sv/syncthing-log/conf'
        'etc/s6/sv/syncthing-srv/conf')
install=syncthing.install
source=("syncthing-log.conf"
        "syncthing-log.consumer-for"
        "syncthing-log.notification-fd"
        "syncthing-log.pipeline-name"
        "syncthing-log.run"
        "syncthing-log.type"
        "syncthing-srv.conf"
        "syncthing-srv.producer-for"
        "syncthing-srv.run" 
        "syncthing-srv.type")
