pkgname=libvirt-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for libvirt"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('libvirt-runscripts')
conflicts=('libvirt-runscripts')
depends=('libvirt' 'dbus-s6' 's6')
install=libvirt.install
source=("libvirtd.dependencies"
        "libvirtd.run"
        "libvirtd.type"
        "virtlockd.run"
        "virtlockd.type"
        "virtlogd.dependencies"
        "virtlogd.run"
        "virtlogd.type")
