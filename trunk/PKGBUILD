# Maintainer: Jan de Groot <jgc@archlinux.org>

pkgname=libvdpau
pkgver=1.4
pkgrel=1
pkgdesc="Nvidia VDPAU library"
arch=(x86_64)
url='https://www.freedesktop.org/wiki/Software/VDPAU/'
depends=('libxext')
license=('custom')
_commit=c3d1a9dbafdfe6144ff474d0d523dc01b068750f # 1.4
source=("https://gitlab.freedesktop.org/vdpau/libvdpau/-/archive/${pkgver}/libvdpau-${pkgver}.tar.gz")
makedepends=('xorgproto' 'meson')
sha256sums=('240dd8f9ec08de707529917677827ba12e13b9fc299eeb3af13ea05e7fc74aba')

build() {
   arch-meson "$pkgname-$pkgver" build
  ninja -C build
}

check() {
  ninja -C build test
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install
  install -Dm 644 "$pkgname-$pkgver"/COPYING -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
