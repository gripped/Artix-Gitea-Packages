# Contributor: Giovanni Scafora <giovanni@archlinux.org>
# Contributor: Nezmer <Nezmer@gmail.com>

pkgname=lib32-fribidi
pkgver=1.0.13
pkgrel=1
pkgdesc="A Free Implementation of the Unicode Bidirectional Algorithm (32-bit)"
url="https://github.com/fribidi/fribidi/"
arch=(x86_64)
license=(LGPL)
depends=(
  fribidi
  lib32-glibc
)
makedepends=(
  git
  meson
)
provides=(libfribidi.so)
_commit=b54871c339dabb7434718da3fed2fa63320997e5  # tags/v1.0.13^0
source=("git+https://github.com/fribidi/fribidi#commit=$_commit")
b2sums=('SKIP')

pkgver() {
  cd fribidi
  git describe --tags | sed 's/^v//;s/[^-]*-g/r&/;s/-/+/g'
}

prepare() {
  cd fribidi
}

build() {
  local meson_options=(
    --libdir=/usr/lib32
    -D docs=false
  )

  export CC="gcc -m32"
  export CXX="g++ -m32"
  export PKG_CONFIG="i686-pc-linux-gnu-pkg-config"

  artix-meson fribidi build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  rm -r "$pkgdir"/usr/{bin,include}
}

