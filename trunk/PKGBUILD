# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=at-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for at"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('at-runscripts')
conflicts=('at-runscripts')
depends=('at' 's6')
install=at.install
source=("at.run" "at.type")
sha256sums=('659818825294c2b513b9f6b29f622fbc065f72432b94a79f220888aeed62cb7e'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'at'
}
