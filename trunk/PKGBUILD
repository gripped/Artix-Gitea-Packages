pkgname=nfs-utils-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for nfs-utils"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-system')
provides=('init-nfs-utils')
conflicts=('init-nfs-utils')
depends=('nfs-utils' 'device-mapper-s6' 'rpcbind-s6' 's6')
install=nfs-utils.install
source=("nfs-server.dependencies"
        "nfs-server.finish"
        "nfs-server.run"
        "nfs-server.type"
        "statd.dependencies"
        "statd.run"
        "statd.type")
sha256sums=('8fba6bc7497a82526bf4c678820099dcc93d4af4c98fe0266fcf369e942b82f1'
            '5c276abc526c36c3b89808a86a458cc0a698ae71d4e1121dcd57b494f02865c9'
            '92aa557749421a638d97b5c67173ebb153ac5ed477083ca985399d44a508e806'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006'
            '1a90a45be95bdc12904e7a4f09b610bbbc73aa7cd2b9450db8a76af3a449ea7d'
            '20398c5a674de419c6b2889cc874b8d7ce498ad65f8ade6cb486b216150ccc0a'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in dependencies finish run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'statd'
    _inst_sv 'nfs-server'
}
