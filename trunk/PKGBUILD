package() {
  for _srv in pdnsd-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/pdnsd-srv/${_srv/pdnsd-srv./}
  done
  
  for _log in pdnsd-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/pdnsd-log/${_log/pdnsd-log./}
  done
}
