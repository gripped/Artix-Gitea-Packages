package() {
  for _srv in consul-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/consul-srv/${_srv/consul-srv./}
  done
  
  for _log in consul-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/consul-log/${_log/consul-log./}
  done
}
