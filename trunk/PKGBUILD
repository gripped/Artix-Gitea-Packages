package() {
  for _srv in avahi-daemon-srv.{type,run,producer-for,dependencies}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/avahi-daemon-srv/${_srv/avahi-daemon-srv./}
  done
  
  for _log in avahi-daemon-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/avahi-daemon-log/${_log/avahi-daemon-log./}
  done
}
