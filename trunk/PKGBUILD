# Maintainer: Artoo <artoo@artixlinux.org>

pkgname=('seatd' 'libseat')
pkgbase=seatd
pkgver=0.5.0
pkgrel=1
pkgdesc="Seat management daemon and library"
arch=('x86_64')
url="https://git.sr.ht/~kennylevinsen/seatd"
license=('GPL')
makedepends=('glibc' 'elogind' 'meson' 'scdoc')
source=(${pkgbase}-${pkgver}.tar.gz::https://git.sr.ht/~kennylevinsen/$pkgbase/archive/$pkgver.tar.gz)
md5sums=('264a36907f4be34efa400fb6e1b26f5f')

build() {
    local _meson_options=(
        -Dlogind=enabled
        -Dman-pages=auto
    )

    arch-meson "$pkgbase-$pkgver" build "${_meson_options[@]}"

    ninja -C build
}

check() {
    meson test -C build
}

package_seatd() {
    pkgdesc="Seat management daemon"
    depends=('glibc' 'libseat' 'libelogind')
    provides=('elogind' 'logind')
    conflicts=('elogind')

    DESTDIR="${pkgdir}" meson install -C build

    install -dm0755 "${srcdir}"/_libseat
    mv -v "${pkgdir}"/usr/lib/libseat*.* "${srcdir}"/_libseat

}

package_libseat() {
    pkgdesc="Seat management library"
    provides=('libseat.so')

    install -dm0755 "${pkgdir}"/usr/lib
    mv -v "${srcdir}"/_libseat/libseat*.* "${pkgdir}"/usr/lib
}
