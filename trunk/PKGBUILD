# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=nginx-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for nginx"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('nginx-runscripts')
conflicts=('nginx-runscripts')
depends=('nginx' 's6')
install=nginx.install
source=("nginx.run" "nginx.type")
sha256sums=('a7fd0be0aa46f0f3a2fe2b14412709fe652de96296746d2ad9408255c31398b2'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'nginx'
}
