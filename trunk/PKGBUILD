# Maintainer: Christian Rebischke <chris.rebischke@archlinux.org>

pkgname=iwd
pkgver=0.21
pkgrel=1
pkgdesc='Internet Wireless Daemon'
arch=('x86_64')
url='https://git.kernel.org/cgit/network/wireless/iwd.git/'
license=('LGPL')
depends=('glibc' 'dbus')
source=("https://www.kernel.org/pub/linux/network/wireless/iwd-${pkgver}.tar"{.xz,.sign})
validpgpkeys=('E932D120BC2AEC444E558F0106CA9F5D1DCF2659')
install=iwd.install

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
	./configure --prefix=/usr \
	--sysconfdir=/etc \
	--libexecdir=/usr/lib/iwd \
  --enable-wired \
  --localstatedir=/var \
  --disable-systemd-service
  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make install DESTDIR="${pkgdir}"

# This fixes #62874: include docs and autotests file for easier configuration
  install -Dm644 "doc/iwmon.txt" "${pkgdir}/usr/share/iwd/doc/iwmon.txt"
  install -Dm644 "doc/main.conf" "${pkgdir}/usr/share/iwd/doc/main.conf"
}

# vim: set ts=2 sw=2 ft=sh noet:
sha256sums=('fb15a390cb1a6ffbf3c45fbc5ed1f1e565be2677d23cad117b168f1828edaa70'
            'SKIP')
