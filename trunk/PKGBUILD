# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=syncthing-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for syncthing"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('syncthing-runscripts')
conflicts=('syncthing-runscripts')
depends=('syncthing' 's6')
install=syncthing.install
source=("syncthing.run" "syncthing.type")
sha256sums=('016a5d8995aae71e94608099a3659df53366895718a150f5c62238237bd63bc0'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'syncthing'
}
