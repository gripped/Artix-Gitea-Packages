pkgname=extra-cmake-modules
pkgver=5.82.0
pkgrel=1
pkgdesc='Extra modules and scripts for CMake'
arch=(any)
url='https://community.kde.org/Frameworks'
license=(LGPL)
depends=(cmake)
makedepends=(python-sphinx python-requests qt5-tools)
groups=(kf5)
source=(https://download.kde.org/stable/frameworks/${pkgver%.*}/$pkgname-$pkgver.tar.xz{,.sig}
        ECM-no-init.py.patch 
        artix.patch)
sha512sums=('a8c8d1d15718760de42238b121ed1294d12d36f1ef25acdd2542f12a56d5091a5cc0135884b6c97e62123d64fc80e2756dccd32c88b65caaf6e86418bae4217f'
            'SKIP'
            'e3d7cc9f969e6a88717cf5532b4c7e5a85ba30eddc31dda4167fbb0a9c2bf28ea652f0ca3af0adbcc583820ea5f23af93d71ca14c1edb3fe52da501755d1fee7'
            '0e91d9b25e30123280945c9bfdf25b9dcbcbf61efdf5f91e32efcbbf5c6d91ccb3d69058ccbe8472cca15822d274534b9f3fe5c640b6f412d9049ae480986fa6')

validpgpkeys=(53E6B47B45CEA3E0D5B7457758D0EE648A48B3BB) # David Faure <faure@kde.org>

prepare() {
  patch -d $pkgname-$pkgver -p1 -i ../ECM-no-init.py.patch # Don't create __init__.py

  # Artix stuff - don't delete it!
  patch -d $pkgname-$pkgver -Np1 -i ../artix.patch
}

build() {
  cmake -B build -S $pkgname-$pkgver \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_HTML_DOCS=OFF \
    -DBUILD_QTHELP_DOCS=ON

  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
