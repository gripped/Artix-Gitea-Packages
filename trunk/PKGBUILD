pkgname=colord-s6
pkgver=20200727
pkgrel=2
pkgdesc="s6 service scripts for colord"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-s6"
groups=('s6-world')
provides=('colord-runscripts')
conflicts=('colord-runscripts')
depends=('colord' 'dbus-s6' 's6')
install=colord.install
source=("colord-session.dependencies"
        "colord-session.run"
        "colord-session.type"
        "colord.dependencies"
        "colord.run"
        "colord.type")
sha256sums=('9291726828590f8d9d158572c381e2cefc24adf21055036cba07585acc1abb62'
            'c6ef17c1a8310968540ad6cb25ad0d83d12e2f2c64657e1c89df6fd80ae2c5fd'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006'
            '9291726828590f8d9d158572c381e2cefc24adf21055036cba07585acc1abb62'
            'ed7eead1e549845f68764f626c95489063b8f32f39dc6f06c4463af2b5c99f90'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in dependencies run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'colord'
    _inst_sv 'colord-session'
}
