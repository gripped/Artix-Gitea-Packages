pkgname=lxd-dinit
pkgver=20211102
pkgrel=1
pkgdesc="dinit service scripts for lxd"
arch=('any')
url="https://artixlinux.org"
license=('BSD')
groups=('dinit-galaxy')
depends=('lxd' 'dinit')
conflicts=('init-lxd')
provides=('init-lxd')
source=("lxd")
sha256sums=('75aac4d2d4ba42c05601ebdc1e637b57233cb60c241bdb58ce714fb3f826f551')

package() {
    install -Dm644 lxd "$pkgdir/etc/dinit.d/lxd"
}
