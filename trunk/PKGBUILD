pkgname=iso-profiles
pkgver=0.51
pkgrel=1
pkgdesc='Artix iso profiles'
arch=('any')
license=('GPL')
url='https://gitea.artixlinux.org/artix/iso-profiles'
makedepends=('git')
_commit=317378612d3ceabec02c947f1b4e3dc3577630db # git/tag 0.51
source=("git+$url.git#commit=$_commit")
sha256sums=('SKIP')

