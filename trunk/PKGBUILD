provides=('init-motion')
conflicts=('init-motion')
depends=('motion' 's6-base')
backup=('etc/s6/sv/motion-log/conf')
install=motion.install
source=("motion-log.conf"
        "motion-log.consumer-for"
        "motion-log.notification-fd"
        "motion-log.pipeline-name"
        "motion-log.run"
        "motion-log.type"
        "motion-srv.producer-for"
        "motion-srv.run" 
        "motion-srv.type")
