# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=haveged-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for haveged"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('init-haveged')
conflicts=('init-haveged')
depends=('haveged' 's6')
install=haveged.install
source=("haveged.run" "haveged.type")
sha256sums=('df6f0e9a604a107157d85d05f75bbad21bd726a3649f240f53c31b65d57ffaf5'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'haveged'
}
