package() {
  for _srv in doh-server-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/doh-server-srv/${_srv/doh-server-srv./}
  done
  
  for _log in doh-server-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/doh-server-log/${_log/doh-server-log./}
  done
  
  for _dsrv in doh-client-srv.{type,run,producer-for}; do
    install -Dm644 "$_dsrv" "$pkgdir"/etc/s6/sv/doh-client-srv/${_dsrv/doh-client-srv./}
  done
  
  for _dlog in doh-client-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_dlog" "$pkgdir"/etc/s6/sv/doh-client-log/${_dlog/doh-client-log./}
  done
}
