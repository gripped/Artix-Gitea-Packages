# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=php-fpm-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for php-fpm"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('php-fpm-runscripts')
conflicts=('php-fpm-runscripts')
depends=('php-fpm' 's6')
install=php-fpm.install
source=("php-fpm.run" "php-fpm.type")
sha256sums=('6e4fe7c3916ba9efd38dca8cc09167e14def8fcfed9e6742cf83397f0d43e11a'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'php-fpm'
}
