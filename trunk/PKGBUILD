package() {
  for _srv in mpd-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/mpd-srv/${_srv/mpd-srv./}
  done
  
  for _log in mpd-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/mpd-log/${_log/mpd-log./}
  done
}
