package() {
  for _srv in unbound-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/unbound-srv/${_srv/unbound-srv./}
  done
  
  for _log in unbound-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/unbound-log/${_log/unbound-log./}
  done
}
