package() {
  for _srv in radicale-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/radicale-srv/${_srv/radicale-srv./}
  done
  
  for _log in radicale-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/radicale-log/${_log/radicale-log./}
  done
}
