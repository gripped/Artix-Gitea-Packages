# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=pcsclite-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for pcsclite"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('pcsclite-runscripts')
conflicts=('pcsclite-runscripts')
depends=('pcsclite' 's6')
install=pcscd.install
source=("pcscd.run" "pcscd.type")
sha256sums=('5164031234686e44a4eaad37ea1c98cd2b857eb94e693b363ea0b1feaa8d1caf'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'pcscd'
}
