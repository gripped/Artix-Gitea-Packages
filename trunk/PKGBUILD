package() {
  for _srv in minidlnad-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/minidlnad-srv/${_srv/minidlnad-srv./}
  done
  
  for _log in minidlnad-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/minidlnad-log/${_log/minidlnad-log./}
  done
}
