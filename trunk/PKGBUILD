# Maintainer: nous <nous@artixlinux.org>
# Maintainer: artoo <artoo@artixlinux.org>

_pkgbase=desktop-presets

pkgname=artix-gtk-presets
pkgver=0.8+33+g1871c60
pkgrel=1
pkgdesc='Artix GTK presets'
arch=('any')
url="https://gitea.artixlinux.org/artix/desktop-presets"
license=('GPL')
provides=('desktop-presets')
depends=('artix-desktop-presets')
optdepends=('qt5-styleplugins' 'qt5ct')
conflicts=('artix-lxde-presets' 'artix-mate-presets')
#replaces=('artix-lxde-presets' 'artix-mate-presets')
makedepends=('git')
_commit=20aac6948d099ebf0c4a8705ca20fef5502edbd0
source=("git+$url.git#commit=${_commit}")
sha256sums=('SKIP')

pkgver() {
    cd ${_pkgbase}
    git describe --tags | sed 's/-/+/g'
}

_inst_dir(){
    cd ${_pkgbase} #-${pkgver}
    git checkout refactor
    local profile="$1"

    install -d ${pkgdir}/etc
    cp -vr $profile/skel ${pkgdir}/etc

    if [[ -d $profile/schemas ]];then
        install -d ${pkgdir}/usr/share/glib-2.0/schemas
        cp -v $profile/schemas/* ${pkgdir}/usr/share/glib-2.0/schemas
    fi

    if [[ -d $profile/dconf ]];then
        install -d ${pkgdir}/etc/dconf
        cp -vr $profile/dconf/* ${pkgdir}/etc/dconf
    fi

    if [[ -d $profile/scripts ]];then
        install -d ${pkgdir}/usr/bin
        cp -v $profile/scripts/* ${pkgdir}/usr/bin
    fi
}

package() {
    _inst_dir 'gtk'
}
