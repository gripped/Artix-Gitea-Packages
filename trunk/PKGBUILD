# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=lirc-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for lirc"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('lirc-runscripts')
conflicts=('lirc-runscripts')
depends=('lirc' 's6')
install=lircd.install
source=("lircd.run" "lircd.type")
sha256sums=('dbd04bff4edc6508fe319d351954286c4799b438a88f3134bf58ea9c75b5ebc3'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'lircd'
}
