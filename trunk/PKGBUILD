package() {
  for _srv in iwd-srv.{type,run,dependencies,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/iwd-srv/${_srv/iwd-srv./}
  done
  
  for _log in iwd-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/iwd-log/${_log/iwd-log./}
  done
}
