pkgname=grafana-s6
pkgver=20201005
pkgrel=1.1
pkgdesc="s6 service scripts for grafana"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-s6"
groups=('s6-galaxy')
provides=('grafana-runscripts')
conflicts=('grafana-runscripts')
depends=('grafana' 'mysql-s6' 'postgresql-s6' 's6')
backup=('etc/s6/sv/grafana-log/conf')
install=grafana.install
source=("grafana-log.conf"
        "grafana-log.consumer-for"
        "grafana-log.notification-fd"
        "grafana-log.pipeline-name"
        "grafana-log.run"
        "grafana-log.type"
        "grafana-srv.producer-for"
        "grafana-srv.run" 
        "grafana-srv.dependencies"
        "grafana-srv.type")
sha256sums=('8a3d2abcc40d355ca913f39871d24f6c770dd216fe075d2548e729b2ae952135'
