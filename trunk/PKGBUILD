# Contributor: Nathan Owens <ndowens@artixlinux.org>
pkgname=ejabberd-openrc
pkgver=20200524
pkgrel=1.1
pkgdesc="${pkgname/-openrc/} OpenRC init"
arch=('any')
url="https://gitea.artixlinux.org/PackagesE/ejabberd-openrc"
license=('GPL2')
groups=('openrc-galaxy')
depends=('openrc' 'ejabberd')
conflicts=('systemd-sysvcompat')
backup=("etc/conf.d/${pkgname/-openrc/}")
source=("ejabberd.confd"
	"ejabberd.initd")
md5sums=('fa61d30731cb4d818187d2e5e2fd766a'
         '82b5dce60046a49560aff0157677152b')

_inst_initd(){
    install -Dm755 ${srcdir}/$1.initd ${pkgdir}/etc/init.d/$1
}

_inst_confd(){
    install -Dm755 ${srcdir}/$1.confd ${pkgdir}/etc/conf.d/$1
}

package() {
    _inst_confd "${pkgname/-openrc/}"
    _inst_initd "${pkgname/-openrc/}"
}
