# Contributor: Alexandre Filgueira <alexfilgueira@antergos.com>

pkgname=cinnamon-menus
pkgver=4.6.0
pkgrel=1
pkgdesc="Cinnamon menu specifications"
arch=('x86_64')
url="https://github.com/linuxmint/${pkgname}"
license=('GPL' 'LGPL')
depends=('glib2')
makedepends=('gobject-introspection' 'meson')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/${pkgver}.tar.gz")
sha256sums=('5c380048051869cdb0a92b5f2f7857c77b067706e1c80a1f2b5e12ffe057a696')
b2sums=('7b7ea31fd68b3af4501295c10035e2022d61451dfa87badf249dbf274fb12c20e800fff41eecb063b9088f38b5ecdcee1f714ab26c1d67e276100e4317245a13')

build() {
    mkdir -p "${srcdir}"/${pkgname}-${pkgver}/build
    cd "${srcdir}"/${pkgname}-${pkgver}/build

    meson --prefix=/usr \
          --buildtype=plain \
          ..
    ninja
}

package(){
    cd "${srcdir}"/${pkgname}-${pkgver}/build

    DESTDIR="${pkgdir}" ninja install
}
