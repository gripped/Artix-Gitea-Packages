package() {
  for _srv in rngd-srv.{type,run,producer-for}; do
    install -Dm644 "$_srv" "$pkgdir"/etc/s6/sv/rngd-srv/${_srv/rngd-srv./}
  done
  
  for _log in rngd-log.{type,run,consumer-for,notification-fd,pipeline-name,conf}; do
    install -Dm644 "$_log" "$pkgdir"/etc/s6/sv/rngd-log/${_log/rngd-log./}
  done
}
