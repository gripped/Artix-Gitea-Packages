# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=lightdm-s6
pkgver=20191105
pkgrel=1
pkgdesc="s6 service scripts for lightdm"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('lightdm-runscripts')
conflicts=('lightdm-runscripts')
depends=('lightdm' 'dbus-s6' 's6')
install=lightdm.install
source=("lightdm.dependencies" "lightdm.run" "lightdm.type")
sha256sums=('9291726828590f8d9d158572c381e2cefc24adf21055036cba07585acc1abb62'
            '95143e0e038f5aa4cea6aeae48f64ee0462bf5ae849410b1962bf5e5dcf20a92'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm755 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'lightdm'
}
