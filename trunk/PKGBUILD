# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>

pkgname=ddclient-s6
pkgver=20191103
pkgrel=1
pkgdesc="s6 service scripts for ddclient"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('ddclient-runscripts')
conflicts=('ddclient-runscripts')
depends=('ddclient' 's6')
install=ddclient.install
source=("ddclient.run" "ddclient.type")
sha256sums=('763a88d6ff8aaa6a5814517e60de30ab94f48388e4a690480088f8c2bc525291'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm755 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'ddclient'
}
