pkgver=20210506
pkgrel=1
pkgdesc="s6-rc service scripts for firewalld"
arch=('any')
url="https://gitea.artixlinux.org/artixlinux/packages-s6"
groups=('s6-galaxy')
provides=('init-firewalld')
conflicts=('init-firewalld')
depends=('firewalld' 'dbus-s6' 's6-base')
install=firewalld.install
backup=('etc/s6/sv/firewalld-log/conf')
source=("firewalld-log.conf"
        "firewalld-log.consumer-for"
        "firewalld-log.notification-fd"
        "firewalld-log.pipeline-name"
        "firewalld-log.run"
        "firewalld-log.type"
        "firewalld-srv.dependencies"
        "firewalld-srv.producer-for"
        "firewalld-srv.run"
        "firewalld-srv.type")
