pkgname=openldap-s6
pkgver=20200611
pkgrel=1
pkgdesc="s6 service scripts for openldap"
arch=('any')
url="https://gitea.artixlinux.org/"
groups=('s6-system')
provides=('init-openldap')
conflicts=('init-openldap')
depends=('openldap' 's6')
install=slapd.install
backup=('etc/s6/sv/slapd-log/conf')
source=("slapd-log.conf"
        "slapd-log.consumer-for"
        "slapd-log.notification-fd"
        "slapd-log.pipeline-name"
        "slapd-log.run"
        "slapd-log.type"
        "slapd-srv.producer-for"
        "slapd-srv.run"
        "slapd-srv.type")
sha256sums=('8a3d2abcc40d355ca913f39871d24f6c770dd216fe075d2548e729b2ae952135'
            'e4f27669d658f43b7d377286f63f03895410b959260b356190884b527597a4d3'
            '1121cfccd5913f0a63fec40a6ffd44ea64f9dc135c66634ba001d10bcf4302a2'
            '4e40f9c43a69fd83638301e276ac19f124e377e20d9da22d5343eb26a75af7cb'
            '9dac99148505f07ec6e11446a3d0e2ba780edf2efee38384d7634ee6ab6a1d09'
