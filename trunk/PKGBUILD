# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=openssh-s6
pkgver=20191029
pkgrel=2
pkgdesc="s6 service scripts for openssh"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-system')
provides=('init-openssh')
conflicts=('init-openssh')
depends=('openssh' 's6')
install=sshd.install
source=("sshd.run" "sshd.type")
sha256sums=('693311530238a57b5b4ac4e6de56b6f9cf5bd255ffd8adc61dd5db9a354e3cbf'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm755 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'sshd'
}
