pkgname=fcgiwrap-s6
pkgver=20200629
pkgrel=1
pkgdesc="s6 service scripts for fcgiwrap"
arch=('any')
url="https://gitea.artixlinux.org"
groups=('s6-galaxy')
provides=('fcgiwrap-runscripts')
conflicts=('fcgiwrap-runscripts')
depends=('fcgiwrap' 's6')
install=fcgiwrap.install
backup=('etc/s6/sv/fcgiwrap-log/conf')
source=("fcgiwrap-log.conf"
        "fcgiwrap-log.consumer-for"
        "fcgiwrap-log.notification-fd"
        "fcgiwrap-log.pipeline-name"
        "fcgiwrap-log.run"
        "fcgiwrap-log.type"
        "fcgiwrap-srv.finish"
        "fcgiwrap-srv.producer-for"
        "fcgiwrap-srv.run"
        "fcgiwrap-srv.type")
