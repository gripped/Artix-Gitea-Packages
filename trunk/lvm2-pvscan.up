#!/usr/bin/execlineb -P
envfile /etc/s6/s6.conf
importas -iu DIRECTIVE DIRECTIVE
backtick -n ARGS { pipeline { echo $DIRECTIVE } sed "s/_/ /g" }
importas -iu ARGS ARGS
foreground { s6-setuidgid s6log mkdir -p /var/log/lvm2-pvscan }
pipeline { fdmove -c 2 1 pvscan --cache --activate ay } s6-setuidgid s6log sh -c "s6-log -b ${ARGS} /var/log/lvm2-pvscan"
