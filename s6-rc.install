#!/bin/sh

post_upgrade() {
  if [ "$(vercmp 0.7.0.0 $2)" -lt 0 ]; then
    echo "Major upgrade of s6-rc to 0.7.x"
    echo "The s6-rc database will be recompiled and then upgraded to the new format."
    s6 set commit -f
    PATH=$(find /etc/s6/repo/compiled -type d -name ".current*")
    s6-rc-format-upgrade ${PATH}
    s6 live install
  fi
}
