From: =?UTF-8?q?Ball=C3=B3=20Gy=C3=B6rgy?= <ballogyor@gmail.com>
Date: Tue, 13 Oct 2026 03:16:39 +0200
Subject: [PATCH] mouse: Move drag-and-drop and double-click settings to a
 separate tab

Move the Drag and Drop and Double Click sections to a new Behavior
tab to reduce the vertical space required by the Mouse tab.

This allows the preferences dialog to fit on a standard 1024x768
display.
---
 capplets/mouse/mate-mouse-properties.c  |    2 +-
 capplets/mouse/mate-mouse-properties.ui | 1211 ++++++++++++-----------
 2 files changed, 619 insertions(+), 594 deletions(-)

diff --git a/capplets/mouse/mate-mouse-properties.c b/capplets/mouse/mate-mouse-properties.c
index 15e812925..d4a80e573 100644
--- a/capplets/mouse/mate-mouse-properties.c
+++ b/capplets/mouse/mate-mouse-properties.c
@@ -321,7 +321,7 @@ setup_dialog (GtkBuilder *dialog)
 
 	/* Trackpad page */
 	if (touchpad_is_present () == FALSE)
-		gtk_notebook_remove_page (GTK_NOTEBOOK (gtk_builder_get_object (dialog, "prefs_widget")), -1);
+		gtk_notebook_remove_page (GTK_NOTEBOOK (gtk_builder_get_object (dialog, "prefs_widget")), 1);
 	else {
 		g_settings_bind (touchpad_settings, "touchpad-enabled",
 		                 gtk_builder_get_object (dialog, "touchpad_enable"), "active",
