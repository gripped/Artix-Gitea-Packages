diff --git a/patches/plasma-systemmonitor/03-insert_prepare.sh b/patches/plasma-systemmonitor/03-insert_prepare.sh
new file mode 100755
index 0000000..d8a9fe8
--- /dev/null
+++ b/patches/plasma-systemmonitor/03-insert_prepare.sh
@@ -0,0 +1,20 @@
+#!/bin/sh
+
+if [ $# -eq 0 ]; then
+	printf >&2 'usage: %s [repo...]' "$0"
+	exit 1
+fi
+
+for arg; do
+	sed -i -n \
+		-e '/^build() *{/{' -e 'r/dev/fd/3' -e 'n' -e '}' \
+		-e p \
+		"$arg/PKGBUILD" 3<<-\EOF || exit
+prepare() {
+  cd "$pkgname-$pkgver"
+  patch -p1 < "$srcdir/replace-unsupported-applications-view-with-processes.patch"
+}
+
+build() {
+	EOF
+done
diff --git a/patches/plasma-systemmonitor/env.txt b/patches/plasma-systemmonitor/env.txt
new file mode 100644
index 0000000..c1b03fa
--- /dev/null
+++ b/patches/plasma-systemmonitor/env.txt
@@ -0,0 +1 @@
