Subject: [PATCH] replace systemd-only module in plasma-systemmonitor

---
 .../00-remove-duplicate-src.sh                | 10 ++++++++++
 patches/plasma-systemmonitor/01-add-source.pl |  1 +
 patches/plasma-systemmonitor/02-updpkgsums.sh |  1 +
 .../plasma-systemmonitor/03-insert_prepare.sh | 20 +++++++++++++++++++
 patches/plasma-systemmonitor/env.txt          |  1 +
 5 files changed, 33 insertions(+)
 create mode 100755 patches/plasma-systemmonitor/00-remove-duplicate-src.sh
 create mode 120000 patches/plasma-systemmonitor/01-add-source.pl
 create mode 120000 patches/plasma-systemmonitor/02-updpkgsums.sh
 create mode 100755 patches/plasma-systemmonitor/03-insert_prepare.sh
 create mode 100644 patches/plasma-systemmonitor/env.txt

diff --git a/patches/plasma-systemmonitor/00-remove-duplicate-src.sh b/patches/plasma-systemmonitor/00-remove-duplicate-src.sh
new file mode 100755
index 0000000..104a344
--- /dev/null
+++ b/patches/plasma-systemmonitor/00-remove-duplicate-src.sh
@@ -0,0 +1,10 @@
+#!/bin/sh
+
+if [ $# -eq 0 ]; then
+	printf >&2 'usage: %s [repo...]' "$0"
+fi
+
+for arg; do
+	awk '!/^source=/ || seen == 1; /^source=/ { seen++ }' "$arg/PKGBUILD" > "$arg/PKGBUILD.new"
+	mv -f "$arg/PKGBUILD.new" "$arg/PKGBUILD"
+done
