From 63db76b92582f25f70649a7b7374c85489d4da5d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ball=C3=B3=20Gy=C3=B6rgy?= <ballogyor@gmail.com>
Date: Sat, 24 Oct 2026 03:26:51 +0200
Subject: [PATCH] Don't use gtk_show_about_dialog

gtk_show_about_dialog() sets its values only on first invocation, and
cannot be used to display the about dialog with different content.

This fixes the problem that wrong content is shown, when the about dialog
is opened from multiple applets, and the applets are built as in-process.
---
 applets/clock/clock.c                |  6 +++++-
 applets/fish/fish.c                  |  5 ++++-
 applets/notification_area/main.c     |  6 +++++-
 applets/wncklet/showdesktop.c        | 10 +++++-----
 applets/wncklet/window-list.c        | 10 +++++-----
 applets/wncklet/window-menu.c        | 10 +++++-----
 applets/wncklet/workspace-switcher.c | 10 +++++-----
 7 files changed, 34 insertions(+), 23 deletions(-)

diff --git a/applets/clock/clock.c b/applets/clock/clock.c
index 0c104f316..f4b9580c8 100644
--- a/applets/clock/clock.c
+++ b/applets/clock/clock.c
@@ -3687,7 +3687,7 @@ static void display_about_dialog(GtkAction* action, ClockData* cd)
                 NULL
         };
 
-        gtk_show_about_dialog(NULL,
+	GtkWidget *about = g_object_new (GTK_TYPE_ABOUT_DIALOG,
                 "program-name", _("Clock"),
                 "title", _("About Clock"),
                 "authors", authors,
@@ -3700,6 +3700,10 @@ static void display_about_dialog(GtkAction* action, ClockData* cd)
                 "version", VERSION,
                 "website", PACKAGE_URL,
                 NULL);
+
+	g_signal_connect_swapped (about, "response",
+	                          G_CALLBACK (gtk_widget_destroy), about);
+	gtk_widget_show (about);
 }
 
 static gboolean
diff --git a/applets/fish/fish.c b/applets/fish/fish.c
index a72ff5e49..0f326f833 100644
--- a/applets/fish/fish.c
+++ b/applets/fish/fish.c
@@ -549,7 +549,7 @@ static void display_about_dialog(GtkAction* action, FishApplet* fish)
 
 	descr = g_strdup_printf(about_format, fish->name);
 
-	gtk_show_about_dialog(NULL,
+	GtkWidget *about = g_object_new (GTK_TYPE_ABOUT_DIALOG,
 		"program-name", _("Fish"),
 		"title", _("About Fish"),
 		"authors", authors,
@@ -564,6 +564,9 @@ static void display_about_dialog(GtkAction* action, FishApplet* fish)
 		"website", PACKAGE_URL,
 		NULL);
 
+	g_signal_connect_swapped (about, "response",
+	                          G_CALLBACK (gtk_widget_destroy), about);
+	gtk_widget_show (about);
 	g_free(descr);
 	g_free(authors[0]);
 }
