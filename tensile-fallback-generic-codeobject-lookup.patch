+        // Map a specific AMDGPU architecture name (e.g. "gfx1152") to its
+        // generic-family name (e.g. "gfx11-generic"), or return an empty
+        // string if no generic family exists for the given arch.
+        //
+        // The set of generic families here matches AMDGPU LLVM's
+        // --offload-arch=<family>-generic targets: gfx9-generic,
+        // gfx9-4-generic, gfx10-1-generic, gfx10-3-generic, gfx11-generic
+        // and gfx12-generic. See
+        // https://llvm.org/docs/AMDGPUUsage.html#processors.
+        // Kept in sync with rocblas_internal_get_generic_arch_name() in
+        // library/src/rocblas_auxiliary.cpp.
+        static std::string genericFamilyFor(std::string const& arch)
+        {
+            static const std::unordered_map<std::string, std::string> kArchToGeneric = {
+                {"gfx900",  "gfx9-generic"},    {"gfx902",  "gfx9-generic"},
+                {"gfx904",  "gfx9-generic"},    {"gfx906",  "gfx9-generic"},
+                {"gfx908",  "gfx9-generic"},    {"gfx909",  "gfx9-generic"},
+                {"gfx90a",  "gfx9-generic"},    {"gfx90c",  "gfx9-generic"},
+                {"gfx940",  "gfx9-4-generic"},  {"gfx941",  "gfx9-4-generic"},
+                {"gfx942",  "gfx9-4-generic"},  {"gfx950",  "gfx9-4-generic"},
+                {"gfx1010", "gfx10-1-generic"}, {"gfx1011", "gfx10-1-generic"},
+                {"gfx1012", "gfx10-1-generic"}, {"gfx1013", "gfx10-1-generic"},
+                {"gfx1030", "gfx10-3-generic"}, {"gfx1031", "gfx10-3-generic"},
+                {"gfx1032", "gfx10-3-generic"}, {"gfx1033", "gfx10-3-generic"},
+                {"gfx1034", "gfx10-3-generic"}, {"gfx1035", "gfx10-3-generic"},
+                {"gfx1036", "gfx10-3-generic"}, {"gfx1037", "gfx10-3-generic"},
+                {"gfx1100", "gfx11-generic"},   {"gfx1101", "gfx11-generic"},
+                {"gfx1102", "gfx11-generic"},   {"gfx1103", "gfx11-generic"},
+                {"gfx1150", "gfx11-generic"},   {"gfx1151", "gfx11-generic"},
+                {"gfx1152", "gfx11-generic"},   {"gfx1153", "gfx11-generic"},
+                {"gfx1200", "gfx12-generic"},   {"gfx1201", "gfx12-generic"},
+                {"gfx1250", "gfx12-generic"},
+            };
+            auto it = kArchToGeneric.find(arch);
+            return it == kArchToGeneric.end() ? std::string() : it->second;
+        }
+
+        // Given a code-object filename of the form
+        //   <basename>_fallback_<arch>[<xnack>].hsaco  (per-solution kernels)
+        // or
+        //   Kernels.so-000-<arch>[<xnack>].hsaco       (initializeLazyLoading)
+        // return the same filename with <arch> replaced by its generic
+        // family, or an empty string if <arch> has no generic family or the
+        // filename doesn't match one of these shapes. archMarker selects the
+        // shape by naming the substring that immediately precedes <arch>.
+        static std::string coFilenameForGenericFamily(std::string const& coFile,
+                                                      std::string const& archMarker)
+        {
+            auto archPos = coFile.rfind(archMarker);
+            if(archPos == std::string::npos)
+                return {};
+            archPos += archMarker.length();
+            auto archEnd = coFile.find_first_of(".-", archPos);
+            if(archEnd == std::string::npos)
+                return {};
+            std::string generic = genericFamilyFor(coFile.substr(archPos, archEnd - archPos));
+            if(generic.empty())
+                return {};
+            return coFile.substr(0, archPos) + generic + coFile.substr(archEnd);
+        }
+
         hipError_t SolutionAdapter::loadCodeObjectFile(std::string const& path)
         {
