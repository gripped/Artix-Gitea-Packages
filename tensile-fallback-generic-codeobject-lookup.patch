@@ -297,7 +379,7 @@
                 {
                     //Try other xnack versions
                     size_t     loc = kernel.codeObjectFile.rfind('.');
-                    hipError_t err;
+                    hipError_t err = hipErrorFileNotFound;
 
                     for(auto ver : {"", "-xnack-", "-xnack+"})
                     {
@@ -308,6 +390,36 @@
                         if(err == hipSuccess)
                             break;
                     }
+
+                    // If none of the xnack variants of the arch-specific
+                    // fallback code object are present, retry the load with
+                    // the generic-family variant of the same filename. This
+                    // is the load-time counterpart of the top-level generic
+                    // library discovery in tensile_host.cpp: without it, a
+                    // build that ships only e.g. gfx11-generic (and no native
+                    // gfx1100/1101/1150-1153) fails every Sgemm/Dgemm call on
+                    // gfx1152 hardware with HIPBLAS_STATUS_INTERNAL_ERROR
+                    // because Tensile constructs the fallback filename from
+                    // the runtime device arch (gfx1152) rather than the arch
+                    // of the code object HIP actually loaded (gfx11-generic).
+                    if(err != hipSuccess)
+                    {
+                        std::string genericCOFile
+                            = coFilenameForGenericFamily(kernel.codeObjectFile, "_fallback_");
+                        if(!genericCOFile.empty())
+                        {
+                            size_t gloc = genericCOFile.rfind('.');
+                            for(auto ver : {"", "-xnack-", "-xnack+"})
+                            {
+                                std::string modifiedCOName = genericCOFile;
+                                modifiedCOName.insert(gloc, ver);
+                                err = loadCodeObjectFile(codeObjectDir + modifiedCOName);
+
+                                if(err == hipSuccess)
+                                    break;
+                            }
+                        }
+                    }
                 }
             }
 
