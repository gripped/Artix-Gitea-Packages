#!/usr/bin/openrc-run

supervisor=supervise-daemon

name="DHCP Client Daemon"
description="DHCP Client Daemon"

command=/usr/bin/dhcpcd
command_args_foreground="-B"
command_args="-q ${command_args:-}"

depend() {
    provide net
    need localmount
    use logger network
    after bootmisc modules
    before dns
}
