# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=dbus-s6
pkgver=20191027
pkgrel=2
pkgdesc="s6 service scripts for dbus"
arch=('any')
url="https://github.com/artix-linux"
depends=('dbus' 's6')
provides=('init-dbus')
conflicts=('init-dbus')
install=dbus.install
source=("dbus.run" "dbus.type")
sha256sums=('f202debc5936e8ad75cf10d9be36dfde430d3db85e4b9eaacd1bf16d57075cc0'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm755 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'dbus'
}
