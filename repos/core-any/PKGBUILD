# Maintainer: artoo <artoo@artixlinux.org>

pkgname=cronie-openrc
pkgver=20191014
pkgrel=1
pkgdesc="OpenRC cronie init script"
arch=('any')
url="https://github.com/artix-linux/packages"
license=('GPL2')
groups=('openrc-system')
depends=('openrc' 'cronie')
provides=('openrc-cron' 'init-cron')
conflicts=('fcron' 'fcron-openrc' 'init-cron')
backup=('etc/init.d/cronie')
source=('cronie.initd'
        '80-cronie.hook')
sha256sums=('e1ce0b87768dfc00cf2de040d65e504a8695bf0f31f1e0ec0e17b8bcfe779408'
            '2f23d0a73bd6e5f250e43bf3f1e0b218026f268959fadc7ec78c346951cd2725')

package() {
    install -Dm755 "${srcdir}"/cronie.initd "${pkgdir}"/etc/init.d/cronie
    install -Dt "${pkgdir}"/usr/share/libalpm/hooks -m644 *.hook
}
