# Maintainer: artoo <artoo@artixlinux.org>

pkgname=dbus-openrc
pkgver=20190813
pkgrel=1
pkgdesc="OpenRC dbus init script"
arch=('any')
url="https://github.com/artix-linux/packages"
license=('GPL2')
provides=('init-dbus')
depends=('dbus')
conflicts=('init-dbus')
source=('dbus.initd'
        'dbus-reload.hook')
sha256sums=('9964aa935b4a7d64f5970bcfcd561b06013a85ae2712444bc4c5f644364dab3b'
            '1335a86bb5eb68614bf13af314f1a7f5f6f68253584986e9c5b492a4585ab722')

package() {
    install -Dm755 ${srcdir}/dbus.initd ${pkgdir}/etc/init.d/dbus

    install -d "${pkgdir}/etc/runlevels/default"
    ln -sf "/etc/init.d/dbus" "${pkgdir}/etc/runlevels/default/dbus"

    install -Dt "$pkgdir/usr/share/libalpm/hooks" -m644 *.hook
}
