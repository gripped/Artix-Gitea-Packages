provides=('init-device-mapper')
conflicts=('init-device-mapper')
depends=('device-mapper' 's6')
install=dmeventd.install
backup=('etc/s6/sv/dmeventd-log/conf')
source=("dmeventd-log.conf"
        "dmeventd-log.consumer-for"
        "dmeventd-log.notification-fd"
        "dmeventd-log.pipeline-name"
        "dmeventd-log.run"
        "dmeventd-log.type"
        "dmeventd-srv.producer-for"
        "dmeventd-srv.run"
        "dmeventd-srv.type")
