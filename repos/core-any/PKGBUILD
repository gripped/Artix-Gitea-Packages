pkgname=openssh-s6
pkgver=20200611
pkgrel=1
pkgdesc="s6 service scripts for openssh"
arch=('any')
url="https://gitea.artixlinux.org/"
groups=('s6-system')
provides=('init-openssh')
conflicts=('init-openssh')
depends=('openssh' 's6')
install=sshd.install
backup=('etc/s6/sv/sshd-log/conf')
source=("sshd-log.conf"
        "sshd-log.consumer-for"
        "sshd-log.notification-fd"
        "sshd-log.pipeline-name"
        "sshd-log.run"
        "sshd-log.type"
        "sshd-srv.producer-for"
        "sshd-srv.run"
        "sshd-srv.type")
