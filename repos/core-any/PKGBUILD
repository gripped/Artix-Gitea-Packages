# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=xinetd-s6
pkgver=20191114
pkgrel=1
pkgdesc="s6 service scripts for xinetd"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-system')
provides=('init-xinetd')
conflicts=('init-xinetd')
depends=('xinetd' 's6')
install=xinetd.install
source=("xinetd.run" "xinetd.type")
sha256sums=('06180e568738497e774ea51bb41828be463740b45a50c1b48bcb42af783d2f2f'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm755 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'xinetd'
}
