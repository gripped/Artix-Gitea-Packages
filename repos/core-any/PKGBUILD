pkgname=dhcpcd-s6
pkgver=20200125
pkgrel=1
pkgdesc="s6 service scripts for dhcpcd"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-system')
provides=('init-dhcpcd')
conflicts=('init-dhcpcd')
depends=('dhcpcd' 's6')
install=dhcpcd.install
backup=('etc/s6/sv/dhcpcd-log/conf')
source=('dhcpcd-log.conf'
        'dhcpcd-log.consumer-for'
        'dhcpcd-log.notification-fd'
        'dhcpcd-log.pipeline-name'
        'dhcpcd-log.run'
        'dhcpcd-log.type'
        'dhcpcd-srv.dependencies'
        'dhcpcd-srv.producer-for'
        'dhcpcd-srv.run'
        'dhcpcd-srv.type')
sha256sums=('7bd1fe2c69a7aab98655c7600e958d8fdb5d0e39603c2e0cef2eb3c0434eb51c'
            '06fbf21500208014b1a98458b584fd6481eafd450dfad96541bad35d166efd61'
            '1121cfccd5913f0a63fec40a6ffd44ea64f9dc135c66634ba001d10bcf4302a2'
            'cad66f7d0124437f9038f3191ed73c43c6e9b6509a55b7e9104acc6cf6f93188'
            'beb3b52ad0784ddcaaf01d67f50027f47e3b40be4b7387c54b996e9c9f6fe4ab'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006'
            'a3b24db57bba15f8cee6d540099647d90b9dfd683cfc9a6c9431dc3f8e0a0f85'
