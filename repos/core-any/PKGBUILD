# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=openldap-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for openldap"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-system')
provides=('init-openldap')
conflicts=('init-openldap')
depends=('openldap' 's6')
install=slapd.install
source=("slapd.run" "slapd.type")
sha256sums=('f786b3ebf7de2ecedbce67d6d6cef527f496ec3986166e57a76b82280dfeb633'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'slapd'
}
