pkgname=elogind-s6
pkgver=20200611
pkgrel=1
pkgdesc="s6 service scripts for elogind"
arch=('any')
url="https://gitea.artixlinux.org/"
depends=('elogind' 'dbus-s6' 's6')
provides=('init-elogind')
conflicts=('init-elogind')
install=elogind.install
backup=('etc/s6/sv/elogind-log/conf')
source=("elogind-log.conf"
        "elogind-log.consumer-for"
        "elogind-log.notification-fd"
        "elogind-log.pipeline-name"
        "elogind-log.run"
        "elogind-log.type"
        "elogind-srv.dependencies"
        "elogind-srv.producer-for"
        "elogind-srv.run"
        "elogind-srv.type")
sha256sums=('8a3d2abcc40d355ca913f39871d24f6c770dd216fe075d2548e729b2ae952135'
            '9029a131cb5197da6ed6b58650cdcdb633193df141085fa10ef8e60dc5c665f6'
            '1121cfccd5913f0a63fec40a6ffd44ea64f9dc135c66634ba001d10bcf4302a2'
            'd150375e1adf4cab68cb3978b5222f4ea2af46919a55c4e3c8533f80fbaaff43'
            '85a2e7eece0ae13aa582467bb7e4923f5409be02af16b1730cb2d48cb53b003d'
