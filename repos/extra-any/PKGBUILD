# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=sane-s6
pkgver=20191114
pkgrel=1
pkgdesc="s6 service scripts for sane"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('sane-runscripts')
conflicts=('sane-runscripts')
depends=('sane' 's6')
install=sane.install
source=("saned.run" "saned.type")
sha256sums=('1ef693f94ab014e6a0c2f00d531c540bc3841a537dbce9bedcc34c20a7d2d544'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm755 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'saned'
}
