# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=ntp-s6
pkgver=20191029
pkgrel=1
pkgdesc="s6 service scripts for ntp"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('ntp-runscripts')
conflicts=('ntp-runscripts')
depends=('ntp' 's6')
install=ntpd.install
source=("ntpd.run" "ntpd.type")
sha256sums=('16025e285dce5686fcdd1a7bf3d3448ba06ae990ea025120d2eea51cf1a42354'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm755 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'ntpd'
}
