# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=mpd-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for mpd"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('mpd-runscripts')
conflicts=('mpd-runscripts')
depends=('mpd' 's6')
install=mpd.install
source=("mpd.run" "mpd.type")
sha256sums=('21a07d36b992f95ee87405dd6732648b3e91d7617fa0acfbbb79917b38e941c9'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'mpd'
}
