# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=avahi-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for avahi"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('avahi-runscripts')
conflicts=('avahi-runscripts')
depends=('avahi' 'dbus-s6' 's6')
install=avahi-daemon.install
source=("avahi-daemon.dependencies" "avahi-daemon.run" "avahi-daemon.type")
sha256sums=('9291726828590f8d9d158572c381e2cefc24adf21055036cba07585acc1abb62'
            '164c2e8da7ff8f4de0bfeb4ae8be93cae1e0bbf06f4088b84d877cb2ea713ee9'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in dependencies run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'avahi-daemon'
}
