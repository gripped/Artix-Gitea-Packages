# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=apache-s6
pkgver=20191030
pkgrel=1
pkgdesc="s6 service scripts for apache"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('apache-runscripts')
conflicts=('apache-runscripts')
depends=('apache' 's6')
install=apache.install
source=("apache.finish" "apache.run" "apache.type")
sha256sums=('85aefe713ca944c263b153593a0e9ba40264af2c9289a284499440be58519ad8'
            '43edb86352703e05a06411a4f618c66b5c44a4880877bf14e77869d7c8d013ee'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in finish run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm755 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'apache'
}
