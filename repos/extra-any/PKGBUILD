# Maintainer: artoo <artoo@artixlinux.org>

pkgname=iso-profiles
pkgver=0.9.4
pkgrel=1
pkgdesc='Artix iso profiles'
arch=('any')
license=('GPL')
url='https://gitea.artixlinux.org/artix/iso-profiles'
makedepends=('git')
conflicts=('artix-iso-profiles')
source=("${pkgname}-${pkgver}.tar.gz::$url/archive/${pkgver}.tar.gz")
sha256sums=('519cf9d3ed4f9857b38691b84f882d2f3a4f310826c9b2cc3eb02a10ed570b05')

package() {
    cd ${pkgname}
    install -d ${pkgdir}/usr/share/artools/iso-profiles
    cp -a {base,lxqt,linexa} ${pkgdir}/usr/share/artools/iso-profiles
}
