# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=brltty-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for brltty"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('brltty-runscripts')
conflicts=('brltty-runscripts')
depends=('brltty' 's6')
install=brltty.install
source=("brltty.run" "brltty.type")
sha256sums=('aa2edf89093e58243d570eba3d3fe47644cc3e0e6516cf4034d3508b12cdbad9'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in finish run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'brltty'
}
