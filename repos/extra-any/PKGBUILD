# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=postfix-s6
pkgver=20191107
pkgrel=1
pkgdesc="s6 service scripts for postfix"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('postfix-runscripts')
conflicts=('postfix-runscripts')
depends=('postfix' 's6')
install=postfix.install
source=("postfix.run" "postfix.type")
sha256sums=('7a17fe0c9624b613caf3666449069e33d5148b493e031004f3df29894d303345'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm755 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'postfix'
}
