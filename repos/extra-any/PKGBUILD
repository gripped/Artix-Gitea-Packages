# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=haveged-s6
pkgver=20191028
pkgrel=1
pkgdesc="s6 service scripts for haveged"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('init-haveged')
conflicts=('init-haveged')
depends=('haveged' 's6')
install=haveged.install
source=("haveged.run" "haveged.type")
sha256sums=('94ccf6598d332a9984db05083b46def2239b0e5218637c883065710b3d51c9c6'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm755 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'haveged'
}
