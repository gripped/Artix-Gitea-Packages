# Maintainer: Dudemanguy <random342@airmail.cc>
pkgname=syslog-ng-s6
pkgver=20191027
pkgrel=2
pkgdesc="s6 service scripts for syslog-ng"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('syslog-ng-runscripts' 'init-syslog-ng')
conflicts=('syslog-ng-runscripts' 'init-syslog-ng')
depends=('syslog-ng' 's6')
install=syslog-ng.install
source=("syslog-ng.run" "syslog-ng.type")
sha256sums=('75f147f64c1bcb62e4e57c0448cd5368e20c861df323685457310e8aa858274f'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm755 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'syslog-ng'
}
