#!/usr/bin/openrc-run

command="/usr/bin/wg-quick"
command_args="up ${WIREGUARD_INTERFACE}"
required_files="/etc/wireguard/${WIREGUARD_INTERFACE}.conf"

depend() {
	need localmount
	use dns net
	provide vpn ipsec
	keyword -shutdown
}

stop() {
	# Remove interface as it is more reliable
	ebegin "Stopping ${SVCNAME}"
	ip link delete "${WIREGUARD_INTERFACE}"
	eend $?
}

