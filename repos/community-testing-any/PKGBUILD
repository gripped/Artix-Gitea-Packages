pkgname=sndio-s6
pkgver=20200610
pkgrel=1
pkgdesc="s6 service scripts for sndio"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('sndio-runscripts')
conflicts=('sndio-runscripts')
depends=('sndio' 's6')
install=sndio.install
backup=('etc/s6/sv/sndiod-log/conf')
source=("sndiod-log.conf"
        "sndiod-log.consumer-for"
        "sndiod-log.notification-fd"
        "sndiod-log.pipeline-name"
        "sndiod-log.run"
        "sndiod-log.type"
        "sndiod-srv.producer-for"
        "sndiod-srv.run"
        "sndiod-srv.type")
sha256sums=('8a3d2abcc40d355ca913f39871d24f6c770dd216fe075d2548e729b2ae952135'
