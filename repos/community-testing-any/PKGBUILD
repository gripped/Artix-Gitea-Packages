license=(GPL)
groups=('s6-galaxy')
provides=('trojan-runscripts')
conflicts=('trojan-runscripts')
depends=('trojan' 's6')
install=trojan.install
backup=('etc/s6/sv/trojan-log/conf')
source=("trojan-srv.run"
        "trojan-srv.type"
        "trojan-srv.producer-for"
        "trojan-log.run"
        "trojan-log.type"
        "trojan-log.consumer-for"
        "trojan-log.pipeline-name"
        "trojan-log.notification-fd"
        "trojan-log.conf")
