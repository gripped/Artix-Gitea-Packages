pkgname=connman-s6
pkgver=20200610
pkgrel=1
pkgdesc="s6 service scripts for connman"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('connman-runscripts')
conflicts=('connman-runscripts')
depends=('connman' 'dbus-s6' 's6')
install=connmand.install
backup=('etc/s6/sv/connmand-log/conf')
source=("connmand-log.conf"
        "connmand-log.consumer-for"
        "connmand-log.notification-fd"
        "connmand-log.pipeline-name"
        "connmand-log.run"
        "connmand-log.type"
        "connmand-srv.dependencies"
        "connmand-srv.producer-for"
        "connmand-srv.run"
        "connmand-srv.type")
