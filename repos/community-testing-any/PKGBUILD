pkgname=unrealircd-s6
pkgver=20200408
pkgrel=1
pkgdesc="s6 service scripts for unrealircd"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('unrealircd-runscripts')
conflicts=('unrealircd-runscripts')
depends=('unrealircd' 's6')
install=unrealircd.install
backup=('etc/s6/sv/unrealircd-log/conf')
source=("unrealircd-log.conf"
        "unrealircd-log.consumer-for"
        "unrealircd-log.notification-fd"
        "unrealircd-log.pipeline-name"
        "unrealircd-log.run"
        "unrealircd-log.type"
        "unrealircd-srv.producer-for"
        "unrealircd-srv.run"
        "unrealircd-srv.type")
sha256sums=('7bd1fe2c69a7aab98655c7600e958d8fdb5d0e39603c2e0cef2eb3c0434eb51c'
