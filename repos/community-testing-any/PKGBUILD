# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>

pkgname=connman-s6
pkgver=20191102
pkgrel=1
pkgdesc="s6 service scripts for connman"
arch=('any')
url="https://github.com/artix-linux"
groups=('galaxy-s6')
provides=('connman-runscripts')
conflicts=('connman-runscripts')
depends=('connman' 's6')
install=connmand.install
source=("connmand.run" "connmand.type")
sha256sums=('9d1c1f1ad35fba40b01767c20b9149c36a3d131632866f7a54d738e51dd0f1c3'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm755 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'connmand'
}
