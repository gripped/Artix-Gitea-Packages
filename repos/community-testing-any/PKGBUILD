# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>

pkgname=connman-s6
pkgver=20200108
pkgrel=1
pkgdesc="s6 service scripts for connman"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('connman-runscripts')
conflicts=('connman-runscripts')
depends=('connman' 'dbus-s6' 's6')
install=connmand.install
source=("connmand.dependencies" "connmand.run" "connmand.type")
sha256sums=('9291726828590f8d9d158572c381e2cefc24adf21055036cba07585acc1abb62'
            '5ed195a90d18e5f3000e7363529e4801545e8965065e40e8da7955418236c74b'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in dependencies run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'connmand'
}
