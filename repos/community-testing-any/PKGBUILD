# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>

pkgname=jenkins-s6
pkgver=20191104
pkgrel=1
pkgdesc="s6 service scripts for jenkins"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('jenkins-runscripts')
conflicts=('jenkins-runscripts')
depends=('jenkins' 's6')
install=jenkins.install
source=("jenkins.run" "jenkins.type")
sha256sums=('c744970a89e4ee1238de5f912bc80b323ef3df2ceb0a4315da5d1bbbc42bb846'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm755 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'jenkins'
}
