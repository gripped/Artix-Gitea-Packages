#!/usr/bin/execlineb -P
envfile /etc/s6/sv/connmand-log/conf
importas -iu DIRECTIVE DIRECTIVE
backtick -n ARGS { pipeline { echo $DIRECTIVE } sed "s/_/ /g" }
importas -iu ARGS ARGS
foreground { if -n -t { test -d /var/log/connmand } install -d -m 0755 -o s6log -g s6log /var/log/connmand }
s6-setuidgid s6log exec -c sh -c "s6-log -d3 -b ${ARGS} /var/log/connmand"
