# Maintainer: Dudemanguy <dudemanguy@artixlinux.org> 
# Contributer: Nathan Owens <ndowens@artixlinux.org> 
pkgname=openfire-s6
pkgver=20200427
pkgrel=1
pkgdesc="s6 service scripts for openfire"
arch=('any')
url="https://gitea.artixlinux.org"
groups=('s6-galaxy')
provides=('openfire-runscripts')
conflicts=('openfire-runscripts')
depends=('openfire' 's6')
install=openfire.install
source=("openfire.run" "openfire.type")
sha256sums=('ca5edbcfba1414bf6428739bf6ec7efe64efc6ae991c71752dcfcec6fab95392'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'openfire'
}
