# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=tlp-s6
pkgver=20191215
pkgrel=1
pkgdesc="s6 service scripts for tlp"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('tlp-runscripts')
conflicts=('tlp-runscripts')
depends=('tlp' 's6')
source=("tlp.down" "tlp.type" "tlp.up")
sha256sums=('f87c38f58f4dbbfc1029d6d5d84c61f49286a6b83a064153e60bca7072e9eaef'
            'aab38fd7998987a22d44fda7822afcfa69d039d3ba02b1f707f064df64352217'
            '90c97ede242c5fad46d05cc00bfcd0a983fee10bb98784285aac906f432f391f')

_inst_sv(){
    for file in down type up; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm755 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'tlp'
}
