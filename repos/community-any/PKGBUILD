pkgname=matterbridge-s6
pkgver=20200611
pkgrel=1
pkgdesc="s6 service scripts for matterbridge"
arch=('any')
url="https://gitea.artixlinux.org/"
groups=('s6-galaxy')
provides=('matterbridge-runscripts')
conflicts=('matterbridge-runscripts')
depends=('matterbridge' 's6')
install=matterbridge.install
backup=('etc/s6/sv/matterbridge-log/conf')
source=("matterbridge-log.conf"
        "matterbridge-log.consumer-for"
        "matterbridge-log.notification-fd"
        "matterbridge-log.pipeline-name"
        "matterbridge-log.run"
        "matterbridge-log.type"
        "matterbridge-srv.producer-for"
        "matterbridge-srv.run"
        "matterbridge-srv.type")
sha256sums=('8a3d2abcc40d355ca913f39871d24f6c770dd216fe075d2548e729b2ae952135'
            'deea760dbc1d39046431d5d92c4e448ecd25138143a7657494ed1f84cd98572d'
            '1121cfccd5913f0a63fec40a6ffd44ea64f9dc135c66634ba001d10bcf4302a2'
            'e260878d280e340aa77ff9d6f651c1c2cc0e57374270ced6779c0b27330602dd'
            '1759e901e22b4b1b70a0dfd3b7e73f28784290a9a4a7f45f37d6e3b48d06c28c'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006'
