# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=fcron-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for fcron"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('fcron-runscripts')
conflicts=('fcron-runscripts' 'cronie' 'cronie-runit')
depends=('fcron' 's6')
install=fcron.install
source=("fcron.run" "fcron.type")
sha256sums=('e3406286c6a718b037eeeb141e5d4939c0c378b28d36a8881922a4de2066f981'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'fcron'
}
