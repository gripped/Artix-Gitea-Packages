provides=('salt-runscripts')
conflicts=('salt-runscripts')
depends=('salt' 's6')
install=salt.install
source=("salt-api.run"
        "salt-api.type"
        "salt-master.run"
        "salt-master.type"
        "salt-minion.run"
        "salt-minion.type"
        "salt-syndic.run"
        "salt-syndic.type")
