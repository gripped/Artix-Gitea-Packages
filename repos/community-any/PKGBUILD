source=("stunnel-log.conf"
        "stunnel-log.consumer-for"
        "stunnel-log.notification-fd"
        "stunnel-log.pipeline-name"
        "stunnel-log.run"
        "stunnel-log.type"
        "stunnel-srv.producer-for"
        "stunnel-srv.run"
        "stunnel-srv.type")
