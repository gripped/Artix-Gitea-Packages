# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>

pkgname=vnstat-s6
pkgver=20191114
pkgrel=1
pkgdesc="s6 service scripts for vnstat"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('vnstat-runscripts')
conflicts=('vnstat-runscripts')
depends=('vnstat' 's6')
install=vnstat.install
source=("vnstatd.run" "vnstatd.type")
sha256sums=('b99b9ee8eeb8cd1e73e6fc23fc3e3ef7a55d7c42aa2bb53904561658aa8e728b'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm755 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'vnstatd'
}
