pkgdesc="s6 service scripts for ejabberd"
arch=('any')
url="https://gitea.artixlinux.org"
groups=('s6-galaxy')
provides=('ejabberd-runscripts')
conflicts=('ejabberd-runscripts')
depends=('ejabberd' 's6')
install=ejabberd.install
backup=('etc/s6/sv/ejabberd-log/conf')
source=("ejabberd-log.conf"
        "ejabberd-log.consumer-for"
        "ejabberd-log.notification-fd"
        "ejabberd-log.pipeline-name"
        "ejabberd-log.run"
        "ejabberd-log.type"
        "ejabberd-srv.finish"
        "ejabberd-srv.producer-for"
        "ejabberd-srv.run"
        "ejabberd-srv.type")
