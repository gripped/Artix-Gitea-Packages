# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=espeakup-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for espeakup"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('espeakup-runscripts')
conflicts=('espeakup-runscripts')
depends=('espeakup' 's6')
install=espeakup.install
source=("espeakup.run" "espeakup.type")
sha256sums=('a83c1fdd5889a4e9953888edaa5d633df73c9540dff97064aae7a0a5e4d46ff6'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'espeakup'
}
