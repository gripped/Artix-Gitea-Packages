# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>

pkgname=ufw-s6
pkgver=20191214
pkgrel=1
pkgdesc="s6 service scripts for ufw"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('ufw-runscripts')
conflicts=('ufw-runscripts')
depends=('ufw' 's6')
install=ufw.install
source=("ufw.down" "ufw.type" "ufw.up")
sha256sums=('155fe63256e164170af51c84880fab8c2ade9242cd2bdccb5ab7b9f4ef75ed81'
            'aab38fd7998987a22d44fda7822afcfa69d039d3ba02b1f707f064df64352217'
            'b4e1fb6d60273893397c33488eb4116fc20a9f4aee7a9fae25cbfc649c578080')

_inst_sv(){
    for file in down type up; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm755 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'ufw'
}
