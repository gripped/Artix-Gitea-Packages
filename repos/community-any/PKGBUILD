# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=boinc-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for boinc"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('boinc-runscripts')
conflicts=('boinc-runscripts')
depends=('boinc' 's6')
install=boinc.install
source=("boinc.run" "boinc.type")
sha256sums=('8c208ed9f6b994b4c19ecdf65ee1f3f8dd4f36ba39d8f473f6060e604c65cfac'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'boinc'
}
