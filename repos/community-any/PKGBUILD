pkgname=libvirt-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for libvirt"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('libvirt-runscripts')
conflicts=('libvirt-runscripts')
depends=('libvirt' 'dbus-s6' 's6')
install=libvirt.install
source=("libvirtd.dependencies"
        "libvirtd.run"
        "libvirtd.type"
        "virtlockd.run"
        "virtlockd.type"
        "virtlogd.dependencies"
        "virtlogd.run"
        "virtlogd.type")
sha256sums=('9291726828590f8d9d158572c381e2cefc24adf21055036cba07585acc1abb62'
            '42b484eb449d0f88e511c4dd732fc29762ba1a02a619e4ffe8278555b5385fc9'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006'
            '1156a65b181bf75af859df633e28a078dfcf7cd4165d010569d7254dbac251cc'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006'
