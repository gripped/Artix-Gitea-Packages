# Contributer: Nathan Owens <ndowens@artixlinux.org> 
pkgname=dns-over-https-s6
pkgver=20200424
pkgrel=1
pkgdesc="s6 service scripts for dns-over-https"
arch=('any')
url="https://gitea.artixlinux.org"
groups=('s6-galaxy')
provides=('dns-over-https-runscripts')
conflicts=('dns-over-https-runscripts')
depends=('dns-over-https' 's6')
install=dns-over-https.install
source=("doh-client.run" 
        "doh-client.type"
	"doh-server.run"
	"doh-server.type")
sha256sums=('833a190a5607c70993a51be33c3d3e15e9824b97fd836ab7327e5ac25257f5a2'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006'
            'dcdacd1e6a4405ab9faeea3dcba08083c81f34b714eb2a169df839420e309dbc'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'doh-server'
    _inst_sv 'doh-client'
}
