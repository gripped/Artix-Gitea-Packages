# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=dnscrypt-proxy-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for dnscrypt-proxy"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('dnscrypt-proxy-runscripts')
conflicts=('dnscrypt-proxy-runscripts')
depends=('dnscrypt-proxy' 's6')
install=dnscrypt-proxy.install
source=("dnscrypt-proxy.run" "dnscrypt-proxy.type")
sha256sums=('c9c5a73f6a2e15c6442b3573a0cdaff3aba0dddea9c06340d86544601e353720'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'dnscrypt-proxy'
}
