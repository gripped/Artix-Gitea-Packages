# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=bumblebee-s6
pkgver=20191031
pkgrel=1
pkgdesc="s6 service scripts for bumblebee"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-galaxy')
provides=('bumblebee-runscripts')
conflicts=('bumblebee-runscripts')
depends=('bumblebee' 's6')
install=bumblebeed.install
source=("bumblebeed.run" "bumblebeed.type")
sha256sums=('ea578f3a15e8073e393f1807ab1b1a4f4fd8103247818af1e96d8eb71710a2f5'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm755 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'bumblebeed'
}
