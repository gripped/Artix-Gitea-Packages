pkgname=openvpn-s6
pkgver=20200610
pkgrel=1
pkgdesc="s6 service scripts for openvpn"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-system')
provides=('init-openvpn')
conflicts=('init-openvpn')
depends=('openvpn' 's6')
install=openvpn.install
backup=('etc/s6/sv/openvpn-log/conf')
source=("openvpn-log.conf"
        "openvpn-log.consumer-for"
        "openvpn-log.notification-fd"
        "openvpn-log.pipeline-name"
        "openvpn-log.run"
        "openvpn-log.type"
        "openvpn-srv.producer-for"
        "openvpn-srv.run"
        "openvpn-srv.type")
sha256sums=('8a3d2abcc40d355ca913f39871d24f6c770dd216fe075d2548e729b2ae952135'
            'e7e294ade1ddb47cc68fe2e372e854cf13137f6d071a888e7a1b1939314decd0'
            '1121cfccd5913f0a63fec40a6ffd44ea64f9dc135c66634ba001d10bcf4302a2'
            '3d7c4388fa6e4e1285cf300609fec430c27768524f8a314bd66a77c6ce0f5757'
            '09a807ed554ab19378e4ab23579df85530ab94eddfc5cc4446ca2ad24fd5ba2d'
