pkgname=git-s6
pkgver=20200610
pkgrel=1
pkgdesc="s6 service scripts for git"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('git-runscripts')
conflicts=('git-runscripts')
depends=('git' 's6')
install=git-daemon.install
backup=('etc/s6/sv/git-daemon-log/conf')
source=("git-daemon-log.conf"
        "git-daemon-log.consumer-for"
        "git-daemon-log.notification-fd"
        "git-daemon-log.pipeline-name"
        "git-daemon-log.run"
        "git-daemon-log.type"
        "git-daemon-srv.producer-for"
        "git-daemon-srv.run"
        "git-daemon-srv.type")
sha256sums=('8a3d2abcc40d355ca913f39871d24f6c770dd216fe075d2548e729b2ae952135'
            'e0980125d456031d038c6a4a4fb268918146e5443d844e7877cb879f4f8198b5'
            '1121cfccd5913f0a63fec40a6ffd44ea64f9dc135c66634ba001d10bcf4302a2'
            '7da9157c5915ca84f51960ea3523ac90a44f4d46d27b18cd34ee5da403fa27a0'
            'ef1c0d06558bf6b92cae333a4f7e90fd51c491ace2c01099d51d8b2296977944'
