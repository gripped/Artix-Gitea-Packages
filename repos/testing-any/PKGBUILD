_inst_sv(){
    for file in conf consumer-for dependencies down notification-fd \
        pipeline-name producer-for run type up; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'lvm2'
    _inst_sv 'lvmetad-log'
    _inst_sv 'lvmetad-srv'
}
