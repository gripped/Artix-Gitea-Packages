# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=s6-scripts
pkgver=20200112
pkgrel=1
pkgdesc='A collection of s6 oneshots and daemons scripts for startup/shutdown.'
arch=('any')
url='https://gitea.artixlinux.org/artix/s6-scripts'
provides=('init-udev')
depends=('execline' 'opentmpfiles' 'pam')
replaces=('eudev-s6')
backup=('etc/s6/rc.local')
backup=('etc/s6/s6.conf')
makedepends=('git')
_commit=426ad02965e107ac4f68073cc2f955f38518dd60
source=("git+https://gitea.artixlinux.org/artix/s6-scripts.git#commit=$_commit")
sha256sums=('SKIP')

_inst_sv(){
    if test -z "$2"; then
        out=$1
    else
        out=$2
    fi
    cd $1
    for file in contents dependencies down run shell_down shell_up type up; do
        if test -f "$srcdir/s6-scripts/$1/$file"; then
            install -Dm644 "$srcdir/s6-scripts/$1/$file" "$pkgdir/etc/s6/sv/$out/$file"
        fi
    done
    for file in shell_down shell_up; do
        if test -f "$pkgdir/etc/s6/sv/$out/$file"; then
            chmod +x "$pkgdir/etc/s6/sv/$out/$file"
        fi
	done
    cd ..
}

package() {
    cd ${pkgname}

    # various installs
    install -Dm644 "${srcdir}"/s6-scripts/s6.conf "${pkgdir}"/etc/s6/s6.conf
    install -Dm644 "${srcdir}"/s6-scripts/rc.local "${pkgdir}"/etc/s6/rc.local
    install -Dm755 "${srcdir}"/s6-scripts/modules-load "${pkgdir}"/usr/bin/modules-load 
    install -d "${pkgdir}"/usr/share/man/man8
    install -Dm644 "${srcdir}"/s6-scripts/modules-load.8 "${pkgdir}"/usr/share/man/man8
    install -d "${pkgdir}"/usr/share/licenses/obarun
    install -Dm644 "${srcdir}"/s6-scripts/LICENSE "${pkgdir}"/usr/share/licenses/obarun

    # install startup/shutdown scripts
    _inst_sv 'agetty' 'agetty-tty2'
    _inst_sv 'agetty' 'agetty-tty3'
    _inst_sv 'agetty' 'agetty-tty4'
    _inst_sv 'agetty' 'agetty-tty5'
    _inst_sv 'agetty' 'agetty-tty6'
    _inst_sv 'binfmt'
    _inst_sv 'boot'
    _inst_sv 'cleanup'
    _inst_sv 'console-setup'
    _inst_sv 'dmesg'
    _inst_sv 'getty'
    _inst_sv 'hostname'
    _inst_sv 'hwclock'
    _inst_sv 'kmod-static-nodes'
    _inst_sv 'log'
    _inst_sv 'misc'
    _inst_sv 'modules'
    _inst_sv 'mount'
    _inst_sv 'mount-cgroups'
    _inst_sv 'mount-devfs'
    _inst_sv 'mount-filesystems'
    _inst_sv 'mount-sysfs'
    _inst_sv 'net-lo'
    _inst_sv 'random-seed'
    _inst_sv 'rc-local'
    _inst_sv 'setup'
    _inst_sv 'swap'
    _inst_sv 'sysctl'
    _inst_sv 'sysuser'
    _inst_sv 'tmpfiles-dev'
    _inst_sv 'tmpfiles-setup'
    _inst_sv 'udev'
    _inst_sv 'udevadm'
    _inst_sv 'udevd'
}
