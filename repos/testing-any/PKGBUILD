pkgname=xinetd-s6
pkgver=20200201
pkgrel=1
pkgdesc="s6 service scripts for xinetd"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-system')
provides=('init-xinetd')
conflicts=('init-xinetd')
depends=('xinetd' 's6')
install=xinetd.install
backup=('etc/s6/sv/xinetd-log/conf')
source=("xinetd-log.conf"
        "xinetd-log.consumer-for"
        "xinetd-log.notification-fd"
        "xinetd-log.pipeline-name"
        "xinetd-log.run"
        "xinetd-log.type"
        "xinetd-srv.producer-for"
        "xinetd-srv.run"
        "xinetd-srv.type")
sha256sums=('7bd1fe2c69a7aab98655c7600e958d8fdb5d0e39603c2e0cef2eb3c0434eb51c'
            'f7924a81806ad92fa7e09eb39b701e6216cb7206f3a3f29bdcbb88cd1ffa8a1e'
            '1121cfccd5913f0a63fec40a6ffd44ea64f9dc135c66634ba001d10bcf4302a2'
            '589e0f2c4679e2f89ad29b651e60a4b8328311bf98a110e3c9af49e197703fbf'
            '259c242145c3bc5a151f16c12f7a5e243ff74d727cacbb591b85f4fa225b783d'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006'
            'c1c34edff2938919795c73efe395cb3c3273d6036e32d4248c9b0f478243078d'
            '06180e568738497e774ea51bb41828be463740b45a50c1b48bcb42af783d2f2f'
