pkgname=cups-s6
pkgver=20200610
pkgrel=1
pkgdesc="s6 service scripts for cups"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('cups-runscripts')
conflicts=('cups-runscripts')
depends=('cups' 'dbus-s6' 's6')
install=cupsd.install
backup=('etc/s6/sv/cupsd-log/conf')
source=("cupsd-log.conf"
        "cupsd-log.consumer-for"
        "cupsd-log.notification-fd"
        "cupsd-log.pipeline-name"
        "cupsd-log.run"
        "cupsd-log.type"
        "cupsd-srv.dependencies"
        "cupsd-srv.producer-for"
        "cupsd-srv.run"
        "cupsd-srv.type")
sha256sums=('8a3d2abcc40d355ca913f39871d24f6c770dd216fe075d2548e729b2ae952135'
            '6b2dd84c8be99cab87ebc793015cd7854880f15be2490a1701790cea69926e44'
            '1121cfccd5913f0a63fec40a6ffd44ea64f9dc135c66634ba001d10bcf4302a2'
            '6314a754701d44397e4049b0263e9e921e7f8e3aae2eaec3c206cc86568afcdb'
