pkgname=syslog-ng-s6
pkgver=20200610
pkgrel=1
pkgdesc="s6 service scripts for syslog-ng"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('syslog-ng-runscripts' 'init-syslog-ng')
conflicts=('syslog-ng-runscripts' 'init-syslog-ng')
depends=('syslog-ng' 's6')
install=syslog-ng.install
backup=('etc/s6/sv/syslog-ng-log/conf')
source=("syslog-ng-log.conf"
        "syslog-ng-log.consumer-for"
        "syslog-ng-log.notification-fd"
        "syslog-ng-log.pipeline-name"
        "syslog-ng-log.run"
        "syslog-ng-log.type"
        "syslog-ng-srv.producer-for"
        "syslog-ng-srv.run"
        "syslog-ng-srv.type")
sha256sums=('8a3d2abcc40d355ca913f39871d24f6c770dd216fe075d2548e729b2ae952135'
            '77626a7d016cb6efb014ebe733761a18a168081aeed2c414035bd79619e63526'
            '1121cfccd5913f0a63fec40a6ffd44ea64f9dc135c66634ba001d10bcf4302a2'
            '14bdd461f944e61b3906f29818bb77d76000f9c31ce766d9dbd96d56fbd89d19'
            'e12dde16fdea2d2b44421e0e29e3e6254dd631bc1668d1d84f019f44e619d000'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006'
