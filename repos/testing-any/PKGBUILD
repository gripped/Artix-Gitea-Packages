_inst_sv(){
    for file in conf consumer-for dependencies finish \
        notification-fd pipeline-name producer-for run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'nfs-server-log'
    _inst_sv 'nfs-server-srv'
    _inst_sv 'statd-log'
    _inst_sv 'statd-srv'
}
