pkgname=metalog-s6
pkgver=20200408
pkgrel=1
pkgdesc="s6 service scripts for metalog"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('metalog-runscripts')
conflicts=('metalog-runscripts')
depends=('metalog' 's6')
install=metalog.install
backup=('etc/s6/sv/metalog-log/conf')
source=("metalog-log.conf"
        "metalog-log.consumer-for"
        "metalog-log.notification-fd"
        "metalog-log.pipeline-name"
        "metalog-log.run"
        "metalog-log.type"
        "metalog-srv.producer-for"
        "metalog-srv.run"
        "metalog-srv.type")
sha256sums=('7bd1fe2c69a7aab98655c7600e958d8fdb5d0e39603c2e0cef2eb3c0434eb51c'
            '9625ef6436d226a300ca2eaafba756bd253289756494efeb6e656d23f52b856a'
            '1121cfccd5913f0a63fec40a6ffd44ea64f9dc135c66634ba001d10bcf4302a2'
            'c6b75e7f61189d17a9ee8370992cb293f0284a704a5e96b3b25c2734732fd8e5'
