pkgdesc="s6 service scripts for gpm"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-system')
provides=('init-gpm')
conflicts=('init-gpm')
depends=('gpm' 's6')
install=gpm.install
backup=('etc/s6/sv/gpm-log/conf')
source=("gpm-log.conf"
        "gpm-log.consumer-for"
        "gpm-log.notification-fd"
        "gpm-log.pipeline-name"
        "gpm-log.run"
        "gpm-log.type"
        "gpm-srv.producer-for"
        "gpm-srv.run"
        "gpm-srv.type")
