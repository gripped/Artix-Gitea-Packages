pkgname=mdadm-s6
pkgver=20200610
pkgrel=1
pkgdesc="s6 service scripts for mdadm"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-system')
provides=('init-mdadm')
conflicts=('init-mdadm')
depends=('mdadm' 's6')
install=mdadm.install
backup=('etc/s6/sv/mdadm-log/conf')
source=("mdadm-log.conf"
        "mdadm-log.consumer-for"
        "mdadm-log.notification-fd"
        "mdadm-log.pipeline-name"
        "mdadm-log.run"
        "mdadm-log.type"
        "mdadm-srv.producer-for"
        "mdadm-srv.run"
        "mdadm-srv.type")
sha256sums=('8a3d2abcc40d355ca913f39871d24f6c770dd216fe075d2548e729b2ae952135'
