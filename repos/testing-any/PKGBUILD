        "dmeventd-log.consumer-for"
        "dmeventd-log.notification-fd"
        "dmeventd-log.pipeline-name"
        "dmeventd-log.run"
        "dmeventd-log.type"
        "dmeventd-srv.producer-for"
        "dmeventd-srv.run"
        "dmeventd-srv.type")
