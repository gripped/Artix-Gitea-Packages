# Maintainer: Dudemanguy <dudemanguy@artixlinux.org>
pkgname=openvpn-s6
pkgver=20200115
pkgrel=1
pkgdesc="s6 service scripts for openvpn"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-system')
provides=('init-openvpn')
conflicts=('init-openvpn')
depends=('openvpn' 's6')
install=openvpn.install
source=("openvpn.run" "openvpn.type")
sha256sums=('d1afce210018d3742a696e15854ca5391d3dd399348ad561b40d1201577bee67'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm644 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'openvpn'
}
