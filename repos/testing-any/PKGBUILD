pkgname=dhcp-s6
pkgver=20191031
pkgrel=1
pkgdesc="s6 service scripts for dhcp"
arch=('any')
url="https://github.com/artix-linux"
groups=('s6-world')
provides=('dhcp-runscripts')
conflicts=('dhcp-runscripts')
depends=('dhcp' 's6')
install=dhcp.install
source=("dhclient.run"
        "dhclient.type"
        "dhcpd4.run"
        "dhcpd4.type"
        "dhcpd6.run"
        "dhcpd6.type")
sha256sums=('3b662a853c5915740229075a1a0a4c23dcb408a899b98d76e6538c08b86a14d0'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006'
            '0faed858b85188b4e9356baa160028114487913a373d35d908189bbf154463fb'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006'
            '0a753c8cac3258b5d395d686d803ff186d7a3715147c509d6dec84bd490d945a'
            'd0001a150b83f68f09004c5059045cb76a3f064eed4d42ce072bc3722c118006')

_inst_sv(){
    for file in run type; do
        if test -f "$srcdir/$1.$file"; then
            install -Dm755 "$srcdir/$1.$file" "$pkgdir/etc/s6/sv/$1/$file"
        fi
    done
}

package() {
    _inst_sv 'dhclient'
    _inst_sv 'dhcpd4'
    _inst_sv 'dhcpd6'
}
