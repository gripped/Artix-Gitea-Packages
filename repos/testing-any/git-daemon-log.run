#!/usr/bin/execlineb -P
envfile /etc/s6/sv/git-daemon-log/conf
importas -iu DIRECTIVES DIRECTIVES
foreground { s6-setuidgid s6log mkdir -p /var/log/git-daemon }
foreground { if -n -t { test -d /var/log/git-daemon } install -d -m 0755 -o s6log -g s6log /var/log/git-daemon }
s6-setuidgid s6log exec -c sh -c "s6-log -d3 -b ${DIRECTIVES} /var/log/git-daemon"
