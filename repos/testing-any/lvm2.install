pre_remove() {
    sed -i '/lvm2/d' /etc/s6/sv/mount-filesystems/dependencies
    if [ -e "/run/service/s6rc-oneshot-runner" ]; then
        s6-rc -d change lvm2
    fi
}

post_install() {
    echo "lvm2" >> /etc/s6/sv/mount-filesystems/dependencies
}

post_remove() {
    rm -rf /etc/s6/sv/lvmetad-log
    rm -rf /etc/s6/sv/lvmpolld-log
}
