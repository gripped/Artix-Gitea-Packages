# Maintainer: CupIvan <mail@cupivan.ru>

pkgbase=tinydns
pkgname=('tinydns' 'tinydns-openrc')
pkgver=0.3.1
pkgrel=1.2
pkgdesc='Tiny cache DNS server'
arch=('x86_64')
url="https://github.com/CupIvan/tinydns"
license=('MIT')
source=("https://github.com/CupIvan/${pkgname}/archive/v${pkgver}.tar.gz"
	"tinydns.openrc")
sha256sums=('baf5d4246a22bd0c2d8ac3579cea18b50b3636762fecc452cad8614c13fc9807'
            'f7865099036c835b1e50796a80d37dd6b8c45cac5179fda28cdb56253488860a')

prepare() {
  cd "$srcdir/$pkgname-$pkgver"
  sed -i 's:tinydns:& -Wl,-z,now,-z,relro:' Makefile
}

build() {
  cd "$srcdir/$pkgname-$pkgver"
  make
}

package_tinydns() {
  cd "$srcdir/$pkgname-$pkgver"
  backup=(etc/${pkgname}.conf)
	
  install -Dm755 ${pkgname} ${pkgdir}/usr/bin/${pkgname}
  install -Dm644 ${pkgname}.conf ${pkgdir}/etc/${pkgname}.conf
  install -Dm644 LICENSE ${pkgdir}/usr/share/licenses/${pkgname}/LICENSE
}

package_tinydns-openrc() {
  pkgdesc="OpenRC tinydns init script"
  arch=('any')
  groups=('openrc-galaxy')
  conflicts=('systemd-sysvcompat')
  depends=('tinydns' 'openrc')
  
  install -Dm755 "$srcdir"/tinydns.openrc "$pkgdir"/etc/init.d/tinydns
}
