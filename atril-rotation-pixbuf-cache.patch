From fbf7a03dccd2334ee57f63e2139ce789c59a8e91 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ball=C3=B3=20Gy=C3=B6rgy?= <ballogyor@gmail.com>
Date: Tue, 6 Oct 2026 11:20:28 +0200
Subject: [PATCH] ev-view: Check pixbuf cache before clearing selection

Avoid calling clear_selection() when the pixbuf cache has not been
initialized yet. This can happen when reopening a document with a
non-zero rotation, causing invalid pixbuf cache assertions and a
subsequent crash.

Fixes a crash when reopening a previously rotated PDF document.
---
 libview/ev-view.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/libview/ev-view.c b/libview/ev-view.c
index dfd477592..61251e5c3 100644
--- a/libview/ev-view.c
+++ b/libview/ev-view.c
@@ -6893,7 +6893,7 @@ ev_view_rotation_changed_cb (EvDocumentModel *model,
 
 	ev_view_remove_all (view);
 
-	if (rotation != 0)
+	if (rotation != 0 && view->pixbuf_cache)
 		clear_selection (view);
 }
 
